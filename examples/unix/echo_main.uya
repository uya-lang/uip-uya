// Echo-style variant for the unix uya-uip example.
// Behavior:
// - listen on TCP 1235
// - on connect, send "helloworld\r\n"
// - on subsequent received payload, send the same payload back

use libc.syscall;
use libc.errno;

extern fn uip_init(state: &UipState) void;
extern fn uip_runtime_init(rt: &UipRuntime) void;
extern fn uip_sethostaddr(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_setdraddr(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_setnetmask(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_input(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult;
extern fn uip_periodic(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult;
extern fn uip_arp_init(state: &UipArpState) void;
extern fn uip_arp_ipin(state: &UipArpState, buf: &EthIpHdr, len: &u16) void;
extern fn uip_arp_arpin(state: &UipArpState, buf: &ArpHdr, len: &u16) void;
extern fn uip_arp_out(state: &UipArpState, frame: &UipFrame, len: &u16) void;
extern fn uip_arp_timer(state: &UipArpState) void;
extern fn timer_set(t: &Timer, interval: u64, now: u64) void;
extern fn timer_reset(t: &Timer) void;
extern fn timer_expired(t: &Timer, now: u64) bool;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn uip_listen(state: &UipState, port: u16) void;
extern fn uip_send(rt: &UipRuntime, data: &byte, len: u16) void;
extern fn uip_connected(flags: byte) bool;
extern fn uip_newdata(flags: byte) bool;
extern fn htons(val: u16) u16;

extern const UIP_CONNS: i32;
extern const UIP_ETHTYPE_IP: i32;
extern const UIP_ETHTYPE_ARP: i32;

const CLOCK_SECOND: u64 = 1000u64;
const IFNAMSIZ: usize = 16usize;
const IFF_TAP: u16 = 0x0002u16;
const IFF_NO_PI: u16 = 0x1000u16;
const TUNSETIFF: i64 = 0x400454cau32 as i64;

struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct UipFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, appdata: &byte, sappdata: &byte, len: u16, uip_len: u16, uip_slen: u16, flags: byte, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, stats: &UipStats, urgdata: &byte, urglen: u16, surglen: u16, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, slen: u16, logs: [UipRuntimeLog: 16], ipid: u16, te_reply: bool }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
struct ArpEntry { ipaddr: [u16: 2], ethaddr: UipEthAddr, time: byte }
struct UipArpState { ethaddr: UipEthAddr, hostaddr: UipIpAddr, netmask: UipIpAddr, draddr: UipIpAddr, table: [ArpEntry: 8], arptime: byte }
struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }
struct Timer { start: u64, interval: u64 }
struct TimeVal { tv_sec: i64, tv_usec: i64 }
struct TimeSpec { tv_sec: i64, tv_nsec: i64 }
struct IfReq { name: [byte: IFNAMSIZ], flags: u16, pad: [byte: 22] }

fn zero_mac() UipEthAddr { return UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }; }

fn make_runtime() UipRuntime {
    var stats: UipStats = UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } };
    return UipRuntime { frame: UipRuntimeFrame { ethip: EthIpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16] }, ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, seqno: [0 as byte,0 as byte,0 as byte,0 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0 as byte, flags: 0 as byte, wnd: [0 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] }, ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 }, arp: ArpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: zero_mac(), sipaddr: [0u16,0u16], dhwaddr: zero_mac(), dipaddr: [0u16,0u16] } }, appdata: null, sappdata: null, len: 0u16, uip_len: 0u16, uip_slen: 0u16, flags: 0 as byte, hostaddr: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, stats: &stats, urgdata: null, urglen: 0u16, surglen: 0u16, logbuf: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], logcount: 0usize, logcode: 0 as byte, logparam: 0u16, current_conn: -1, current_udp_conn: -1, payload_view: null, payload_len: 0u16, input_view: null, input_len: 0u16, app_input: null, app_input_len: 0u16, app_output: null, slen: 0u16, logs: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], ipid: 0u16, te_reply: false };
}

fn make_state() UipState { return UipState { conns: [UipConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, rcv_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], snd_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], len: 0u16, mss: 0u16, initialmss: 0u16, sa: 0 as byte, sv: 0 as byte, rto: 0 as byte, tcpstateflags: 0 as byte, timer: 0 as byte, nrtx: 0 as byte, appstate: 0u16 }: 10], listener_ports: [0u16: 10], udp_conns: [UipUdpConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, ttl: 0 as byte, appstate: 0u16 }: 10], hostaddr: UipIpAddr { words: [0u16,0u16] }, stats: UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } }, iss: [0 as byte,0 as byte,0 as byte,0 as byte], lastport: 0u16 };
}

fn make_arp_state() UipArpState { return UipArpState { ethaddr: zero_mac(), hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: zero_mac(), time: 0 as byte }: 8], arptime: 0 as byte }; }

fn clock_time_ms() u64 { var tv: TimeVal = TimeVal { tv_sec: 0, tv_usec: 0 }; _ = syscall.sys_gettimeofday(&tv, null as &void) catch { return 0u64; }; return (tv.tv_sec as u64) * 1000u64 + ((tv.tv_usec as u64) / 1000u64); }
fn sleep_ms(ms: u64) void { var req: TimeSpec = TimeSpec { tv_sec: (ms / 1000u64) as i64, tv_nsec: ((ms % 1000u64) * 1000000u64) as i64 }; var rem: TimeSpec = TimeSpec { tv_sec: 0i64, tv_nsec: 0i64 }; _ = syscall.sys_nanosleep(&req, &rem) catch {}; }
struct TapDev { fd: i32 }
fn tapdev_init(dev: &TapDev) !void { const fd: i32 = try syscall.sys_open("/dev/net/tun\0", syscall.O_RDWR as i32, 0); var ifr: IfReq = IfReq { name: [0:IFNAMSIZ], flags: (IFF_TAP | IFF_NO_PI), pad: [0:22] }; ifr.name[0] = 't'; ifr.name[1] = 'a'; ifr.name[2] = 'p'; ifr.name[3] = '0'; _ = try syscall.sys_ioctl(fd, TUNSETIFF, (@usize_from_ptr(&ifr as &void) as! i64).value); const flags: i32 = try syscall.sys_fcntl(fd, syscall.F_GETFL, 0); _ = try syscall.sys_fcntl(fd, syscall.F_SETFL, flags | (syscall.O_NONBLOCK as i32)); dev.fd = fd; }
fn tapdev_read(dev: &TapDev, frame: &UipRuntimeFrame, len_out: &u16) bool { const result: !isize = syscall.sys_read(dev.fd, frame as &byte, @size_of(UipRuntimeFrame)); const n: isize = result catch |err| { const eid: i32 = (@error_id(err) as! i32).value; if eid == errno.EAGAIN || eid == errno.EWOULDBLOCK { *len_out = 0u16; return false; } *len_out = 0u16; return false; }; if n <= 0isize { *len_out = 0u16; return false; } *len_out = (n as! u16).value; return true; }
fn tapdev_send(dev: &TapDev, frame: &UipRuntimeFrame, len: u16) void { const result: !isize = syscall.sys_write(dev.fd, frame as &const byte, len as usize); _ = result catch { return; }; }
fn apply_result(rt: &UipRuntime, result: &UipProcessResult) void { rt.flags = result.flags; rt.len = result.len; }
fn flush_ip(arp: &UipArpState, rt: &UipRuntime, tap: &TapDev) void { if rt.len > 0u16 { var send_len: u16 = rt.len; var frame: UipFrame = UipFrame { ethip: rt.frame.ethip, ethtcp: rt.frame.ethtcp, ethudp: rt.frame.ethudp, arp: rt.frame.arp }; uip_arp_out(arp, &frame, &send_len); rt.frame.ethip = frame.ethip; rt.frame.ethtcp = frame.ethtcp; rt.frame.ethudp = frame.ethudp; rt.frame.arp = frame.arp; tapdev_send(tap, &rt.frame, send_len); rt.len = 0u16; } }
fn unix_maybe_hello_or_echo(rt: &UipRuntime) void { if uip_connected(rt.flags) { var hello: [byte: 12] = ['h','e','l','l','o','w','o','r','l','d','\r','\n']; uip_send(rt, &hello[0], 12u16); } else if uip_newdata(rt.flags) && rt.appdata != null && rt.len > 0u16 { uip_send(rt, rt.appdata, rt.len); } }
fn boot(state: &UipState, rt: &UipRuntime, arp: &UipArpState) void { uip_init(state); uip_runtime_init(rt); uip_arp_init(arp); const host: UipIpAddr = uip_ipaddr(192 as byte,168 as byte,0 as byte,2 as byte); const router: UipIpAddr = uip_ipaddr(192 as byte,168 as byte,0 as byte,1 as byte); const mask: UipIpAddr = uip_ipaddr(255 as byte,255 as byte,255 as byte,0 as byte); uip_sethostaddr(rt, &host); uip_setdraddr(rt, &router); uip_setnetmask(rt, &mask); uip_listen(state, htons(1235u16)); arp.hostaddr = host; arp.draddr = router; arp.netmask = mask; }
fn main() i32 { var state: UipState = make_state(); var rt: UipRuntime = make_runtime(); var arp: UipArpState = make_arp_state(); var periodic_timer: Timer = Timer { start: 0u64, interval: 0u64 }; var arp_timer: Timer = Timer { start: 0u64, interval: 0u64 }; var tap: TapDev = TapDev { fd: -1 }; _ = tapdev_init(&tap) catch { return 1; }; boot(&state, &rt, &arp); const now0: u64 = clock_time_ms(); timer_set(&periodic_timer, CLOCK_SECOND / 2u64, now0); timer_set(&arp_timer, CLOCK_SECOND * 10u64, now0); while true { var in_len: u16 = 0u16; if tapdev_read(&tap, &rt.frame, &in_len) && in_len > 0u16 { rt.len = in_len; const ethtype: u16 = rt.frame.ethip.ethhdr.type; if ethtype == htons((UIP_ETHTYPE_IP as! u16).value) { uip_arp_ipin(&arp, &rt.frame.ethip, &rt.len); const result: UipProcessResult = uip_input(&state, &rt, -1, in_len, false, false, 0u16); apply_result(&rt, &result); unix_maybe_hello_or_echo(&rt); flush_ip(&arp, &rt, &tap); } else if ethtype == htons((UIP_ETHTYPE_ARP as! u16).value) { var arp_len: u16 = in_len; uip_arp_arpin(&arp, &rt.frame.arp, &arp_len); if arp_len > 0u16 { tapdev_send(&tap, &rt.frame, arp_len); } } } else { const now: u64 = clock_time_ms(); if timer_expired(&periodic_timer, now) { timer_reset(&periodic_timer); var i: i32 = 0; while i < UIP_CONNS { const result: UipProcessResult = uip_periodic(&state, &rt, i); apply_result(&rt, &result); flush_ip(&arp, &rt, &tap); i = i + 1; } if timer_expired(&arp_timer, now) { timer_reset(&arp_timer); uip_arp_timer(&arp); } } sleep_ms(1u64); } } return 0; }
