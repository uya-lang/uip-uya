export const TCP_OPT_MSS: i32 = 2;
export const TCP_OPT_MSS_LEN: i32 = 4;
export const UIP_LOG_NONE: i32 = 0;
export const UIP_LOG_TCP_URG: i32 = 1;
export const UIP_LOG_DATA: i32 = 2;
export const UIP_LOG_RST: i32 = 3;
export const UIP_REASS_MAXAGE: i32 = 40;
export const UIP_TIME_WAIT_TIMEOUT: i32 = 120;
export const UIP_REASS_BUFSIZE: i32 = 386;
export const UIP_REASS_FLAG_LASTFRAG: i32 = 0x01;
export const IP_MF: i32 = 0x20;
