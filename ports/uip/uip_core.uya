export fn uip_udp_new(state: &UipState, ripaddr: &UipIpAddr, rport: u16, out_index: &i32) bool {
    var c: usize = 0usize;
    while c < 10usize {
        if state.udp_conns[c].lport == 0u16 {
            state.lastport = state.lastport + 1u16;
            state.udp_conns[c].lport = htons(state.lastport);
            state.udp_conns[c].rport = rport;
            state.udp_conns[c].ttl = (UIP_TTL as! byte).value;
            uip_ipaddr_copy(&state.udp_conns[c].ripaddr, ripaddr);
            *out_index = (c as! i32).value;
            return true;
        }
        c = c + 1usize;
    }
    return false;
}

export fn tcp_data_len(frame: &UipFrame, total_len: u16) u16 {
    const tcp_hdr_len: u16 = (((frame.ethtcp.tcpoffset >> 4) as u16) << 2);
    if total_len <= (20u16 + tcp_hdr_len) {
        return 0u16;
    }
    return total_len - 20u16 - tcp_hdr_len;
}

export fn tcp_seq_matches(conn: &UipConn, frame: &UipFrame, data_len: u16) bool {
    if data_len == 0u16 && (frame.ethtcp.flags & (((TCP_SYN | TCP_FIN) as! byte).value)) == 0 as byte {
        return true;
    }
    return frame.ethtcp.seqno[0] == conn.rcv_nxt[0] &&
        frame.ethtcp.seqno[1] == conn.rcv_nxt[1] &&
        frame.ethtcp.seqno[2] == conn.rcv_nxt[2] &&
        frame.ethtcp.seqno[3] == conn.rcv_nxt[3];
}

export fn tcp_parse_mss_option(raw: &byte, options_len: u16) u16 {
    var c: u16 = 0u16;
    while c < options_len {
        const opt: byte = raw[c];
        if opt == 0 as byte {
            break;
        }
        if opt == 1 as byte {
            c = c + 1u16;
        } else if opt == (TCP_OPT_MSS as! byte).value && c + 3u16 < options_len && raw[c + 1u16] == (TCP_OPT_MSS_LEN as! byte).value {
            const tmp16: u16 = ((raw[c + 2u16] as u16) << 8) | (raw[c + 3u16] as u16);
            if tmp16 > (uip_const_tcp_mss() as! u16).value {
                return (uip_const_tcp_mss() as! u16).value;
            }
            return tmp16;
        } else {
            if c + 1u16 >= options_len || raw[c + 1u16] == 0 as byte {
                break;
            }
            c = c + (raw[c + 1u16] as u16);
        }
    }
    return (uip_const_tcp_mss() as! u16).value;
}

export fn tcp_post_ack_state_step(state: &UipState, conn_index: i32, has_ack: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if !has_ack || conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        const ts: byte = state.conns[0].tcpstateflags & 15 as byte;
        if ts == (UIP_LAST_ACK as! byte).value {
            state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
            result.closed = true;
        } else if ts == (UIP_FIN_WAIT_1 as! byte).value {
            state.conns[0].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value;
        } else if ts == (UIP_CLOSING as! byte).value {
            state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
            state.conns[0].timer = 0 as byte;
        }
        return result;
    }
    if conn_index == 1 {
        const ts: byte = state.conns[1].tcpstateflags & 15 as byte;
        if ts == (UIP_LAST_ACK as! byte).value {
            state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
            result.closed = true;
        } else if ts == (UIP_FIN_WAIT_1 as! byte).value {
            state.conns[1].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value;
        } else if ts == (UIP_CLOSING as! byte).value {
            state.conns[1].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
            state.conns[1].timer = 0 as byte;
        }
        return result;
    }
    return result;
}

export fn tcp_should_accept_syn(state: &UipState, frame: &UipFrame) bool {
    if (frame.ethtcp.flags & 0x3f as byte) != (TCP_SYN as! byte).value {
        return false;
    }
    var i: usize = 0usize;
    while i < 20usize {
        if state.listenports[i] == frame.ethtcp.destport {
            return true;
        }
        i = i + 1usize;
    }
    return false;
}

export fn uip_accept_syn(state: &UipState, rt: &UipRuntime, frame: &UipFrame, out_index: &i32) bool {
    if !tcp_should_accept_syn(state, frame) {
        return false;
    }
    var chosen: i32 = -1;
    var time_wait_index: i32 = -1;
    var time_wait_timer: byte = 0 as byte;
    var i: usize = 0usize;
    while i < 10usize {
        if state.conns[i].tcpstateflags == (UIP_CLOSED as! byte).value {
            chosen = (i as! i32).value;
            break;
        }
        if state.conns[i].tcpstateflags == (UIP_TIME_WAIT as! byte).value {
            if time_wait_index < 0 || state.conns[i].timer > time_wait_timer {
                time_wait_index = (i as! i32).value;
                time_wait_timer = state.conns[i].timer;
            }
        }
        i = i + 1usize;
    }
    if chosen < 0 {
        chosen = time_wait_index;
    }
    if chosen < 0 {
        return false;
    }
    if chosen == 0 {
        state.conns[0].rto = 3 as byte;
        state.conns[0].timer = 3 as byte;
        state.conns[0].sa = 0 as byte;
        state.conns[0].sv = 4 as byte;
        state.conns[0].nrtx = 0 as byte;
        state.conns[0].lport = frame.ethtcp.destport;
        state.conns[0].rport = frame.ethtcp.srcport;
        state.conns[0].ripaddr = UipIpAddr { words: [frame.ethtcp.srcipaddr[0], frame.ethtcp.srcipaddr[1]] };
        state.conns[0].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
        state.conns[0].snd_nxt[0] = rt.iss[0];
        state.conns[0].snd_nxt[1] = rt.iss[1];
        state.conns[0].snd_nxt[2] = rt.iss[2];
        state.conns[0].snd_nxt[3] = rt.iss[3];
        state.conns[0].len = 1u16;
        state.conns[0].rcv_nxt[0] = frame.ethtcp.seqno[0];
        state.conns[0].rcv_nxt[1] = frame.ethtcp.seqno[1];
        state.conns[0].rcv_nxt[2] = frame.ethtcp.seqno[2];
        state.conns[0].rcv_nxt[3] = frame.ethtcp.seqno[3];
        uip_add32(&state.conns[0].rcv_nxt[0], 1u16, &state.acc32[0]);
        state.conns[0].rcv_nxt[0] = state.acc32[0];
        state.conns[0].rcv_nxt[1] = state.acc32[1];
        state.conns[0].rcv_nxt[2] = state.acc32[2];
        state.conns[0].rcv_nxt[3] = state.acc32[3];
        const parsed_mss: u16 = tcp_parse_mss_option(&frame.ethtcp.optdata[0], (((frame.ethtcp.tcpoffset >> 4) - 5) << 2) as! u16 catch |_| { 0u16; });
        state.conns[0].initialmss = parsed_mss;
        state.conns[0].mss = parsed_mss;
        *out_index = 0;
        return true;
    }
    if chosen == 1 {
        state.conns[1].rto = 3 as byte;
        state.conns[1].timer = 3 as byte;
        state.conns[1].sa = 0 as byte;
        state.conns[1].sv = 4 as byte;
        state.conns[1].nrtx = 0 as byte;
        state.conns[1].lport = frame.ethtcp.destport;
        state.conns[1].rport = frame.ethtcp.srcport;
        state.conns[1].ripaddr = UipIpAddr { words: [frame.ethtcp.srcipaddr[0], frame.ethtcp.srcipaddr[1]] };
        state.conns[1].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
        state.conns[1].snd_nxt[0] = rt.iss[0];
        state.conns[1].snd_nxt[1] = rt.iss[1];
        state.conns[1].snd_nxt[2] = rt.iss[2];
        state.conns[1].snd_nxt[3] = rt.iss[3];
        state.conns[1].len = 1u16;
        state.conns[1].rcv_nxt[0] = frame.ethtcp.seqno[0];
        state.conns[1].rcv_nxt[1] = frame.ethtcp.seqno[1];
        state.conns[1].rcv_nxt[2] = frame.ethtcp.seqno[2];
        state.conns[1].rcv_nxt[3] = frame.ethtcp.seqno[3];
        uip_add32(&state.conns[1].rcv_nxt[0], 1u16, &state.acc32[0]);
        state.conns[1].rcv_nxt[0] = state.acc32[0];
        state.conns[1].rcv_nxt[1] = state.acc32[1];
        state.conns[1].rcv_nxt[2] = state.acc32[2];
        state.conns[1].rcv_nxt[3] = state.acc32[3];
        const parsed_mss1: u16 = tcp_parse_mss_option(&frame.ethtcp.optdata[0], (((frame.ethtcp.tcpoffset >> 4) - 5) << 2) as! u16 catch |_| { 0u16; });
        state.conns[1].initialmss = parsed_mss1;
        state.conns[1].mss = parsed_mss1;
        *out_index = 1;
        return true;
    }
    *out_index = -1;
    return false;
}

export fn tcp_syn_sent_step(state: &UipState, rt: &UipRuntime, conn_index: i32, frame: &UipFrame) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte && (frame.ethtcp.flags & 0x3f as byte) == ((TCP_SYN | TCP_ACK) as! byte).value {
            state.conns[0].initialmss = tcp_parse_mss_option(&frame.ethtcp.optdata[0], (((frame.ethtcp.tcpoffset >> 4) - 5) << 2) as! u16 catch |_| { 0u16; });
            state.conns[0].mss = state.conns[0].initialmss;
            state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
            state.conns[0].rcv_nxt[0] = frame.ethtcp.seqno[0];
            state.conns[0].rcv_nxt[1] = frame.ethtcp.seqno[1];
            state.conns[0].rcv_nxt[2] = frame.ethtcp.seqno[2];
            state.conns[0].rcv_nxt[3] = frame.ethtcp.seqno[3];
            uip_add32(&state.conns[0].rcv_nxt[0], 1u16, &rt.acc32[0]);
            state.conns[0].rcv_nxt[0] = rt.acc32[0];
            state.conns[0].rcv_nxt[1] = rt.acc32[1];
            state.conns[0].rcv_nxt[2] = rt.acc32[2];
            state.conns[0].rcv_nxt[3] = rt.acc32[3];
            result.flags = (UIP_CONNECTED as! byte).value;
            state.conns[0].len = 0u16;
            rt.len = 0u16;
            rt.slen = 0u16;
            result.appcall = true;
            return result;
        }
        result.flags = (UIP_ABORT as! byte).value;
        result.appcall = true;
        state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
        result.closed = true;
        return result;
    }
    return result;
}

export fn tcp_established_fin_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if has_fin && (state.conns[0].tcpstateflags & (UIP_STOPPED as! byte).value) == 0 as byte {
            if uip_outstanding(&state.conns[0]) > 0u16 {
                return result;
            }
            uip_add32(&state.conns[0].rcv_nxt[0], (incoming_len + 1u16), &rt.acc32[0]);
            state.conns[0].rcv_nxt[0] = rt.acc32[0];
            state.conns[0].rcv_nxt[1] = rt.acc32[1];
            state.conns[0].rcv_nxt[2] = rt.acc32[2];
            state.conns[0].rcv_nxt[3] = rt.acc32[3];
            result.flags = (UIP_CLOSE as! byte).value;
            if incoming_len > 0u16 {
                result.flags = result.flags | (UIP_NEWDATA as! byte).value;
            }
            result.appcall = true;
            state.conns[0].len = 1u16;
            state.conns[0].tcpstateflags = (UIP_LAST_ACK as! byte).value;
            state.conns[0].nrtx = 0 as byte;
        }
        return result;
    }
    return result;
}

export fn tcp_established_data_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, app_slen: u16) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        const stopped: bool = (state.conns[0].tcpstateflags & (UIP_STOPPED as! byte).value) != 0 as byte;
        if incoming_len > 0u16 && !stopped {
            result.flags = result.flags | (UIP_NEWDATA as! byte).value;
            uip_add32(&state.conns[0].rcv_nxt[0], incoming_len, &rt.acc32[0]);
            state.conns[0].rcv_nxt[0] = rt.acc32[0];
            state.conns[0].rcv_nxt[1] = rt.acc32[1];
            state.conns[0].rcv_nxt[2] = rt.acc32[2];
            state.conns[0].rcv_nxt[3] = rt.acc32[3];
        }
        const wnd: u16 = (((rt.frame.ethtcp.wnd[0] as u16) << 8) | (rt.frame.ethtcp.wnd[1] as u16));
        if wnd > state.conns[0].initialmss || wnd == 0u16 {
            state.conns[0].mss = state.conns[0].initialmss;
        } else {
            state.conns[0].mss = wnd;
        }
        if (rt.flags & ((UIP_NEWDATA | UIP_ACKDATA) as! byte).value) != 0 as byte || (result.flags & (UIP_NEWDATA as! byte).value) != 0 as byte {
            if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte {
                result.flags = result.flags | (UIP_ACKDATA as! byte).value;
            }
            result.appcall = true;
            rt.slen = app_slen;
            if app_slen > 0u16 {
                if (result.flags & (UIP_ACKDATA as! byte).value) != 0 as byte {
                    state.conns[0].len = 0u16;
                }
                if state.conns[0].len == 0u16 {
                    if app_slen > state.conns[0].mss {
                        state.conns[0].len = state.conns[0].mss;
                    } else {
                        state.conns[0].len = app_slen;
                    }
                }
                result.len = state.conns[0].len;
                if result.len > 0u16 && rt.stats != null {
                    rt.stats.tcp.sent = rt.stats.tcp.sent + 1u16;
                }
            }
            state.conns[0].nrtx = 0 as byte;
        }
        return result;
    }
    return result;
}

export fn tcp_ack_outstanding(state: &UipState, rt: &UipRuntime, conn_index: i32, frame: &UipFrame) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (frame.ethtcp.flags & (TCP_ACK as! byte).value) != 0 as byte && uip_outstanding(&state.conns[0]) > 0u16 {
            uip_add32(&state.conns[0].snd_nxt[0], state.conns[0].len, &rt.acc32[0]);
            if frame.ethtcp.ackno[0] == rt.acc32[0] && frame.ethtcp.ackno[1] == rt.acc32[1] && frame.ethtcp.ackno[2] == rt.acc32[2] && frame.ethtcp.ackno[3] == rt.acc32[3] {
                state.conns[0].snd_nxt[0] = rt.acc32[0];
                state.conns[0].snd_nxt[1] = rt.acc32[1];
                state.conns[0].snd_nxt[2] = rt.acc32[2];
                state.conns[0].snd_nxt[3] = rt.acc32[3];
                if state.conns[0].nrtx == 0 as byte {
                    var m: i32 = (state.conns[0].rto as i32) - (state.conns[0].timer as i32);
                    m = m - ((state.conns[0].sa as i32) >> 3);
                    state.conns[0].sa = (((state.conns[0].sa as i32) + m) as! byte).value;
                    if m < 0 { m = -m; }
                    m = m - ((state.conns[0].sv as i32) >> 2);
                    state.conns[0].sv = (((state.conns[0].sv as i32) + m) as! byte).value;
                    state.conns[0].rto = ((((state.conns[0].sa as i32) >> 3) + (state.conns[0].sv as i32)) as! byte).value;
                }
                result.flags = (UIP_ACKDATA as! byte).value;
                state.conns[0].timer = state.conns[0].rto;
                state.conns[0].len = 0u16;
            }
        }
        return result;
    }
    return result;
}

export fn tcp_syn_rcvd_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, app_slen: u16) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte {
            state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
            result.flags = (UIP_CONNECTED as! byte).value;
            state.conns[0].len = 0u16;
            if incoming_len > 0u16 {
                result.flags = result.flags | (UIP_NEWDATA as! byte).value;
                uip_add32(&state.conns[0].rcv_nxt[0], incoming_len, &rt.acc32[0]);
                state.conns[0].rcv_nxt[0] = rt.acc32[0];
                state.conns[0].rcv_nxt[1] = rt.acc32[1];
                state.conns[0].rcv_nxt[2] = rt.acc32[2];
                state.conns[0].rcv_nxt[3] = rt.acc32[3];
            }
            rt.slen = app_slen;
            result.appcall = true;
        }
        return result;
    }
    return result;
}

export fn tcp_fin_wait_2_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if !has_fin || conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        uip_add32(&state.conns[0].rcv_nxt[0], (incoming_len + 1u16), &rt.acc32[0]);
        state.conns[0].rcv_nxt[0] = rt.acc32[0];
        state.conns[0].rcv_nxt[1] = rt.acc32[1];
        state.conns[0].rcv_nxt[2] = rt.acc32[2];
        state.conns[0].rcv_nxt[3] = rt.acc32[3];
        state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
        state.conns[0].timer = 0 as byte;
        result.flags = (UIP_CLOSE as! byte).value;
        if incoming_len > 0u16 {
            result.flags = result.flags | (UIP_NEWDATA as! byte).value;
        }
        result.appcall = true;
        return result;
    }
    if conn_index == 1 {
        uip_add32(&state.conns[1].rcv_nxt[0], (incoming_len + 1u16), &rt.acc32[0]);
        state.conns[1].rcv_nxt[0] = rt.acc32[0];
        state.conns[1].rcv_nxt[1] = rt.acc32[1];
        state.conns[1].rcv_nxt[2] = rt.acc32[2];
        state.conns[1].rcv_nxt[3] = rt.acc32[3];
        state.conns[1].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
        state.conns[1].timer = 0 as byte;
        result.flags = (UIP_CLOSE as! byte).value;
        if incoming_len > 0u16 {
            result.flags = result.flags | (UIP_NEWDATA as! byte).value;
        }
        result.appcall = true;
        return result;
    }
    return result;
}

export fn uip_process_timer(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult {
    _ = rt;
    if conn_index < 0 || conn_index >= 10 {
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    if conn_index == 0 {
        if state.conns[0].tcpstateflags == (UIP_TIME_WAIT as! byte).value || state.conns[0].tcpstateflags == (UIP_FIN_WAIT_2 as! byte).value {
            state.conns[0].timer = state.conns[0].timer + 1 as byte;
            if state.conns[0].timer == (UIP_TIME_WAIT_TIMEOUT as! byte).value {
                state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
            }
            return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: state.conns[0].tcpstateflags == (UIP_CLOSED as! byte).value, logged: false, urgdata: false };
        }
        if state.conns[0].len > 0u16 {
            if state.conns[0].timer == 0 as byte {
                if state.conns[0].nrtx >= 4 as byte {
                    state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
                    return UipProcessResult { flags: (UIP_TIMEDOUT as! byte).value, len: 0u16, poll: false, timed_out: true, retransmit: false, appcall: true, closed: true, logged: false, urgdata: false };
                }
                state.conns[0].nrtx = state.conns[0].nrtx + 1 as byte;
                if state.conns[0].rto == 0 as byte { state.conns[0].timer = 1 as byte; }
                else { state.conns[0].timer = state.conns[0].rto; }
                return UipProcessResult { flags: (UIP_REXMIT as! byte).value, len: state.conns[0].len, poll: false, timed_out: false, retransmit: true, appcall: true, closed: false, logged: false, urgdata: false };
            }
            state.conns[0].timer = state.conns[0].timer - 1 as byte;
        }
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    if conn_index == 1 {
        if state.conns[1].tcpstateflags == (UIP_TIME_WAIT as! byte).value || state.conns[1].tcpstateflags == (UIP_FIN_WAIT_2 as! byte).value {
            state.conns[1].timer = state.conns[1].timer + 1 as byte;
            if state.conns[1].timer == (UIP_TIME_WAIT_TIMEOUT as! byte).value {
                state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
            }
            return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: state.conns[1].tcpstateflags == (UIP_CLOSED as! byte).value, logged: false, urgdata: false };
        }
        if state.conns[1].len > 0u16 {
            if state.conns[1].timer == 0 as byte {
                if state.conns[1].nrtx >= 4 as byte {
                    state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
                    return UipProcessResult { flags: (UIP_TIMEDOUT as! byte).value, len: 0u16, poll: false, timed_out: true, retransmit: false, appcall: true, closed: true, logged: false, urgdata: false };
                }
                state.conns[1].nrtx = state.conns[1].nrtx + 1 as byte;
                if state.conns[1].rto == 0 as byte { state.conns[1].timer = 1 as byte; }
                else { state.conns[1].timer = state.conns[1].rto; }
                return UipProcessResult { flags: (UIP_REXMIT as! byte).value, len: state.conns[1].len, poll: false, timed_out: false, retransmit: true, appcall: true, closed: false, logged: false, urgdata: false };
            }
            state.conns[1].timer = state.conns[1].timer - 1 as byte;
        }
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
}

export fn udp_matches_conn(conn: &UipUdpConn, frame: &UipUdpipHdr) bool {
    if conn.lport != frame.destport {
        return false;
    }
    if conn.rport != 0u16 && conn.rport != frame.srcport {
        return false;
    }
    if (conn.ripaddr.words[0] != 0u16 || conn.ripaddr.words[1] != 0u16) &&
        (conn.ripaddr.words[0] != frame.srcipaddr[0] || conn.ripaddr.words[1] != frame.srcipaddr[1]) {
        return false;
    }
    return true;
}

export fn udp_find_conn(state: &UipState, frame: &UipUdpipHdr) i32 {
    var i: usize = 0usize;
    while i < 10usize {
        if udp_matches_conn(&state.udp_conns[i], frame) {
            return (i as! i32).value;
        }
        i = i + 1usize;
    }
    return -1;
}

export fn udp_input_step(state: &UipState, rt: &UipRuntime, frame: &UipUdpipHdr, payload_len: u16) UipProcessResult {
    const index: i32 = udp_find_conn(state, frame);
    rt.current_udp_conn = index;
    if index < 0 {
        rt.len = 0u16;
        if rt.stats != null {
            rt.stats.udp.drop = rt.stats.udp.drop + 1u16;
        }
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    rt.flags = (UIP_NEWDATA as! byte).value;
    rt.len = payload_len;
    if rt.stats != null {
        rt.stats.udp.recv = rt.stats.udp.recv + 1u16;
    }
    return UipProcessResult { flags: rt.flags, len: payload_len, poll: false, timed_out: false, retransmit: false, appcall: true, closed: false, logged: false, urgdata: false };
}

export fn udp_send_step(state: &UipState, rt: &UipRuntime, conn_index: i32, payload_len: u16) UipProcessResult {
    if conn_index < 0 || conn_index >= 10 {
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    rt.current_udp_conn = conn_index;
    rt.frame.ethip.proto = (UIP_PROTO_UDP as! byte).value;
    rt.frame.ethudp.proto = (UIP_PROTO_UDP as! byte).value;
    rt.frame.ethudp.srcipaddr[0] = rt.hostaddr.words[0];
    rt.frame.ethudp.srcipaddr[1] = rt.hostaddr.words[1];
    if conn_index == 0 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[0].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[0].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[0].lport;
        rt.frame.ethudp.destport = state.udp_conns[0].rport;
    } else if conn_index == 1 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[1].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[1].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[1].lport;
        rt.frame.ethudp.destport = state.udp_conns[1].rport;
    } else if conn_index == 2 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[2].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[2].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[2].lport;
        rt.frame.ethudp.destport = state.udp_conns[2].rport;
    } else if conn_index == 3 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[3].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[3].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[3].lport;
        rt.frame.ethudp.destport = state.udp_conns[3].rport;
    } else if conn_index == 4 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[4].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[4].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[4].lport;
        rt.frame.ethudp.destport = state.udp_conns[4].rport;
    } else if conn_index == 5 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[5].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[5].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[5].lport;
        rt.frame.ethudp.destport = state.udp_conns[5].rport;
    } else if conn_index == 6 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[6].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[6].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[6].lport;
        rt.frame.ethudp.destport = state.udp_conns[6].rport;
    } else if conn_index == 7 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[7].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[7].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[7].lport;
        rt.frame.ethudp.destport = state.udp_conns[7].rport;
    } else if conn_index == 8 {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[8].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[8].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[8].lport;
        rt.frame.ethudp.destport = state.udp_conns[8].rport;
    } else {
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[9].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[9].ripaddr.words[1];
        rt.frame.ethudp.srcport = state.udp_conns[9].lport;
        rt.frame.ethudp.destport = state.udp_conns[9].rport;
    }
    rt.frame.ethudp.udplen = htons(payload_len + 8u16);
    rt.frame.ethip.len[0] = (((payload_len + 28u16) >> 8) as! byte).value;
    rt.frame.ethip.len[1] = (((payload_len + 28u16) & 255u16) as! byte).value;
    rt.len = payload_len + 28u16;
    if rt.stats != null {
        rt.stats.udp.sent = rt.stats.udp.sent + 1u16;
    }
    return UipProcessResult { flags: 0 as byte, len: rt.len, poll: false, timed_out: false, retransmit: false, appcall: true, closed: false, logged: false, urgdata: false };
}

export fn uip_process_core(state: &UipState, rt: &UipRuntime, flag: i32, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult {
    if flag == UIP_UDP_TIMER {
        rt.current_conn = -1;
        rt.current_udp_conn = conn_index;
        rt.flags = (UIP_POLL as! byte).value;
        return UipProcessResult { flags: rt.flags, len: rt.len, poll: true, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    if conn_index < 0 {
        rt.frame.ethtcp.flags = ((TCP_RST | TCP_ACK) as! byte).value;
        rt.frame.ethip.proto = (UIP_PROTO_TCP as! byte).value;
        return UipProcessResult { flags: (UIP_ABORT as! byte).value, len: 1u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: true, urgdata: false };
    }
    if conn_index == 0 {
        const ts0: byte = state.conns[0].tcpstateflags & 15 as byte;
        if ts0 == (UIP_SYN_SENT as! byte).value {
            if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte && (rt.frame.ethtcp.flags & 0x3f as byte) == ((TCP_SYN | TCP_ACK) as! byte).value {
                state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
                rt.frame.ethtcp.flags = (TCP_ACK as! byte).value;
                return UipProcessResult { flags: (UIP_ABORT as! byte).value, len: 1u16, poll: false, timed_out: false, retransmit: false, appcall: true, closed: false, logged: false, urgdata: false };
            }
            return tcp_syn_sent_step(state, rt, conn_index, &rt.frame);
        }
        if ts0 == (UIP_SYN_RCVD as! byte).value {
            const result1: UipProcessResult = tcp_syn_rcvd_step(state, rt, conn_index, incoming_len, app_slen);
            _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
            if rt.stats != null {
                rt.stats.tcp.sent = rt.stats.tcp.sent + 1u16;
            }
            return result1;
        }
        if ts0 == (UIP_FIN_WAIT_2 as! byte).value && has_fin {
            const result2: UipProcessResult = tcp_fin_wait_2_step(state, rt, conn_index, incoming_len, has_fin);
            _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
            if rt.stats != null {
                rt.stats.tcp.sent = rt.stats.tcp.sent + 1u16;
            }
            return result2;
        }
    }
    return uip_process_tcp_core(state, rt, conn_index, incoming_len, has_ack, has_fin, app_slen);
}

export fn tcp_build_ack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool {
    if conn_index < 0 || conn_index >= 10 {
        return false;
    }
    if conn_index == 0 {
        out.srcport = state.conns[0].lport;
        out.destport = state.conns[0].rport;
        out.srcipaddr[0] = rt.hostaddr.words[0];
        out.srcipaddr[1] = rt.hostaddr.words[1];
        out.destipaddr[0] = state.conns[0].ripaddr.words[0];
        out.destipaddr[1] = state.conns[0].ripaddr.words[1];
        out.seqno[0] = state.conns[0].snd_nxt[0];
        out.seqno[1] = state.conns[0].snd_nxt[1];
        out.seqno[2] = state.conns[0].snd_nxt[2];
        out.seqno[3] = state.conns[0].snd_nxt[3];
        out.ackno[0] = state.conns[0].rcv_nxt[0];
        out.ackno[1] = state.conns[0].rcv_nxt[1];
        out.ackno[2] = state.conns[0].rcv_nxt[2];
        out.ackno[3] = state.conns[0].rcv_nxt[3];
        out.flags = (TCP_ACK as! byte).value;
        out.tcpoffset = 0x50 as byte;
        return true;
    }
    if conn_index == 1 {
        out.srcport = state.conns[1].lport;
        out.destport = state.conns[1].rport;
        out.srcipaddr[0] = rt.hostaddr.words[0];
        out.srcipaddr[1] = rt.hostaddr.words[1];
        out.destipaddr[0] = state.conns[1].ripaddr.words[0];
        out.destipaddr[1] = state.conns[1].ripaddr.words[1];
        out.seqno[0] = state.conns[1].snd_nxt[0];
        out.seqno[1] = state.conns[1].snd_nxt[1];
        out.seqno[2] = state.conns[1].snd_nxt[2];
        out.seqno[3] = state.conns[1].snd_nxt[3];
        out.ackno[0] = state.conns[1].rcv_nxt[0];
        out.ackno[1] = state.conns[1].rcv_nxt[1];
        out.ackno[2] = state.conns[1].rcv_nxt[2];
        out.ackno[3] = state.conns[1].rcv_nxt[3];
        out.flags = (TCP_ACK as! byte).value;
        out.tcpoffset = 0x50 as byte;
        return true;
    }
    return false;
}

export fn tcp_build_synack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool {
    if !tcp_build_ack(state, rt, conn_index, out) {
        return false;
    }
    out.flags = ((TCP_SYN | TCP_ACK) as! byte).value;
    out.optdata[0] = (TCP_OPT_MSS as! byte).value;
    out.optdata[1] = (TCP_OPT_MSS_LEN as! byte).value;
    out.optdata[2] = (((uip_const_tcp_mss() as! u16).value >> 8) as! byte).value;
    out.optdata[3] = (((uip_const_tcp_mss() as! u16).value & 255u16) as! byte).value;
    out.tcpoffset = 0x60 as byte;
    return true;
}

export fn tcp_build_finack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool {
    if !tcp_build_ack(state, rt, conn_index, out) {
        return false;
    }
    out.flags = ((TCP_FIN | TCP_ACK) as! byte).value;
    return true;
}

export fn tcp_ack_only_step(state: &UipState, conn_index: i32, has_ack: bool, incoming_len: u16, has_fin: bool, has_rst: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if !has_ack || incoming_len != 0u16 || has_fin || has_rst {
        return result;
    }
    if conn_index == 0 {
        const ts: byte = state.conns[0].tcpstateflags & 15 as byte;
        if ts == (UIP_ESTABLISHED as! byte).value || ts == 5 as byte || ts == (UIP_TIME_WAIT as! byte).value {
            result.flags = (UIP_ACKDATA as! byte).value;
        }
        return result;
    }
    if conn_index == 1 {
        const ts: byte = state.conns[1].tcpstateflags & 15 as byte;
        if ts == (UIP_ESTABLISHED as! byte).value || ts == 5 as byte || ts == (UIP_TIME_WAIT as! byte).value {
            result.flags = (UIP_ACKDATA as! byte).value;
        }
        return result;
    }
    return result;
}

export fn ipv6_input_neighbor_bridge(ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr, bridge_result: byte) byte {
    if icmp6_is_neighbor_message(hdr as &UipIcmp6Hdr) {
        return bridge_result;
    }
    return ipv6_icmp6_neighbor_input_step(ip, hdr);
}

export fn ipv6_process_runtime_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr, rt: &UipRuntime) byte {
    ip_count_recv(rt);
    const was_echo_request: bool = icmp6_is_echo_request(icmp);
    const was_ns: bool = icmp6_is_ns(icmp);
    const was_invalid_nd: bool = icmp6_is_neighbor_message(icmp) && (icmp.code != 0 as byte || ip.ttl != 255 as byte);
    const result: byte = ipv6_process_step(ip, icmp);
    if result == (IPV6_PROCESS_ICMP6 as! byte).value {
        icmp_count_recv(rt);
        if was_echo_request || was_ns {
            icmp_count_sent(rt);
            uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
            if was_invalid_nd {
                icmp_count_drop(rt);
                ip_count_drop(rt);
                return (IPV6_PROCESS_DROP as! byte).value;
            }
            return result;
        }
        if was_invalid_nd {
            icmp_count_drop(rt);
            ip_count_drop(rt);
            uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
            return (IPV6_PROCESS_DROP as! byte).value;
        }
        if !(icmp6_is_na(icmp) || icmp6_is_echo_reply(icmp)) {
            icmp_count_drop(rt);
            ip_count_drop(rt);
            uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
            return (IPV6_PROCESS_DROP as! byte).value;
        }
        uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
        return result;
    }
    if ip.proto == (UIP_PROTO_ICMP6 as! byte).value {
        icmp_count_recv(rt);
        if icmp6_is_echo_request(icmp) {
            icmp_count_sent(rt);
            uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
            return result;
        }
        icmp_count_drop(rt);
        uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
        ip_count_drop(rt);
        return result;
    }
    if result == (IPV6_PROCESS_TCP as! byte).value || result == (IPV6_PROCESS_UDP as! byte).value {
        uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, ip.proto as u16);
        return result;
    }
    ip_count_drop(rt);
    return result;
}

export fn ip_count_recv(rt: &UipRuntime) void { if rt.stats != null { rt.stats.ip.recv = rt.stats.ip.recv + 1u16; } }
export fn ip_count_drop(rt: &UipRuntime) void { if rt.stats != null { rt.stats.ip.drop = rt.stats.ip.drop + 1u16; } }
export fn icmp_count_recv(rt: &UipRuntime) void { if rt.stats != null { rt.stats.icmp.recv = rt.stats.icmp.recv + 1u16; } }
export fn icmp_count_sent(rt: &UipRuntime) void { if rt.stats != null { rt.stats.icmp.sent = rt.stats.icmp.sent + 1u16; } }
export fn icmp_count_drop(rt: &UipRuntime) void { if rt.stats != null { rt.stats.icmp.drop = rt.stats.icmp.drop + 1u16; } }
export fn hdr_invalid_for_runtime(icmp: &UipIcmp6Hdr) bool { return icmp.code != 0 as byte && icmp6_is_neighbor_message(icmp); }
export fn udp_input_checksum_error_step(rt: &UipRuntime) UipProcessResult {
    rt.len = 0u16;
    if rt.stats != null {
        rt.stats.udp.chkerr = rt.stats.udp.chkerr + 1u16;
        rt.stats.udp.drop = rt.stats.udp.drop + 1u16;
    }
    return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
}

export fn uip_stats_init(stats: &UipStats) void {
    stats.ip = UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 };
    stats.icmp = UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 };
    stats.tcp = UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 };
    stats.udp = UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 };
}

export fn uip_runtime_clear_log(rt: &UipRuntime) void { rt.logcode = (UIP_LOG_NONE as! byte).value; rt.logparam = 0u16; }
export fn uip_runtime_log(rt: &UipRuntime, code: byte, param: u16) void { rt.logcode = code; rt.logparam = param; }

export fn uip_runtime_init(rt: &UipRuntime) void {
    rt.hostaddr = UipIpAddr { words: [0u16, 0u16] };
    rt.draddr = UipIpAddr { words: [0u16, 0u16] };
    rt.netmask = UipIpAddr { words: [0u16, 0u16] };
    rt.len = 0u16;
    rt.slen = 0u16;
    rt.urglen = 0u16;
    rt.surglen = 0u16;
    rt.flags = 0 as byte;
    rt.current_conn = -1;
    rt.current_udp_conn = -1;
    rt.acc32[0] = 0 as byte; rt.acc32[1] = 0 as byte; rt.acc32[2] = 0 as byte; rt.acc32[3] = 0 as byte;
    rt.ipid = 0u16;
    rt.iss[0] = 0 as byte; rt.iss[1] = 0 as byte; rt.iss[2] = 0 as byte; rt.iss[3] = 0 as byte;
    rt.appdata = null; rt.sappdata = null; rt.urgdata = null;
    uip_runtime_clear_log(rt);
}

export fn uip_tcp_prepare_urg(rt: &UipRuntime, incoming_len: u16) bool {
    if (rt.frame.ethtcp.flags & (TCP_URG as! byte).value) == 0 as byte { rt.urgdata = null; rt.urglen = 0u16; return false; }
    rt.urgdata = rt.appdata;
    if rt.frame.ethtcp.urgp == 0u16 { rt.urglen = 1u16; }
    else if rt.frame.ethtcp.urgp > incoming_len { rt.urglen = incoming_len; }
    else { rt.urglen = rt.frame.ethtcp.urgp; }
    uip_runtime_log(rt, (UIP_LOG_TCP_URG as! byte).value, rt.urglen);
    return rt.urglen > 0u16;
}

fn reass_match_current(state: &UipReassState, frame: &EthIpHdr) bool {
    return frame.srcipaddr[0] == state.srcipaddr[0] && frame.srcipaddr[1] == state.srcipaddr[1] && frame.destipaddr[0] == state.destipaddr[0] && frame.destipaddr[1] == state.destipaddr[1] && frame.ipid[0] == state.ipid[0] && frame.ipid[1] == state.ipid[1] && frame.proto == state.proto;
}
fn reass_copy_header(state: &UipReassState, frame: &EthIpHdr) void {
    const src: &byte = @ptr_from_usize(@usize_from_ptr(frame as &void)) as &byte;
    var i: usize = 0; while i < 20usize { state.buf[i] = src[i]; i = i + 1; }
    state.srcipaddr[0] = frame.srcipaddr[0];
    state.srcipaddr[1] = frame.srcipaddr[1];
    state.destipaddr[0] = frame.destipaddr[0];
    state.destipaddr[1] = frame.destipaddr[1];
    state.ipid[0] = frame.ipid[0];
    state.ipid[1] = frame.ipid[1];
    state.proto = frame.proto;
}
export fn uip_reass_init(state: &UipReassState) void {
    var i: usize = 0; while i < 386usize { state.buf[i] = 0 as byte; i = i + 1; }
    i = 0; while i < 6usize { state.bitmap[i] = 0 as byte; i = i + 1; }
    state.len = 0u16; state.flags = 0 as byte; state.timer = 0 as byte;
    state.srcipaddr[0] = 0u16; state.srcipaddr[1] = 0u16;
    state.destipaddr[0] = 0u16; state.destipaddr[1] = 0u16;
    state.ipid[0] = 0 as byte; state.ipid[1] = 0 as byte; state.proto = 0 as byte;
}
export fn uip_reass_overflow(frame: &EthIpHdr) bool {
    const offset_units: u16 = ((((frame.ipoffset[0] as u16) & 0x1fu16) << 8) | (frame.ipoffset[1] as u16));
    const offset: u16 = offset_units * 8u16;
    return offset > (UIP_REASS_BUFSIZE as! u16).value;
}
export fn uip_reass_step(state: &UipReassState, frame: &EthIpHdr, payload: &byte, payload_len: u16, out: &EthIpHdr) u16 {
    const offset: u16 = ((((frame.ipoffset[0] as u16) & 0x1fu16) << 8) | (frame.ipoffset[1] as u16)) * 8u16;
    const ihl_bytes: u16 = (((frame.vhl & 0x0fu16 as! byte catch |_| { 0 as byte; }) as u16) * 4u16);
    const total_len: u16 = (((frame.len[0] as u16) << 8) | (frame.len[1] as u16));
    var frag_len: u16 = payload_len;
    if total_len >= ihl_bytes {
        frag_len = total_len - ihl_bytes;
    }
    if state.timer == 0 as byte || !reass_match_current(state, frame) {
        reass_copy_header(state, frame);
        state.timer = (UIP_REASS_MAXAGE as! byte).value;
        state.flags = 0 as byte;
        state.len = 0u16;
        var clear_i: usize = 0usize;
        while clear_i < 6usize {
            state.bitmap[clear_i] = 0 as byte;
            clear_i = clear_i + 1usize;
        }
    }
    if offset > (UIP_REASS_BUFSIZE as! u16).value || (offset + frag_len) > (UIP_REASS_BUFSIZE as! u16).value {
        state.timer = 0 as byte;
        return 0u16;
    }
    var copy_len: u16 = payload_len;
    if copy_len > frag_len {
        copy_len = frag_len;
    }
    var i: u16 = 0u16;
    while i < copy_len {
        const pos: u16 = offset + i;
        const frag_bit: u16 = pos / 8u16;
        const byte_index: usize = (frag_bit / 8u16) as usize;
        const bit_index: usize = (frag_bit & 7u16) as usize;
        var already_present: bool = false;
        if byte_index < 6usize {
            already_present = (state.bitmap[byte_index] & ((1u16 << bit_index) as! byte catch |_| { 0 as byte; })) != 0 as byte;
        }
        if !already_present {
            state.buf[(20u16 + pos) as usize] = payload[i as usize];
        }
        i = i + 1u16;
    }
    var bit_off: u16 = offset / 8u16;
    var bit_count: u16 = (frag_len + 7u16) / 8u16;
    while bit_count > 0u16 {
        const byte_index: usize = (bit_off / 8u16) as usize;
        const bit_index: usize = (bit_off & 7u16) as usize;
        if byte_index < 6usize {
            state.bitmap[byte_index] = state.bitmap[byte_index] | ((1u16 << bit_index) as! byte catch |_| { 0 as byte; });
        }
        bit_off = bit_off + 1u16;
        bit_count = bit_count - 1u16;
    }
    if (frame.ipoffset[0] & (IP_MF as! byte).value) == 0 as byte {
        state.flags = state.flags | (UIP_REASS_FLAG_LASTFRAG as! byte).value;
        state.len = offset + frag_len;
    }
    if (state.flags & (UIP_REASS_FLAG_LASTFRAG as! byte).value) == 0 as byte {
        return 0u16;
    }
    var expect_bit: u16 = 0u16;
    const need_bits: u16 = (state.len + 7u16) / 8u16;
    while expect_bit < need_bits {
        const byte_index: usize = (expect_bit / 8u16) as usize;
        const bit_index: usize = (expect_bit & 7u16) as usize;
        if byte_index >= 6usize {
            return 0u16;
        }
        if (state.bitmap[byte_index] & ((1u16 << bit_index) as! byte catch |_| { 0 as byte; })) == 0 as byte {
            return 0u16;
        }
        expect_bit = expect_bit + 1u16;
    }
    const src_hdr: &EthIpHdr = @ptr_from_usize(@usize_from_ptr(&state.buf[0] as &void)) as &EthIpHdr;
    out.ethhdr = src_hdr.ethhdr;
    out.vhl = src_hdr.vhl;
    out.tos = src_hdr.tos;
    out.ipid[0] = src_hdr.ipid[0];
    out.ipid[1] = src_hdr.ipid[1];
    out.ipoffset[0] = 0 as byte;
    out.ipoffset[1] = 0 as byte;
    out.ttl = src_hdr.ttl;
    out.proto = src_hdr.proto;
    out.srcipaddr[0] = src_hdr.srcipaddr[0];
    out.srcipaddr[1] = src_hdr.srcipaddr[1];
    out.destipaddr[0] = src_hdr.destipaddr[0];
    out.destipaddr[1] = src_hdr.destipaddr[1];
    const packet_len: u16 = state.len + ihl_bytes;
    out.len[0] = ((packet_len >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    out.len[1] = (packet_len & 0xffu16) as! byte catch |_| { 0 as byte; };
    const hdr_ptr: &byte = @ptr_from_usize(@usize_from_ptr(out as &void)) as &byte;
    out.ipchksum = 0u16;
    out.ipchksum = uip_ipchksum(@ptr_from_usize(@usize_from_ptr(hdr_ptr as &void) - 14usize) as &byte);
    state.timer = 0 as byte;
    return state.len;
}
export fn uip_reass_tick(state: &UipReassState) void { if state.timer > 0 as byte { state.timer = state.timer - 1 as byte; } }

export fn tcp_rst_input_step(state: &UipState, conn_index: i32) UipProcessResult {
    if conn_index == 0 {
        state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
    } else if conn_index == 1 {
        state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
    }
    return UipProcessResult { flags: (UIP_ABORT as! byte).value, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: true, closed: true, logged: false, urgdata: false };
}

export fn tcp_stopped_step(state: &UipState, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult {
    if !has_fin {
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: false, urgdata: false };
    }
    if conn_index == 0 {
        state.conns[0].tcpstateflags = (UIP_LAST_ACK as! byte).value;
    } else if conn_index == 1 {
        state.conns[1].tcpstateflags = (UIP_LAST_ACK as! byte).value;
    }
    return UipProcessResult { flags: (UIP_CLOSE as! byte).value, len: incoming_len, poll: false, timed_out: false, retransmit: false, appcall: true, closed: false, logged: false, urgdata: false };
}

export fn tcp_close_step(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult {
    _ = rt;
    if conn_index == 0 {
        state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
    } else if conn_index == 1 {
        state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
    }
    return UipProcessResult { flags: (UIP_CLOSED as! byte).value, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: true, closed: true, logged: false, urgdata: false };
}

export fn uip_process_tcp_core(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult {
    rt.urgdata = null; rt.urglen = 0u16; uip_runtime_clear_log(rt);
    var has_urg: bool = false; if incoming_len > 0u16 { has_urg = uip_tcp_prepare_urg(rt, incoming_len); }
    if conn_index >= 0 && conn_index < 10 && incoming_len > 0u16 {
        if rt.stats != null {
            rt.stats.tcp.recv = rt.stats.tcp.recv + 1u16;
        }
        if conn_index == 0 { state.conns[0].appstate = state.conns[0].appstate + 1u16; }
        else if conn_index == 1 { state.conns[1].appstate = state.conns[1].appstate + 1u16; }
        uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, incoming_len);
    }
    if conn_index < 0 {
        if rt.stats != null {
            rt.stats.tcp.drop = rt.stats.tcp.drop + 1u16;
        }
        const srcport: u16 = rt.frame.ethtcp.srcport;
        const destport: u16 = rt.frame.ethtcp.destport;
        const src0: u16 = rt.frame.ethtcp.srcipaddr[0];
        const src1: u16 = rt.frame.ethtcp.srcipaddr[1];
        const dst0: u16 = rt.frame.ethtcp.destipaddr[0];
        const dst1: u16 = rt.frame.ethtcp.destipaddr[1];
        rt.frame.ethtcp.destport = srcport;
        rt.frame.ethtcp.srcport = destport;
        rt.frame.ethtcp.srcipaddr[0] = dst0;
        rt.frame.ethtcp.srcipaddr[1] = dst1;
        rt.frame.ethtcp.destipaddr[0] = src0;
        rt.frame.ethtcp.destipaddr[1] = src1;
        rt.frame.ethtcp.flags = ((TCP_RST | TCP_ACK) as! byte).value;
        rt.frame.ethtcp.ackno[0] = rt.frame.ethtcp.seqno[0];
        rt.frame.ethtcp.ackno[1] = rt.frame.ethtcp.seqno[1];
        rt.frame.ethtcp.ackno[2] = rt.frame.ethtcp.seqno[2];
        rt.frame.ethtcp.ackno[3] = (((rt.frame.ethtcp.seqno[3] as i32) + 1) as! byte).value;
        uip_runtime_log(rt, (UIP_LOG_RST as! byte).value, 0u16);
        if rt.stats != null {
            rt.stats.tcp.sent = rt.stats.tcp.sent + 1u16;
        }
        return UipProcessResult { flags: (UIP_ABORT as! byte).value, len: 1u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: true, urgdata: has_urg };
    }
    var raw_stateflag: byte = 0 as byte;
    var stateflag: byte = 0 as byte;
    if conn_index == 0 {
        raw_stateflag = state.conns[0].tcpstateflags;
    } else if conn_index == 1 {
        raw_stateflag = state.conns[1].tcpstateflags;
    } else {
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
    }
    stateflag = raw_stateflag & 15 as byte;
    if (rt.frame.ethtcp.flags & (TCP_RST as! byte).value) != 0 as byte {
        const rst_result: UipProcessResult = tcp_rst_input_step(state, conn_index);
        rst_result.urgdata = has_urg;
        return rst_result;
    }
    var conn_ref: &UipConn = &state.conns[0];
    if conn_index == 1 { conn_ref = &state.conns[1]; }
        if !tcp_seq_matches(conn_ref, &rt.frame, incoming_len) {
        const ctl: byte = rt.frame.ethtcp.flags & (((TCP_SYN | TCP_FIN) as! byte).value);
        if incoming_len > 0u16 || ctl != 0 as byte {
            _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
            if rt.stats != null {
                rt.stats.tcp.drop = rt.stats.tcp.drop + 1u16;
                rt.stats.tcp.sent = rt.stats.tcp.sent + 1u16;
            }
            return UipProcessResult { flags: 0 as byte, len: 1u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
        }
    }
    if raw_stateflag == (UIP_STOPPED as! byte).value {
        const stopped_result: UipProcessResult = tcp_stopped_step(state, conn_index, incoming_len, has_fin);
        stopped_result.urgdata = has_urg;
        return stopped_result;
    }
    if raw_stateflag == (UIP_ESTABLISHED as! byte).value {
        const ack_result: UipProcessResult = tcp_ack_outstanding(state, rt, conn_index, &rt.frame);
        rt.flags = ack_result.flags;
        if has_fin {
            var outstanding: u16 = 0u16;
            if conn_index == 0 {
                outstanding = state.conns[0].len;
            } else if conn_index == 1 {
                outstanding = state.conns[1].len;
            }
            if outstanding > 0u16 {
                return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
            }
            const fin_result: UipProcessResult = tcp_established_fin_step(state, rt, conn_index, incoming_len, has_fin);
            if rt.stats != null {
                rt.stats.tcp.sent = rt.stats.tcp.sent + 1u16;
            }
            fin_result.appcall = true;
            fin_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
            fin_result.urgdata = has_urg;
            return fin_result;
        }
        if incoming_len == 0u16 {
            const ack_only_result: UipProcessResult = tcp_ack_only_step(state, conn_index, has_ack, incoming_len, has_fin, false);
            if ack_result.flags != 0 as byte {
                ack_only_result.flags = ack_result.flags;
            }
            ack_only_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
            ack_only_result.urgdata = has_urg;
            return ack_only_result;
        }
        const data_result: UipProcessResult = tcp_established_data_step(state, rt, conn_index, incoming_len, app_slen);
        data_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
        data_result.urgdata = has_urg;
        return data_result;
    }
    if raw_stateflag == (UIP_LAST_ACK as! byte).value {
        if has_ack {
            const close_result: UipProcessResult = tcp_close_step(state, rt, conn_index);
            close_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
            close_result.urgdata = has_urg;
            return close_result;
        }
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
    }
    if raw_stateflag == (UIP_FIN_WAIT_1 as! byte).value {
        if has_fin {
            if has_ack {
                if conn_index == 0 { state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value; }
                else if conn_index == 1 { state.conns[1].tcpstateflags = (UIP_TIME_WAIT as! byte).value; }
            } else {
                if conn_index == 0 { state.conns[0].tcpstateflags = (UIP_CLOSING as! byte).value; }
                else if conn_index == 1 { state.conns[1].tcpstateflags = (UIP_CLOSING as! byte).value; }
            }
            const fin_ack_result: UipProcessResult = tcp_ack_only_step(state, conn_index, has_ack, incoming_len, has_fin, false);
            fin_ack_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
            fin_ack_result.urgdata = has_urg;
            return fin_ack_result;
        }
        if has_ack {
            if conn_index == 0 { state.conns[0].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value; }
            else if conn_index == 1 { state.conns[1].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value; }
            return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
        }
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
    }
    if raw_stateflag == (UIP_CLOSING as! byte).value {
        if has_ack {
            if conn_index == 0 { state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value; }
            else if conn_index == 1 { state.conns[1].tcpstateflags = (UIP_TIME_WAIT as! byte).value; }
        }
        return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
    }
    if incoming_len == 0u16 && !has_fin {
        const ack_only_result: UipProcessResult = tcp_ack_only_step(state, conn_index, has_ack, incoming_len, has_fin, false);
        ack_only_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
        ack_only_result.urgdata = has_urg;
        return ack_only_result;
    }
    return UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: false, closed: false, logged: rt.logcode != (UIP_LOG_NONE as! byte).value, urgdata: has_urg };
}
