// Core split from uiplib.uya.

export const ICMP6_ECHO_REQUEST: i32 = 128;
export const ICMP6_ECHO_REPLY: i32 = 129;
export const ICMP6_NS: i32 = 135;
export const ICMP6_NA: i32 = 136;
export const IPV6_INPUT_DROP: i32 = 0;
export const IPV6_ICMP6_DROP: i32 = 0;
export const IPV6_ICMP6_REPLY_READY: i32 = 1;
export const IPV6_ICMP6_UNHANDLED: i32 = 2;
export const IPV6_INPUT_ICMP6: i32 = 1;
export const IPV6_INPUT_TCP: i32 = 2;
export const IPV6_INPUT_UDP: i32 = 3;
export const IP_MF: i32 = 0x20;

export const IPV6_INPUT_ECHO_REPLY: i32 = 5;
export const IPV6_INPUT_NS_REPLY: i32 = 6;

export const IPV6_PROCESS_DROP: i32 = 10;
export const IPV6_PROCESS_ICMP6: i32 = 11;
export const IPV6_PROCESS_TCP: i32 = 12;
export const IPV6_PROCESS_UDP: i32 = 13;

export const IPV6_TCP_INPUT_READY: i32 = 20;
export const IPV6_UDP_INPUT_READY: i32 = 21;

export fn ipv6_tcp_input_step(ip: &UipIpv6Hdr) byte {
    if !ipv6_version_ok(ip) || !ipv6_is_tcp(ip) {
        return (IPV6_PROCESS_DROP as! byte).value;
    }
    return (IPV6_TCP_INPUT_READY as! byte).value;
}

export fn ipv6_udp_input_step(ip: &UipIpv6Hdr) byte {
    if !ipv6_version_ok(ip) || !ipv6_is_udp(ip) {
        return (IPV6_PROCESS_DROP as! byte).value;
    }
    return (IPV6_UDP_INPUT_READY as! byte).value;
}

export fn ipv6_process_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) byte {
    const kind: byte = ipv6_input_classify(ip);
    if kind == (IPV6_INPUT_ICMP6 as! byte).value {
        const result: byte = ipv6_input_step(ip, icmp);
        if result == (IPV6_ICMP6_REPLY_READY as! byte).value || result == (IPV6_ICMP6_UNHANDLED as! byte).value {
            return (IPV6_PROCESS_ICMP6 as! byte).value;
        }
        if result == (IPV6_ICMP6_DROP as! byte).value {
            return (IPV6_PROCESS_DROP as! byte).value;
        }
        return (IPV6_PROCESS_DROP as! byte).value;
    }
    if kind == (IPV6_INPUT_TCP as! byte).value {
        _ = ipv6_tcp_input_step(ip);
        return (IPV6_PROCESS_TCP as! byte).value;
    }
    if kind == (IPV6_INPUT_UDP as! byte).value {
        _ = ipv6_udp_input_step(ip);
        return (IPV6_PROCESS_UDP as! byte).value;
    }
    return (IPV6_PROCESS_DROP as! byte).value;
}

export fn ipv6_input_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) byte {
    const kind: byte = ipv6_input_classify(ip);
    if kind == (IPV6_INPUT_ICMP6 as! byte).value {
        if icmp6_is_echo_request(icmp) || icmp6_is_echo_reply(icmp) {
            return ipv6_icmp6_echo_input_step(ip, icmp);
        }
        if icmp6_is_neighbor_message(icmp) {
            return ipv6_icmp6_neighbor_input_step(ip, icmp as &UipIcmp6NeighborHdr);
        }
    }
    return kind;
}

export fn ipv6_version_ok(hdr: &UipIpv6Hdr) bool { return (hdr.vtc >> 4) == 6 as byte; }
export fn icmp6_type(hdr: &UipIcmp6Hdr) byte { return hdr.type; }
export fn icmp6_is_echo_request(hdr: &UipIcmp6Hdr) bool { return hdr.type == (ICMP6_ECHO_REQUEST as! byte).value; }
export fn icmp6_is_ns(hdr: &UipIcmp6Hdr) bool { return hdr.type == (ICMP6_NS as! byte).value; }
export fn icmp6_is_na(hdr: &UipIcmp6Hdr) bool { return hdr.type == (ICMP6_NA as! byte).value; }

export fn icmp6_is_echo_reply(hdr: &UipIcmp6Hdr) bool { return hdr.type == (ICMP6_ECHO_REPLY as! byte).value; }
export fn icmp6_is_neighbor_message(hdr: &UipIcmp6Hdr) bool { return hdr.type == (ICMP6_NS as! byte).value || hdr.type == (ICMP6_NA as! byte).value; }
export fn icmp6_echo_reply_prepare(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) bool {
    if !icmp6_is_echo_request(icmp) {
        return false;
    }
    icmp.type = (ICMP6_ECHO_REPLY as! byte).value;
    icmp.code = 0 as byte;
    icmp.icmpchksum = 0u16;
    var i: usize = 0usize;
    while i < 8usize {
        const tmp: u16 = ip.srcipaddr[i];
        ip.srcipaddr[i] = ip.destipaddr[i];
        ip.destipaddr[i] = tmp;
        i = i + 1usize;
    }
    var raw_icmp: &byte = @ptr_from_usize(@usize_from_ptr(icmp as &void)) as &byte;
    icmp.icmpchksum = ipv6_icmp6_checksum(ip, raw_icmp, 8u16);
    return true;
}

export fn ipv6_next_header(hdr: &UipIpv6Hdr) byte { return hdr.proto; }
export fn ipv6_is_icmp6(hdr: &UipIpv6Hdr) bool { return hdr.proto == (UIP_PROTO_ICMP6 as! byte).value; }
export fn ipv6_is_tcp(hdr: &UipIpv6Hdr) bool { return hdr.proto == (UIP_PROTO_TCP as! byte).value; }
export fn ipv6_is_udp(hdr: &UipIpv6Hdr) bool { return hdr.proto == (UIP_PROTO_UDP as! byte).value; }
export fn ipv6_input_classify(hdr: &UipIpv6Hdr) byte {
    if !ipv6_version_ok(hdr) {
        return (IPV6_INPUT_DROP as! byte).value;
    }
    if ipv6_is_icmp6(hdr) {
        return (IPV6_INPUT_ICMP6 as! byte).value;
    }
    if ipv6_is_tcp(hdr) {
        return (IPV6_INPUT_TCP as! byte).value;
    }
    if ipv6_is_udp(hdr) {
        return (IPV6_INPUT_UDP as! byte).value;
    }
    return (IPV6_INPUT_DROP as! byte).value;
}

export fn icmp6_neighbor_target(hdr: &UipIcmp6NeighborHdr) &u16 { return &hdr.targetipaddr[0]; }
export fn icmp6_na_prepare_from_ns(ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr) bool {
    if hdr.type != (ICMP6_NS as! byte).value {
        return false;
    }
    hdr.type = (ICMP6_NA as! byte).value;
    hdr.code = 0 as byte;
    hdr.flags[0] = 0x60 as byte;
    hdr.flags[1] = 0 as byte;
    hdr.flags[2] = 0 as byte;
    hdr.flags[3] = 0 as byte;
    hdr.icmpchksum = 0u16;
    var i: usize = 0usize;
    while i < 8usize {
        const tmp: u16 = ip.srcipaddr[i];
        ip.srcipaddr[i] = ip.destipaddr[i];
        ip.destipaddr[i] = tmp;
        i = i + 1usize;
    }
    var raw_neigh: &byte = @ptr_from_usize(@usize_from_ptr(hdr as &void)) as &byte;
    hdr.icmpchksum = ipv6_icmp6_checksum(ip, raw_neigh, 24u16);
    return true;
}

export fn ipv6_icmp6_echo_input_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) byte {
    if icmp6_is_echo_request(icmp) {
        _ = icmp6_echo_reply_prepare(ip, icmp);
        return (IPV6_ICMP6_REPLY_READY as! byte).value;
    }
    if icmp6_is_echo_reply(icmp) {
        return (IPV6_ICMP6_UNHANDLED as! byte).value;
    }
    return (IPV6_ICMP6_DROP as! byte).value;
}

export fn ipv6_icmp6_neighbor_input_step(ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr) byte {
    if hdr.code != 0 as byte || ip.ttl != 255 as byte {
        return (IPV6_ICMP6_DROP as! byte).value;
    }
    if hdr.type == (ICMP6_NS as! byte).value {
        _ = icmp6_na_prepare_from_ns(ip, hdr);
        return (IPV6_ICMP6_REPLY_READY as! byte).value;
    }
    if hdr.type == (ICMP6_NA as! byte).value {
        if ip.srcipaddr[0] == 0u16 && ip.srcipaddr[1] == 0u16 && ip.srcipaddr[2] == 0u16 && ip.srcipaddr[3] == 0u16 && ip.srcipaddr[4] == 0u16 && ip.srcipaddr[5] == 0u16 && ip.srcipaddr[6] == 0u16 && ip.srcipaddr[7] == 0u16 {
            return (IPV6_ICMP6_DROP as! byte).value;
        }
        return (IPV6_ICMP6_UNHANDLED as! byte).value;
    }
    return (IPV6_ICMP6_DROP as! byte).value;
}

export fn ipv6_addr_sum(ip: &UipIpv6Hdr, src: bool) u32 {
    var sum: u32 = 0u32;
    var i: usize = 0usize;
    while i < 8usize {
        if src {
            sum = sum + (ip.srcipaddr[i] as u32);
        } else {
            sum = sum + (ip.destipaddr[i] as u32);
        }
        i = i + 1usize;
    }
    return sum;
}
export fn ipv6_icmp6_checksum(ip: &UipIpv6Hdr, icmp: &byte, icmp_len: u16) u16 {
    var sum: u32 = 0u32;
    sum = sum + ipv6_addr_sum(ip, true);
    sum = sum + ipv6_addr_sum(ip, false);
    sum = sum + (icmp_len as u32);
    sum = sum + (UIP_PROTO_ICMP6 as u32);
    var i: u16 = 0u16;
    while i < icmp_len {
        const hi: u16 = icmp[i as usize] as u16;
        var lo: u16 = 0u16;
        if (i + 1u16) < icmp_len {
            lo = icmp[(i + 1u16) as usize] as u16;
        }
        sum = sum + (((hi << 8) | lo) as u32);
        i = i + 2u16;
    }
    while (sum >> 16) != 0u32 {
        sum = (sum & 0xffffu32) + (sum >> 16);
    }
    return (~(sum as u16));
}

export fn uip_const_llh_len() i32 { return 14; }
export fn uip_const_iph_len() i32 { return 20; }
export fn uip_const_bufsize() i32 { return 400; }
export fn uip_const_tcpip_hlen() i32 { return 40; }
export fn uip_const_udph_len() i32 { return 8; }
export fn uip_const_tcph_len() i32 { return 20; }
export fn uip_const_ipudph_len() i32 { return 28; }
export fn uip_const_iptcph_len() i32 { return 40; }
export fn uip_const_rto() i32 { return 3; }
export fn uip_const_ttl() i32 { return 64; }
export fn uip_const_tcp_mss() i32 { return 346; }
export fn uip_const_receive_window() i32 { return 346; }
export fn uip_const_conns() i32 { return 10; }
export fn uip_const_listenports() i32 { return 20; }
export fn uip_const_byte_order() i32 { return 3412; }
export fn uip_const_ackdata() i32 { return 1; }
export fn uip_const_newdata() i32 { return 2; }
export fn uip_const_rexmit() i32 { return 4; }
export fn uip_const_poll() i32 { return 8; }
export fn uip_const_close() i32 { return 16; }
export fn uip_const_abort() i32 { return 32; }
export fn uip_const_connected() i32 { return 64; }
export fn uip_const_timedout() i32 { return 128; }
export fn uip_const_closed() i32 { return 0; }
export fn uip_const_established() i32 { return 3; }
export fn uip_const_time_wait() i32 { return 7; }
export fn uip_const_stopped() i32 { return 16; }



export struct UipRuntime { frame: UipFrame, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, appdata: &byte, sappdata: &byte, urgdata: &byte, len: u16, slen: u16, urglen: u16, surglen: u16, flags: byte, current_conn: i32, current_udp_conn: i32, acc32: [byte: 4], ipid: u16, iss: [byte: 4], logcode: byte, logparam: u16, stats: &UipStats, te_reply: bool }
// Canonical transport/process implementation for the project lives in this file.
export struct UipConn { ripaddr: UipIpAddr, lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
export struct UipUdpConn { ripaddr: UipIpAddr, lport: u16, rport: u16, ttl: byte, appstate: u16 }
export struct UipState { listenports: [u16: 20], conns: [UipConn: 10], udp_conns: [UipUdpConn: 10], acc32: [byte: 4], flags: byte, len: u16, lastport: u16 }
export struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }
export struct UipReassState { buf: [byte: 386], bitmap: [byte: 6], len: u16, flags: byte, timer: byte, srcipaddr: [u16: 2], destipaddr: [u16: 2], ipid: [byte: 2], proto: byte }

export fn uip_add32(op32: &byte, op16: u16, out_acc32: &byte) void {
    out_acc32[3] = (((op32[3] as u16) + (op16 & 255u16)) as! byte).value;
    out_acc32[2] = (((op32[2] as u16) + (op16 >> 8)) as! byte).value;
    out_acc32[1] = op32[1];
    out_acc32[0] = op32[0];
    if (out_acc32[2] as u16) < (op16 >> 8) {
        out_acc32[1] = (((out_acc32[1] as i32) + 1) as! byte).value;
        if out_acc32[1] == 0 as byte {
            out_acc32[0] = (((out_acc32[0] as i32) + 1) as! byte).value;
        }
    }
    if (out_acc32[3] as u16) < (op16 & 255u16) {
        out_acc32[2] = (((out_acc32[2] as i32) + 1) as! byte).value;
        if out_acc32[2] == 0 as byte {
            out_acc32[1] = (((out_acc32[1] as i32) + 1) as! byte).value;
            if out_acc32[1] == 0 as byte {
                out_acc32[0] = (((out_acc32[0] as i32) + 1) as! byte).value;
            }
        }
    }
}

fn chksum(sum0: u16, data: &byte, len: u16) u16 {
    var sum: u16 = sum0;
    var index: u16 = 0u16;
    while index + 1u16 < len {
        const t: u16 = ((data[index as usize] as u16) << 8) + (data[(index + 1u16) as usize] as u16);
        const next: u16 = sum + t;
        sum = next;
        if sum < t {
            sum = sum + 1u16;
        }
        index = index + 2u16;
    }
    if index < len {
        const t: u16 = (data[index as usize] as u16) << 8;
        const next: u16 = sum + t;
        sum = next;
        if sum < t {
            sum = sum + 1u16;
        }
    }
    return sum;
}

export fn uip_chksum(data: &byte, len: u16) u16 { return htons(chksum(0u16, data, len)); }
export fn uip_ipchksum(buf: &byte) u16 {
    const sum: u16 = chksum(0u16, @ptr_from_usize(@usize_from_ptr(buf as &void) + 14usize) as &byte, 20u16);
    if sum == 0u16 { return 65535u16; }
    return htons(sum);
}
fn upper_layer_len_ipv4(buf: &byte) u16 {
    const base: usize = @usize_from_ptr(buf as &void) + 14usize;
    const lenp: &byte = @ptr_from_usize(base + 2usize) as &byte;
    return (((lenp[0] as u16) << 8) + (lenp[1] as u16)) - 20u16;
}
export fn uip_upper_layer_chksum(buf: &byte, proto: byte) u16 {
    const p: usize = @usize_from_ptr(buf as &void) + 14usize;
    const hdr: &UipTcpipHdr = @ptr_from_usize(p) as &UipTcpipHdr;
    const upper_layer_len: u16 = upper_layer_len_ipv4(buf);
    var sum: u16 = upper_layer_len + (proto as u16);
    sum = chksum(sum, @ptr_from_usize(@usize_from_ptr(&hdr.srcipaddr[0] as &void)) as &byte, 8u16);
    sum = chksum(sum, @ptr_from_usize(@usize_from_ptr(buf as &void) + 34usize) as &byte, upper_layer_len);
    if sum == 0u16 { return 65535u16; }
    return htons(sum);
}
export fn uip_tcpchksum(buf: &byte) u16 { return uip_upper_layer_chksum(buf, (UIP_PROTO_TCP as! byte).value); }
export fn uip_udpchksum(buf: &byte) u16 { return uip_upper_layer_chksum(buf, (UIP_PROTO_UDP as! byte).value); }

export fn uiplib_ipaddrconv(addrstr: &const byte, ipaddr: &byte) byte {
    var part: u16 = 0u16;
    var dots: byte = 0 as byte;
    var i: usize = 0usize;
    while true {
        const c: byte = addrstr[i];
        if c >= (48 as byte) && c <= (57 as byte) {
            part = (part * 10u16) + ((c - (48 as byte)) as u16);
            if part > 255u16 { return 0 as byte; }
        } else if c == (46 as byte) || c == 0 as byte {
            if dots > (3 as byte) { return 0 as byte; }
            ipaddr[dots as usize] = (part as! byte).value;
            dots = dots + 1 as byte;
            part = 0u16;
            if c == 0 as byte { break; }
        } else {
            return 0 as byte;
        }
        i = i + 1usize;
    }
    if dots != (4 as byte) { return 0 as byte; }
    return 1 as byte;
}

export fn uip_init(state: &UipState) void {
    var i: usize = 0;
    while i < 20usize {
        state.listenports[i] = 0u16;
        i = i + 1usize;
    }
    i = 0usize;
    while i < 10usize {
        state.conns[i].tcpstateflags = (UIP_CLOSED as! byte).value;
        i = i + 1usize;
    }
    state.lastport = 1024u16;
    i = 0usize;
    while i < 10usize {
        state.udp_conns[i].lport = 0u16;
        i = i + 1usize;
    }
}

export fn uip_listen(state: &UipState, port: u16) void {
    var i: usize = 0usize;
    while i < 20usize {
        if state.listenports[i] == 0u16 {
            state.listenports[i] = port;
            return;
        }
        i = i + 1usize;
    }
}

export fn uip_unlisten(state: &UipState, port: u16) void {
    var i: usize = 0usize;
    while i < 20usize {
        if state.listenports[i] == port {
            state.listenports[i] = 0u16;
            return;
        }
        i = i + 1usize;
    }
}

export fn uip_conn_active(state: &UipState, conn: usize) bool {
    if conn == 0usize {
        return state.conns[0].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 1usize {
        return state.conns[1].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 2usize {
        return state.conns[2].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 3usize {
        return state.conns[3].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 4usize {
        return state.conns[4].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 5usize {
        return state.conns[5].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 6usize {
        return state.conns[6].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 7usize {
        return state.conns[7].tcpstateflags != (UIP_CLOSED as! byte).value;
    } else if conn == 8usize {
        return state.conns[8].tcpstateflags != (UIP_CLOSED as! byte).value;
    }
    return state.conns[9].tcpstateflags != (UIP_CLOSED as! byte).value;
}

export fn uip_outstanding(conn: &UipConn) u16 { return conn.len; }
export fn uip_udp_remove(conn: &UipUdpConn) void { conn.lport = 0u16; }
export fn uip_udp_bind(conn: &UipUdpConn, port: u16) void { conn.lport = port; }

export fn uip_connect(state: &UipState, ripaddr: &UipIpAddr, rport: u16, iss0: byte, iss1: byte, iss2: byte, iss3: byte, out_index: &i32) bool {
    while true {
        state.lastport = state.lastport + 1u16;
        if state.lastport >= 32000u16 {
            state.lastport = 4096u16;
        }
        var in_use: bool = false;
        var i: usize = 0usize;
        while i < 10usize {
            if state.conns[i].tcpstateflags != (UIP_CLOSED as! byte).value && state.conns[i].lport == htons(state.lastport) {
                in_use = true;
                break;
            }
            i = i + 1usize;
        }
        if in_use {
            continue;
        }
        var best_index: i32 = -1;
        var best_timer: byte = 0 as byte;
        i = 0usize;
        while i < 10usize {
            if state.conns[i].tcpstateflags == (UIP_CLOSED as! byte).value {
                best_index = (i as! i32).value;
                break;
            }
            if state.conns[i].tcpstateflags == (UIP_TIME_WAIT as! byte).value {
                if best_index < 0 || state.conns[i].timer > best_timer {
                    best_index = (i as! i32).value;
                    best_timer = state.conns[i].timer;
                }
            }
            i = i + 1usize;
        }
        if best_index < 0 {
            return false;
        }
        if best_index == 0 {
            state.conns[0].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[0].snd_nxt[0] = iss0;
            state.conns[0].snd_nxt[1] = iss1;
            state.conns[0].snd_nxt[2] = iss2;
            state.conns[0].snd_nxt[3] = iss3;
            state.conns[0].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[0].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[0].len = 1u16;
            state.conns[0].nrtx = 0 as byte;
            state.conns[0].timer = 1 as byte;
            state.conns[0].rto = 3 as byte;
            state.conns[0].sa = 0 as byte;
            state.conns[0].sv = 16 as byte;
            state.conns[0].lport = htons(state.lastport);
            state.conns[0].rport = rport;
            uip_ipaddr_copy(&state.conns[0].ripaddr, ripaddr);
        } else if best_index == 1 {
            state.conns[1].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[1].snd_nxt[0] = iss0;
            state.conns[1].snd_nxt[1] = iss1;
            state.conns[1].snd_nxt[2] = iss2;
            state.conns[1].snd_nxt[3] = iss3;
            state.conns[1].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[1].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[1].len = 1u16;
            state.conns[1].nrtx = 0 as byte;
            state.conns[1].timer = 1 as byte;
            state.conns[1].rto = 3 as byte;
            state.conns[1].sa = 0 as byte;
            state.conns[1].sv = 16 as byte;
            state.conns[1].lport = htons(state.lastport);
