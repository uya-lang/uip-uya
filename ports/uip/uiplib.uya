            state.conns[1].sv = 16 as byte;
            state.conns[1].lport = htons(state.lastport);
            state.conns[1].rport = rport;
            uip_ipaddr_copy(&state.conns[1].ripaddr, ripaddr);
        } else if best_index == 2 {
            state.conns[2].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[2].snd_nxt[0] = iss0;
            state.conns[2].snd_nxt[1] = iss1;
            state.conns[2].snd_nxt[2] = iss2;
            state.conns[2].snd_nxt[3] = iss3;
            state.conns[2].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[2].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[2].len = 1u16;
            state.conns[2].nrtx = 0 as byte;
            state.conns[2].timer = 1 as byte;
            state.conns[2].rto = (UIP_RTO as! byte).value;
            state.conns[2].sa = 0 as byte;
            state.conns[2].sv = 16 as byte;
            state.conns[2].lport = htons(state.lastport);
            state.conns[2].rport = rport;
            uip_ipaddr_copy(&state.conns[2].ripaddr, ripaddr);
        } else if best_index == 3 {
            state.conns[3].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[3].snd_nxt[0] = iss0;
            state.conns[3].snd_nxt[1] = iss1;
            state.conns[3].snd_nxt[2] = iss2;
            state.conns[3].snd_nxt[3] = iss3;
            state.conns[3].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[3].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[3].len = 1u16;
            state.conns[3].nrtx = 0 as byte;
            state.conns[3].timer = 1 as byte;
            state.conns[3].rto = (UIP_RTO as! byte).value;
            state.conns[3].sa = 0 as byte;
            state.conns[3].sv = 16 as byte;
            state.conns[3].lport = htons(state.lastport);
            state.conns[3].rport = rport;
            uip_ipaddr_copy(&state.conns[3].ripaddr, ripaddr);
        } else if best_index == 4 {
            state.conns[4].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[4].snd_nxt[0] = iss0;
            state.conns[4].snd_nxt[1] = iss1;
            state.conns[4].snd_nxt[2] = iss2;
            state.conns[4].snd_nxt[3] = iss3;
            state.conns[4].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[4].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[4].len = 1u16;
            state.conns[4].nrtx = 0 as byte;
            state.conns[4].timer = 1 as byte;
            state.conns[4].rto = (UIP_RTO as! byte).value;
            state.conns[4].sa = 0 as byte;
            state.conns[4].sv = 16 as byte;
            state.conns[4].lport = htons(state.lastport);
            state.conns[4].rport = rport;
            uip_ipaddr_copy(&state.conns[4].ripaddr, ripaddr);
        } else if best_index == 5 {
            state.conns[5].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[5].snd_nxt[0] = iss0;
            state.conns[5].snd_nxt[1] = iss1;
            state.conns[5].snd_nxt[2] = iss2;
            state.conns[5].snd_nxt[3] = iss3;
            state.conns[5].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[5].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[5].len = 1u16;
            state.conns[5].nrtx = 0 as byte;
            state.conns[5].timer = 1 as byte;
            state.conns[5].rto = (UIP_RTO as! byte).value;
            state.conns[5].sa = 0 as byte;
            state.conns[5].sv = 16 as byte;
            state.conns[5].lport = htons(state.lastport);
            state.conns[5].rport = rport;
            uip_ipaddr_copy(&state.conns[5].ripaddr, ripaddr);
        } else if best_index == 6 {
            state.conns[6].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[6].snd_nxt[0] = iss0;
            state.conns[6].snd_nxt[1] = iss1;
            state.conns[6].snd_nxt[2] = iss2;
            state.conns[6].snd_nxt[3] = iss3;
            state.conns[6].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[6].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[6].len = 1u16;
            state.conns[6].nrtx = 0 as byte;
            state.conns[6].timer = 1 as byte;
            state.conns[6].rto = (UIP_RTO as! byte).value;
            state.conns[6].sa = 0 as byte;
            state.conns[6].sv = 16 as byte;
            state.conns[6].lport = htons(state.lastport);
            state.conns[6].rport = rport;
            uip_ipaddr_copy(&state.conns[6].ripaddr, ripaddr);
        } else if best_index == 7 {
            state.conns[7].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[7].snd_nxt[0] = iss0;
            state.conns[7].snd_nxt[1] = iss1;
            state.conns[7].snd_nxt[2] = iss2;
            state.conns[7].snd_nxt[3] = iss3;
            state.conns[7].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[7].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[7].len = 1u16;
            state.conns[7].nrtx = 0 as byte;
            state.conns[7].timer = 1 as byte;
            state.conns[7].rto = (UIP_RTO as! byte).value;
            state.conns[7].sa = 0 as byte;
            state.conns[7].sv = 16 as byte;
            state.conns[7].lport = htons(state.lastport);
            state.conns[7].rport = rport;
            uip_ipaddr_copy(&state.conns[7].ripaddr, ripaddr);
        } else if best_index == 8 {
            state.conns[8].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[8].snd_nxt[0] = iss0;
            state.conns[8].snd_nxt[1] = iss1;
            state.conns[8].snd_nxt[2] = iss2;
            state.conns[8].snd_nxt[3] = iss3;
            state.conns[8].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[8].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[8].len = 1u16;
            state.conns[8].nrtx = 0 as byte;
            state.conns[8].timer = 1 as byte;
            state.conns[8].rto = (UIP_RTO as! byte).value;
            state.conns[8].sa = 0 as byte;
            state.conns[8].sv = 16 as byte;
            state.conns[8].lport = htons(state.lastport);
            state.conns[8].rport = rport;
            uip_ipaddr_copy(&state.conns[8].ripaddr, ripaddr);
        } else {
            state.conns[9].tcpstateflags = (UIP_SYN_SENT as! byte).value;
            state.conns[9].snd_nxt[0] = iss0;
            state.conns[9].snd_nxt[1] = iss1;
            state.conns[9].snd_nxt[2] = iss2;
            state.conns[9].snd_nxt[3] = iss3;
            state.conns[9].initialmss = (UIP_TCP_MSS as! u16).value;
            state.conns[9].mss = (UIP_TCP_MSS as! u16).value;
            state.conns[9].len = 1u16;
            state.conns[9].nrtx = 0 as byte;
            state.conns[9].timer = 1 as byte;
            state.conns[9].rto = (UIP_RTO as! byte).value;
            state.conns[9].sa = 0 as byte;
            state.conns[9].sv = 16 as byte;
            state.conns[9].lport = htons(state.lastport);
            state.conns[9].rport = rport;
            uip_ipaddr_copy(&state.conns[9].ripaddr, ripaddr);
        }
        out_index[0] = best_index;
        return true;
    }
}

export fn uip_udp_new(state: &UipState, ripaddr: &UipIpAddr, rport: u16, out_index: &i32) bool {
    while true {
        state.lastport = state.lastport + 1u16;
        if state.lastport >= 32000u16 {
            state.lastport = 4096u16;
        }

        var in_use: bool = false;
        var i: usize = 0;
        while i < 10 {
            if state.udp_conns[i].lport == htons(state.lastport) {
                in_use = true;
                break;
            }
            i = i + 1;
        }
        if in_use {
            continue;
        }

        i = 0;
        while i < 10 {
            if state.udp_conns[i].lport == 0u16 {
                state.udp_conns[i].lport = htons(state.lastport);
                state.udp_conns[i].rport = rport;
                uip_ipaddr_copy(&state.udp_conns[i].ripaddr, ripaddr);
                state.udp_conns[i].ttl = (UIP_TTL as! byte).value;
                out_index[0] = (i as! i32).value;
                return true;
            }
            i = i + 1;
        }

        return false;
    }
}

export fn uip_arp_init(state: &UipArpState) void {
    var i: usize = 0;
    while i < 8 {
        state.table[i].ipaddr[0] = 0u16;
        state.table[i].ipaddr[1] = 0u16;
        state.table[i].time = 0 as byte;
        i = i + 1;
    }
    state.arptime = 0 as byte;
}

export fn uip_arp_timer(state: &UipArpState) void {
    state.arptime = (((state.arptime as i32) + 1) as! byte).value;
    var i: usize = 0;
    while i < 8 {
        if (state.table[i].ipaddr[0] | state.table[i].ipaddr[1]) != 0u16 {
            const age: byte = (((state.arptime as i32) - (state.table[i].time as i32)) as! byte).value;
            if age >= (UIP_ARP_MAXAGE as! byte).value {
                state.table[i].ipaddr[0] = 0u16;
                state.table[i].ipaddr[1] = 0u16;
            }
        }
        i = i + 1;
    }
}

export fn uip_arp_update(state: &UipArpState, ipaddr: &u16, ethaddr: &UipEthAddr) void {
    var i: usize = 0;
    while i < 8 {
        if state.table[i].ipaddr[0] != 0u16 && state.table[i].ipaddr[1] != 0u16 {
            if arp_ipaddr_cmp_words(&state.table[i].ipaddr[0], &ipaddr[0]) {
                arp_copy_ethaddr(&state.table[i].ethaddr, ethaddr);
                state.table[i].time = state.arptime;
                return;
            }
        }
        i = i + 1;
    }

    i = 0;
    while i < 8 {
        if state.table[i].ipaddr[0] == 0u16 && state.table[i].ipaddr[1] == 0u16 {
            arp_copy_ipaddr_words(&state.table[i].ipaddr[0], ipaddr);
            arp_copy_ethaddr(&state.table[i].ethaddr, ethaddr);
            state.table[i].time = state.arptime;
            return;
        }
        i = i + 1;
    }

    var best: usize = 0usize;
    var tmpage: byte = 0 as byte;
    i = 0;
    while i < 8 {
        const age: byte = (((state.arptime as i32) - (state.table[i].time as i32)) as! byte).value;
        if age > tmpage {
            tmpage = age;
            best = i;
        }
        i = i + 1;
    }
    arp_copy_ipaddr_words(&state.table[best].ipaddr[0], ipaddr);
    arp_copy_ethaddr(&state.table[best].ethaddr, ethaddr);
    state.table[best].time = state.arptime;
}

export fn uip_arp_arpin(state: &UipArpState, buf: &ArpHdr, len: &u16) void {
    if *len < (@size_of(ArpHdr) as u16) {
        *len = 0u16;
        return;
    }
    *len = 0u16;

    if buf.opcode == htons(ARP_REQUEST as u16) {
        if arp_ipaddr_cmp_words(&buf.dipaddr[0], &state.hostaddr.words[0]) {
            uip_arp_update(state, &buf.sipaddr[0], &buf.shwaddr);
            buf.opcode = htons(ARP_REPLY as u16);
            arp_copy_ethaddr(&buf.dhwaddr, &buf.shwaddr);
            arp_copy_ethaddr(&buf.shwaddr, &state.ethaddr);
            arp_copy_ethaddr(&buf.ethhdr.src, &state.ethaddr);
            arp_copy_ethaddr(&buf.ethhdr.dest, &buf.dhwaddr);
            buf.dipaddr[0] = buf.sipaddr[0];
            buf.dipaddr[1] = buf.sipaddr[1];
            buf.sipaddr[0] = state.hostaddr.words[0];
            buf.sipaddr[1] = state.hostaddr.words[1];
            buf.ethhdr.type = htons(UIP_ETHTYPE_ARP as u16);
            *len = (@size_of(ArpHdr) as! u16).value;
        }
        return;
    }

    if buf.opcode == htons(ARP_REPLY as u16) {
        if arp_ipaddr_cmp_words(&buf.dipaddr[0], &state.hostaddr.words[0]) {
            uip_arp_update(state, &buf.sipaddr[0], &buf.shwaddr);
        }
    }
}

export fn uip_arp_out(state: &UipArpState, frame: &UipFrame, len: &u16) void {
    var target0: u16 = 0u16;
    var target1: u16 = 0u16;

    if frame.ethip.destipaddr[0] == 65535u16 && frame.ethip.destipaddr[1] == 65535u16 {
        frame.ethip.ethhdr.dest.addr[0] = 255 as byte;
        frame.ethip.ethhdr.dest.addr[1] = 255 as byte;
        frame.ethip.ethhdr.dest.addr[2] = 255 as byte;
        frame.ethip.ethhdr.dest.addr[3] = 255 as byte;
        frame.ethip.ethhdr.dest.addr[4] = 255 as byte;
        frame.ethip.ethhdr.dest.addr[5] = 255 as byte;
        arp_copy_ethaddr(&frame.ethip.ethhdr.src, &state.ethaddr);
        frame.ethip.ethhdr.type = htons(UIP_ETHTYPE_IP as u16);
        *len = *len + (@size_of(UipEthHdr) as! u16).value;
        return;
    }

    if !uip_ipaddr_maskcmp(&UipIpAddr { words: [frame.ethip.destipaddr[0], frame.ethip.destipaddr[1]] }, &state.hostaddr, &state.netmask) {
        target0 = state.draddr.words[0];
        target1 = state.draddr.words[1];
    } else {
        target0 = frame.ethip.destipaddr[0];
        target1 = frame.ethip.destipaddr[1];
    }

    var i: usize = 0;
    while i < 8 {
        if state.table[i].ipaddr[0] == target0 && state.table[i].ipaddr[1] == target1 {
            arp_copy_ethaddr(&frame.ethip.ethhdr.dest, &state.table[i].ethaddr);
            arp_copy_ethaddr(&frame.ethip.ethhdr.src, &state.ethaddr);
            frame.ethip.ethhdr.type = htons(UIP_ETHTYPE_IP as u16);
            *len = *len + (@size_of(UipEthHdr) as! u16).value;
            return;
        }
        i = i + 1;
    }

    frame.arp.ethhdr.dest.addr[0] = 255 as byte;
    frame.arp.ethhdr.dest.addr[1] = 255 as byte;
    frame.arp.ethhdr.dest.addr[2] = 255 as byte;
    frame.arp.ethhdr.dest.addr[3] = 255 as byte;
    frame.arp.ethhdr.dest.addr[4] = 255 as byte;
    frame.arp.ethhdr.dest.addr[5] = 255 as byte;
    arp_copy_ethaddr(&frame.arp.ethhdr.src, &state.ethaddr);
    frame.arp.ethhdr.type = htons(UIP_ETHTYPE_ARP as u16);
    frame.arp.hwtype = htons(ARP_HWTYPE_ETH as u16);
    frame.arp.protocol = htons(UIP_ETHTYPE_IP as u16);
    frame.arp.hwlen = 6 as byte;
    frame.arp.protolen = 4 as byte;
    frame.arp.opcode = htons(ARP_REQUEST as u16);
    arp_copy_ethaddr(&frame.arp.shwaddr, &state.ethaddr);
    frame.arp.sipaddr[0] = frame.ethip.srcipaddr[0];
    frame.arp.sipaddr[1] = frame.ethip.srcipaddr[1];
    frame.arp.dhwaddr.addr[0] = 0 as byte;
    frame.arp.dhwaddr.addr[1] = 0 as byte;
    frame.arp.dhwaddr.addr[2] = 0 as byte;
    frame.arp.dhwaddr.addr[3] = 0 as byte;
    frame.arp.dhwaddr.addr[4] = 0 as byte;
    frame.arp.dhwaddr.addr[5] = 0 as byte;
    frame.arp.dipaddr[0] = target0;
    frame.arp.dipaddr[1] = target1;
    *len = (@size_of(ArpHdr) as! u16).value;
}

export fn tcp_fin_wait_2_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if !has_fin || conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        uip_add32(&state.conns[0].rcv_nxt[0], (incoming_len + 1u16), &rt.acc32[0]);
        state.conns[0].rcv_nxt[0] = rt.acc32[0];
        state.conns[0].rcv_nxt[1] = rt.acc32[1];
        state.conns[0].rcv_nxt[2] = rt.acc32[2];
        state.conns[0].rcv_nxt[3] = rt.acc32[3];
        state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
        state.conns[0].timer = 0 as byte;
        result.flags = (UIP_CLOSE as! byte).value;
        if incoming_len > 0u16 {
            result.flags = result.flags | (UIP_NEWDATA as! byte).value;
        }
        result.appcall = true;
        return result;
    }
    if conn_index == 1 {
        uip_add32(&state.conns[1].rcv_nxt[0], (incoming_len + 1u16), &rt.acc32[0]);
        state.conns[1].rcv_nxt[0] = rt.acc32[0];
        state.conns[1].rcv_nxt[1] = rt.acc32[1];
        state.conns[1].rcv_nxt[2] = rt.acc32[2];
        state.conns[1].rcv_nxt[3] = rt.acc32[3];
        state.conns[1].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
        state.conns[1].timer = 0 as byte;
        result.flags = (UIP_CLOSE as! byte).value;
        if incoming_len > 0u16 {
            result.flags = result.flags | (UIP_NEWDATA as! byte).value;
        }
        result.appcall = true;
        return result;
    }
    return result;
}

export fn udp_matches_conn(conn: &UipUdpConn, frame: &UipUdpipHdr) bool {
    if conn.lport != frame.destport {
        return false;
    }
    if conn.rport != 0u16 && conn.rport != frame.srcport {
        return false;
    }
    if conn.ripaddr.words[0] != 0u16 || conn.ripaddr.words[1] != 0u16 {
        if conn.ripaddr.words[0] != frame.srcipaddr[0] || conn.ripaddr.words[1] != frame.srcipaddr[1] {
            return false;
        }
    }
    return true;
}

export fn udp_find_conn(state: &UipState, frame: &UipUdpipHdr) i32 {
    var i: usize = 0;
    while i < 10 {
        if udp_matches_conn(&state.udp_conns[i], frame) {
            return (i as! i32).value;
        }
        i = i + 1;
    }
    return -1;
}

export fn udp_input_step(state: &UipState, rt: &UipRuntime, frame: &UipUdpipHdr, payload_len: u16) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    const idx: i32 = udp_find_conn(state, frame);
    if idx < 0 {
        rt.current_udp_conn = -1;
        rt.len = 0u16;
        return result;
    }
    rt.current_conn = -1;
    rt.current_udp_conn = idx;
    rt.len = payload_len;
    rt.slen = 0u16;
    rt.appdata = @ptr_from_usize(@usize_from_ptr(&rt.frame.ethip as &void) + ((UIP_LLH_LEN + UIP_IPUDPH_LEN) as usize)) as &byte;
    rt.sappdata = rt.appdata;
    result.flags = (UIP_NEWDATA as! byte).value;
    result.appcall = true;
    return result;
}

export fn udp_send_step(state: &UipState, rt: &UipRuntime, conn_index: i32, payload_len: u16) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        rt.frame.ethudp.srcport = state.udp_conns[0].lport;
        rt.frame.ethudp.destport = state.udp_conns[0].rport;
        rt.frame.ethudp.srcipaddr[0] = rt.hostaddr.words[0];
        rt.frame.ethudp.srcipaddr[1] = rt.hostaddr.words[1];
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[0].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[0].ripaddr.words[1];
        const total: u16 = payload_len + (UIP_UDPH_LEN as! u16).value;
        rt.frame.ethudp.udplen = htons(total);
        rt.len = total + (UIP_IPH_LEN as! u16).value;
        rt.current_udp_conn = 0;
        result.len = rt.len;
        result.appcall = true;
        return result;
    }
    if conn_index == 1 {
        rt.frame.ethudp.srcport = state.udp_conns[1].lport;
        rt.frame.ethudp.destport = state.udp_conns[1].rport;
        rt.frame.ethudp.srcipaddr[0] = rt.hostaddr.words[0];
        rt.frame.ethudp.srcipaddr[1] = rt.hostaddr.words[1];
        rt.frame.ethudp.destipaddr[0] = state.udp_conns[1].ripaddr.words[0];
        rt.frame.ethudp.destipaddr[1] = state.udp_conns[1].ripaddr.words[1];
        const total: u16 = payload_len + (UIP_UDPH_LEN as! u16).value;
        rt.frame.ethudp.udplen = htons(total);
        rt.len = total + (UIP_IPH_LEN as! u16).value;
        rt.current_udp_conn = 1;
        result.len = rt.len;
        result.appcall = true;
        return result;
    }
    return result;
}

export fn tcp_build_ack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool {
    if conn_index < 0 || conn_index >= 10 {
        return false;
    }
    if conn_index == 0 {
        out.srcport = state.conns[0].lport;
        out.destport = state.conns[0].rport;
        out.srcipaddr[0] = rt.hostaddr.words[0];
        out.srcipaddr[1] = rt.hostaddr.words[1];
        out.destipaddr[0] = state.conns[0].ripaddr.words[0];
        out.destipaddr[1] = state.conns[0].ripaddr.words[1];
        out.seqno[0] = state.conns[0].snd_nxt[0];
        out.seqno[1] = state.conns[0].snd_nxt[1];
        out.seqno[2] = state.conns[0].snd_nxt[2];
        out.seqno[3] = state.conns[0].snd_nxt[3];
        out.ackno[0] = state.conns[0].rcv_nxt[0];
        out.ackno[1] = state.conns[0].rcv_nxt[1];
        out.ackno[2] = state.conns[0].rcv_nxt[2];
        out.ackno[3] = state.conns[0].rcv_nxt[3];
        out.flags = (TCP_ACK as! byte).value;
        out.tcpoffset = 0x50 as byte;
        return true;
    }
    if conn_index == 1 {
        out.srcport = state.conns[1].lport;
        out.destport = state.conns[1].rport;
        out.srcipaddr[0] = rt.hostaddr.words[0];
        out.srcipaddr[1] = rt.hostaddr.words[1];
        out.destipaddr[0] = state.conns[1].ripaddr.words[0];
        out.destipaddr[1] = state.conns[1].ripaddr.words[1];
        out.seqno[0] = state.conns[1].snd_nxt[0];
        out.seqno[1] = state.conns[1].snd_nxt[1];
        out.seqno[2] = state.conns[1].snd_nxt[2];
        out.seqno[3] = state.conns[1].snd_nxt[3];
        out.ackno[0] = state.conns[1].rcv_nxt[0];
        out.ackno[1] = state.conns[1].rcv_nxt[1];
        out.ackno[2] = state.conns[1].rcv_nxt[2];
        out.ackno[3] = state.conns[1].rcv_nxt[3];
        out.flags = (TCP_ACK as! byte).value;
        out.tcpoffset = 0x50 as byte;
        return true;
    }
    return false;
}

export fn tcp_build_synack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool {
    if !tcp_build_ack(state, rt, conn_index, out) {
        return false;
    }
    out.flags = ((TCP_SYN | TCP_ACK) as! byte).value;
    out.optdata[0] = (TCP_OPT_MSS as! byte).value;
    out.optdata[1] = (TCP_OPT_MSS_LEN as! byte).value;
    out.optdata[2] = (((UIP_TCP_MSS as! u16).value >> 8) as! byte).value;
    out.optdata[3] = (((UIP_TCP_MSS as! u16).value & 255u16) as! byte).value;
    out.tcpoffset = 0x60 as byte;
    return true;
}

export fn tcp_build_finack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool {
    if !tcp_build_ack(state, rt, conn_index, out) {
        return false;
    }
    out.flags = ((TCP_FIN | TCP_ACK) as! byte).value;
    return true;
}

export fn tcp_ack_only_step(state: &UipState, conn_index: i32, has_ack: bool, incoming_len: u16, has_fin: bool, has_rst: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if !has_ack || incoming_len != 0u16 || has_fin || has_rst {
        return result;
    }
    if conn_index == 0 {
        const ts: byte = state.conns[0].tcpstateflags & (UIP_TS_MASK as! byte).value;
        if ts == (UIP_ESTABLISHED as! byte).value || ts == (UIP_FIN_WAIT_2 as! byte).value || ts == (UIP_TIME_WAIT as! byte).value {
            result.flags = (UIP_ACKDATA as! byte).value;
        }
        return result;
    }
    if conn_index == 1 {
        const ts: byte = state.conns[1].tcpstateflags & (UIP_TS_MASK as! byte).value;
        if ts == (UIP_ESTABLISHED as! byte).value || ts == (UIP_FIN_WAIT_2 as! byte).value || ts == (UIP_TIME_WAIT as! byte).value {
            result.flags = (UIP_ACKDATA as! byte).value;
        }
        return result;
    }
    return result;
}

export fn tcp_stopped_step(state: &UipState, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (state.conns[0].tcpstateflags & (UIP_STOPPED as! byte).value) != 0 as byte {
            if incoming_len > 0u16 || has_fin {
                result.flags = (UIP_ACKDATA as! byte).value;
            }
        }
        return result;
    }
    if conn_index == 1 {
        if (state.conns[1].tcpstateflags & (UIP_STOPPED as! byte).value) != 0 as byte {
            if incoming_len > 0u16 || has_fin {
                result.flags = (UIP_ACKDATA as! byte).value;
            }
        }
        return result;
    }
    return result;
}

export fn tcp_rst_input_step(state: &UipState, conn_index: i32) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
        result.flags = (UIP_ABORT as! byte).value;
        result.appcall = true;
        result.closed = true;
        return result;
    }
    if conn_index == 1 {
        state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
        result.flags = (UIP_ABORT as! byte).value;
        result.appcall = true;
        result.closed = true;
        return result;
    }
    return result;
}

export fn tcp_build_rst_reply(frame: &UipFrame, out: &EthTcpHdr) void {
    out.destipaddr[0] = frame.ethtcp.srcipaddr[0];
    out.destipaddr[1] = frame.ethtcp.srcipaddr[1];
    out.srcipaddr[0] = frame.ethtcp.destipaddr[0];
    out.srcipaddr[1] = frame.ethtcp.destipaddr[1];
    out.destport = frame.ethtcp.srcport;
    out.srcport = frame.ethtcp.destport;
    out.ackno[0] = frame.ethtcp.seqno[0];
    out.ackno[1] = frame.ethtcp.seqno[1];
    out.ackno[2] = frame.ethtcp.seqno[2];
    out.ackno[3] = frame.ethtcp.seqno[3];
    var acc: [byte: 4] = [0 as byte, 0 as byte, 0 as byte, 0 as byte];
    uip_add32(&out.ackno[0], 1u16, &acc[0]);
    out.ackno[0] = acc[0];
    out.ackno[1] = acc[1];
    out.ackno[2] = acc[2];
    out.ackno[3] = acc[3];
    out.seqno[0] = 0 as byte;
    out.seqno[1] = 0 as byte;
    out.seqno[2] = 0 as byte;
    out.seqno[3] = 0 as byte;
    out.flags = ((TCP_RST | TCP_ACK) as! byte).value;
    out.tcpoffset = 0x50 as byte;
}

export fn tcp_should_accept_syn(state: &UipState, frame: &UipFrame) bool {
    var i: usize = 0;
    while i < 20 {
        if state.listenports[i] == frame.ethtcp.destport {
            return true;
        }
        i = i + 1;
    }
    return false;
}

export fn uip_process_tcp_core(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult {
    rt.urgdata = null;
    rt.urglen = 0u16;
    uip_runtime_clear_log(rt);
    var has_urg: bool = false;
    if incoming_len > 0u16 {
        has_urg = uip_tcp_prepare_urg(rt, incoming_len);
    }
    if conn_index >= 0 && conn_index < 10 && incoming_len > 0u16 {
        if conn_index == 0 {
            state.conns[0].appstate = state.conns[0].appstate + 1u16;
        } else if conn_index == 1 {
            state.conns[1].appstate = state.conns[1].appstate + 1u16;
        }
        uip_runtime_log(rt, (UIP_LOG_DATA as! byte).value, incoming_len);
    }
    if conn_index < 0 {
        if (rt.frame.ethtcp.flags & (TCP_RST as! byte).value) != 0 as byte {
            return UipProcessResult {
                flags: 0 as byte,
                len: 0u16,
                poll: false,
                timed_out: false,
                retransmit: false,
                appcall: false,
                closed: false,
                logged: rt.logcode != (UIP_LOG_NONE as! byte).value,
                urgdata: has_urg
            };
        }
        if (rt.frame.ethtcp.flags & (TCP_SYN as! byte).value) != 0 as byte && tcp_should_accept_syn(state, &rt.frame) {
            var accepted: i32 = -1;
            if uip_accept_syn(state, rt, &rt.frame, &accepted) {
                _ = tcp_build_synack(state, rt, accepted, &rt.frame.ethtcp);
                return UipProcessResult {
                    flags: 0 as byte,
                    len: 1u16,
                    poll: false,
                    timed_out: false,
                    retransmit: false,
                    appcall: false,
                    closed: false,
                    logged: rt.logcode != (UIP_LOG_NONE as! byte).value,
                    urgdata: has_urg
                };
            }
        }
        var rst: EthTcpHdr = rt.frame.ethtcp;
        tcp_build_rst_reply(&rt.frame, &rst);
        rt.frame.ethtcp = rst;
        uip_runtime_log(rt, (UIP_LOG_RST as! byte).value, 0u16);
        return UipProcessResult {
            flags: (UIP_ABORT as! byte).value,
            len: 1u16,
            poll: false,
            timed_out: false,
            retransmit: false,
            appcall: false,
            closed: false,
            logged: true,
            urgdata: has_urg
        };
    }
    if conn_index >= 10 {
        return UipProcessResult {
            flags: 0 as byte,
            len: 0u16,
            poll: false,
            timed_out: false,
            retransmit: false,
            appcall: false,
            closed: false
        };
    }

    if (rt.frame.ethtcp.flags & (TCP_RST as! byte).value) != 0 as byte {
        return tcp_rst_input_step(state, conn_index);
    }

    var ack_result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if has_ack {
        ack_result = tcp_ack_outstanding(state, rt, conn_index, &rt.frame);
        rt.flags = ack_result.flags;
        if conn_index == 0 {
            const ts_ack: byte = state.conns[0].tcpstateflags & (UIP_TS_MASK as! byte).value;
            if ts_ack == (UIP_LAST_ACK as! byte).value || ts_ack == (UIP_FIN_WAIT_1 as! byte).value || ts_ack == (UIP_CLOSING as! byte).value {
                const post_ack: UipProcessResult = tcp_post_ack_state_step(state, conn_index, true);
                if post_ack.closed || post_ack.flags != 0 as byte {
                    const ts_close: byte = state.conns[0].tcpstateflags & (UIP_TS_MASK as! byte).value;
                    if ts_close == (UIP_LAST_ACK as! byte).value || ts_close == (UIP_FIN_WAIT_1 as! byte).value || ts_close == (UIP_CLOSING as! byte).value {
                        _ = tcp_build_finack(state, rt, conn_index, &rt.frame.ethtcp);
                    } else {
                        _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                    }
                    return post_ack;
                }
            }
        } else if conn_index == 1 {
            const ts_ack: byte = state.conns[1].tcpstateflags & (UIP_TS_MASK as! byte).value;
            if ts_ack == (UIP_LAST_ACK as! byte).value || ts_ack == (UIP_FIN_WAIT_1 as! byte).value || ts_ack == (UIP_CLOSING as! byte).value {
                const post_ack: UipProcessResult = tcp_post_ack_state_step(state, conn_index, true);
                if post_ack.closed || post_ack.flags != 0 as byte {
                    const ts_close: byte = state.conns[1].tcpstateflags & (UIP_TS_MASK as! byte).value;
                    if ts_close == (UIP_LAST_ACK as! byte).value || ts_close == (UIP_FIN_WAIT_1 as! byte).value || ts_close == (UIP_CLOSING as! byte).value {
                        _ = tcp_build_finack(state, rt, conn_index, &rt.frame.ethtcp);
                    } else {
                        _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                    }
                    return post_ack;
                }
            }
        }
    }

    if conn_index == 0 {
        const ts: byte = state.conns[0].tcpstateflags & (UIP_TS_MASK as! byte).value;
        if ts == (UIP_SYN_SENT as! byte).value {
            const synsent: UipProcessResult = tcp_syn_sent_step(state, rt, conn_index, &rt.frame);
            if synsent.appcall || synsent.flags != 0 as byte {
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
            }
            return synsent;
        }
        if ts == (UIP_SYN_RCVD as! byte).value {
            const synrcvd: UipProcessResult = tcp_syn_rcvd_step(state, rt, conn_index, incoming_len, app_slen);
            if synrcvd.appcall || synrcvd.flags != 0 as byte {
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
            }
            return synrcvd;
        }
        if ts == (UIP_ESTABLISHED as! byte).value {
            const stopped: UipProcessResult = tcp_stopped_step(state, conn_index, incoming_len, has_fin);
            if stopped.flags != 0 as byte {
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                return stopped;
            }
            if has_fin {
                const finres: UipProcessResult = tcp_established_fin_step(state, rt, conn_index, incoming_len, true);
                _ = tcp_build_finack(state, rt, conn_index, &rt.frame.ethtcp);
                return finres;
            }
            if incoming_len > 0u16 {
                var datares: UipProcessResult = tcp_established_data_step(state, rt, conn_index, incoming_len, app_slen);
                datares.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
                datares.urgdata = has_urg;
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                return datares;
            }
            const ack_only: UipProcessResult = tcp_ack_only_step(state, conn_index, has_ack, incoming_len, has_fin, false);
            if ack_only.flags != 0 as byte && ack_result.flags == 0 as byte {
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                return ack_only;
            }
            if ack_result.flags != 0 as byte {
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
            }
            return ack_result;
        }
        if ts == (UIP_FIN_WAIT_2 as! byte).value {
            if has_fin {
                const fw2: UipProcessResult = tcp_fin_wait_2_step(state, rt, conn_index, incoming_len, has_fin);
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                return fw2;
            }
            const ack_only_fw2: UipProcessResult = tcp_ack_only_step(state, conn_index, has_ack, incoming_len, has_fin, false);
            if ack_only_fw2.flags != 0 as byte && ack_result.flags == 0 as byte {
                _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
                return ack_only_fw2;
            }
        }
        if ack_result.flags != 0 as byte {
            _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
        }
        return ack_result;
    }

    if ack_result.flags != 0 as byte {
        _ = tcp_build_ack(state, rt, conn_index, &rt.frame.ethtcp);
    }
    ack_result.logged = rt.logcode != (UIP_LOG_NONE as! byte).value;
    ack_result.urgdata = has_urg;
    return ack_result;
}

export fn uip_process_core(state: &UipState, rt: &UipRuntime, flag: i32, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult {
    if flag == UIP_TIMER {
        return uip_process_timer(state, rt, conn_index);
    }
    if flag == UIP_POLL_REQUEST {
        uip_prepare_poll(state, rt, conn_index);
        return UipProcessResult {
            flags: rt.flags,
            len: rt.len,
            poll: rt.flags == (UIP_POLL as! byte).value,
            timed_out: false,
            retransmit: false,
            appcall: false,
            closed: false,
            logged: rt.logcode != (UIP_LOG_NONE as! byte).value,
            urgdata: rt.urglen > 0u16
        };
    }
    if flag == UIP_UDP_TIMER {
        uip_prepare_udp_poll(rt, conn_index);
        return UipProcessResult {
            flags: rt.flags,
            len: rt.len,
            poll: rt.flags == (UIP_POLL as! byte).value,
            timed_out: false,
            retransmit: false,
            appcall: false,
            closed: false,
            logged: rt.logcode != (UIP_LOG_NONE as! byte).value,
            urgdata: rt.urglen > 0u16
        };
    }
    if flag == UIP_UDP_SEND_CONN {
        return udp_send_step(state, rt, conn_index, app_slen);
    }
    if flag == UIP_DATA && conn_index < 0 && rt.frame.ethudp.proto == (UIP_PROTO_UDP as! byte).value {
        return udp_input_step(state, rt, &rt.frame.ethudp as &UipUdpipHdr, incoming_len);
    }
    return uip_process_tcp_core(state, rt, conn_index, incoming_len, has_ack, has_fin, app_slen);
}

export fn tcp_established_data_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, app_slen: u16) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if incoming_len > 0u16 {
            uip_add32(&state.conns[0].rcv_nxt[0], incoming_len, &rt.acc32[0]);
            state.conns[0].rcv_nxt[0] = rt.acc32[0];
            state.conns[0].rcv_nxt[1] = rt.acc32[1];
            state.conns[0].rcv_nxt[2] = rt.acc32[2];
            state.conns[0].rcv_nxt[3] = rt.acc32[3];
            rt.slen = app_slen;
            result.appcall = true;
        }
        return result;
    }
    if conn_index == 1 {
        if incoming_len > 0u16 {
            uip_add32(&state.conns[1].rcv_nxt[0], incoming_len, &rt.acc32[0]);
            state.conns[1].rcv_nxt[0] = rt.acc32[0];
            state.conns[1].rcv_nxt[1] = rt.acc32[1];
            state.conns[1].rcv_nxt[2] = rt.acc32[2];
            state.conns[1].rcv_nxt[3] = rt.acc32[3];
            rt.slen = app_slen;
            result.appcall = true;
        }
        return result;
    }
    return result;
}

export fn tcp_close_step(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        state.conns[0].tcpstateflags = (UIP_FIN_WAIT_1 as! byte).value;
        state.conns[0].len = 1u16;
        state.conns[0].nrtx = 0 as byte;
        result.flags = (UIP_CLOSE as! byte).value;
        rt.slen = 0u16;
        result.appcall = true;
        return result;
    }
    if conn_index == 1 {
        state.conns[1].tcpstateflags = (UIP_FIN_WAIT_1 as! byte).value;
        state.conns[1].len = 1u16;
        state.conns[1].nrtx = 0 as byte;
        result.flags = (UIP_CLOSE as! byte).value;
        rt.slen = 0u16;
        result.appcall = true;
        return result;
    }
    return result;
}

export fn tcp_post_ack_state_step(state: &UipState, conn_index: i32, has_ack: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if !has_ack || conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        const ts: byte = state.conns[0].tcpstateflags & (UIP_TS_MASK as! byte).value;
        if ts == (UIP_LAST_ACK as! byte).value {
            state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
            result.closed = true;
        } else if ts == (UIP_FIN_WAIT_1 as! byte).value {
            state.conns[0].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value;
        } else if ts == (UIP_CLOSING as! byte).value {
            state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
            state.conns[0].timer = 0 as byte;
        }
        return result;
    }
    if conn_index == 1 {
        const ts: byte = state.conns[1].tcpstateflags & (UIP_TS_MASK as! byte).value;
        if ts == (UIP_LAST_ACK as! byte).value {
            state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
            result.closed = true;
        } else if ts == (UIP_FIN_WAIT_1 as! byte).value {
            state.conns[1].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value;
        } else if ts == (UIP_CLOSING as! byte).value {
            state.conns[1].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
            state.conns[1].timer = 0 as byte;
        }
        return result;
    }
    return result;
}

export fn tcp_syn_sent_step(state: &UipState, rt: &UipRuntime, conn_index: i32, frame: &UipFrame) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte &&
           (frame.ethtcp.flags & (TCP_CTL as! byte).value) == ((TCP_SYN | TCP_ACK) as! byte).value {
            state.conns[0].initialmss = tcp_parse_mss_option(&frame.ethtcp.optdata[0], (((frame.ethtcp.tcpoffset >> 4) - 5) << 2) as! u16 catch |_| { 0u16; });
            state.conns[0].mss = state.conns[0].initialmss;
            state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
            state.conns[0].rcv_nxt[0] = frame.ethtcp.seqno[0];
            state.conns[0].rcv_nxt[1] = frame.ethtcp.seqno[1];
            state.conns[0].rcv_nxt[2] = frame.ethtcp.seqno[2];
            state.conns[0].rcv_nxt[3] = frame.ethtcp.seqno[3];
            uip_add32(&state.conns[0].rcv_nxt[0], 1u16, &rt.acc32[0]);
            state.conns[0].rcv_nxt[0] = rt.acc32[0];
            state.conns[0].rcv_nxt[1] = rt.acc32[1];
            state.conns[0].rcv_nxt[2] = rt.acc32[2];
            state.conns[0].rcv_nxt[3] = rt.acc32[3];
            result.flags = (UIP_CONNECTED as! byte).value;
            state.conns[0].len = 0u16;
            rt.len = 0u16;
            rt.slen = 0u16;
            result.appcall = true;
            return result;
        }
        result.flags = (UIP_ABORT as! byte).value;
        result.appcall = true;
        state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
        result.closed = true;
        return result;
    }
    return result;
}

export fn tcp_established_fin_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if has_fin && (state.conns[0].tcpstateflags & (UIP_STOPPED as! byte).value) == 0 as byte {
            if uip_outstanding(&state.conns[0]) > 0u16 {
                return result;
            }
            uip_add32(&state.conns[0].rcv_nxt[0], (incoming_len + 1u16), &rt.acc32[0]);
            state.conns[0].rcv_nxt[0] = rt.acc32[0];
            state.conns[0].rcv_nxt[1] = rt.acc32[1];
            state.conns[0].rcv_nxt[2] = rt.acc32[2];
            state.conns[0].rcv_nxt[3] = rt.acc32[3];
            result.flags = (UIP_CLOSE as! byte).value;
            if incoming_len > 0u16 {
                result.flags = result.flags | (UIP_NEWDATA as! byte).value;
            }
            result.appcall = true;
            state.conns[0].len = 1u16;
            state.conns[0].tcpstateflags = (UIP_LAST_ACK as! byte).value;
            state.conns[0].nrtx = 0 as byte;
        }
        return result;
    }
    return result;
}

export fn tcp_ack_matches(conn: &UipConn, ackno: &byte, acc32: &byte) bool {
    uip_add32(&conn.snd_nxt[0], conn.len, acc32);
    return ackno[0] == acc32[0] && ackno[1] == acc32[1] && ackno[2] == acc32[2] && ackno[3] == acc32[3];
}

export fn tcp_ack_outstanding(state: &UipState, rt: &UipRuntime, conn_index: i32, frame: &UipFrame) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (frame.ethtcp.flags & (TCP_ACK as! byte).value) != 0 as byte && uip_outstanding(&state.conns[0]) > 0u16 {
            if tcp_ack_matches(&state.conns[0], &frame.ethtcp.ackno[0], &rt.acc32[0]) {
                state.conns[0].snd_nxt[0] = rt.acc32[0];
                state.conns[0].snd_nxt[1] = rt.acc32[1];
                state.conns[0].snd_nxt[2] = rt.acc32[2];
                state.conns[0].snd_nxt[3] = rt.acc32[3];
                if state.conns[0].nrtx == 0 as byte {
                    var m: i32 = (state.conns[0].rto as i32) - (state.conns[0].timer as i32);
                    m = m - ((state.conns[0].sa as i32) >> 3);
                    state.conns[0].sa = (((state.conns[0].sa as i32) + m) as! byte).value;
                    if m < 0 {
                        m = -m;
                    }
                    m = m - ((state.conns[0].sv as i32) >> 2);
                    state.conns[0].sv = (((state.conns[0].sv as i32) + m) as! byte).value;
                    state.conns[0].rto = ((((state.conns[0].sa as i32) >> 3) + (state.conns[0].sv as i32)) as! byte).value;
                }
                result.flags = (UIP_ACKDATA as! byte).value;
                state.conns[0].timer = state.conns[0].rto;
                state.conns[0].len = 0u16;
            }
        }
        return result;
    }
    if conn_index == 1 {
        if (frame.ethtcp.flags & (TCP_ACK as! byte).value) != 0 as byte && uip_outstanding(&state.conns[1]) > 0u16 {
            if tcp_ack_matches(&state.conns[1], &frame.ethtcp.ackno[0], &rt.acc32[0]) {
                state.conns[1].snd_nxt[0] = rt.acc32[0];
                state.conns[1].snd_nxt[1] = rt.acc32[1];
                state.conns[1].snd_nxt[2] = rt.acc32[2];
                state.conns[1].snd_nxt[3] = rt.acc32[3];
                if state.conns[1].nrtx == 0 as byte {
                    var m: i32 = (state.conns[1].rto as i32) - (state.conns[1].timer as i32);
                    m = m - ((state.conns[1].sa as i32) >> 3);
                    state.conns[1].sa = (((state.conns[1].sa as i32) + m) as! byte).value;
                    if m < 0 {
                        m = -m;
                    }
                    m = m - ((state.conns[1].sv as i32) >> 2);
                    state.conns[1].sv = (((state.conns[1].sv as i32) + m) as! byte).value;
                    state.conns[1].rto = ((((state.conns[1].sa as i32) >> 3) + (state.conns[1].sv as i32)) as! byte).value;
                }
                result.flags = (UIP_ACKDATA as! byte).value;
                state.conns[1].timer = state.conns[1].rto;
                state.conns[1].len = 0u16;
            }
        }
        return result;
    }
    return result;
}

export fn tcp_syn_rcvd_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, app_slen: u16) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index < 0 || conn_index >= 10 {
        return result;
    }
    if conn_index == 0 {
        if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte {
            state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
            result.flags = (UIP_CONNECTED as! byte).value;
            state.conns[0].len = 0u16;
            if incoming_len > 0u16 {
                result.flags = result.flags | (UIP_NEWDATA as! byte).value;
                uip_add32(&state.conns[0].rcv_nxt[0], incoming_len, &rt.acc32[0]);
                state.conns[0].rcv_nxt[0] = rt.acc32[0];
                state.conns[0].rcv_nxt[1] = rt.acc32[1];
                state.conns[0].rcv_nxt[2] = rt.acc32[2];
                state.conns[0].rcv_nxt[3] = rt.acc32[3];
            }
            rt.slen = app_slen;
            result.appcall = true;
        }
        return result;
    }
    if conn_index == 1 {
        if (rt.flags & (UIP_ACKDATA as! byte).value) != 0 as byte {
            state.conns[1].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
            result.flags = (UIP_CONNECTED as! byte).value;
            state.conns[1].len = 0u16;
            if incoming_len > 0u16 {
                result.flags = result.flags | (UIP_NEWDATA as! byte).value;
                uip_add32(&state.conns[1].rcv_nxt[0], incoming_len, &rt.acc32[0]);
                state.conns[1].rcv_nxt[0] = rt.acc32[0];
                state.conns[1].rcv_nxt[1] = rt.acc32[1];
                state.conns[1].rcv_nxt[2] = rt.acc32[2];
                state.conns[1].rcv_nxt[3] = rt.acc32[3];
            }
            rt.slen = app_slen;
            result.appcall = true;
        }
        return result;
    }
    return result;
}

export fn tcp_data_len(frame: &UipFrame, total_len: u16) u16 {
    const tcp_hdr_len: u16 = (((frame.ethtcp.tcpoffset >> 4) << 2) as! u16).value;
    return total_len - tcp_hdr_len - (UIP_IPH_LEN as! u16).value;
}

export fn tcp_seq_matches(conn: &UipConn, frame: &UipFrame, data_len: u16) bool {
    if ((conn.tcpstateflags & (UIP_TS_MASK as! byte).value) == (UIP_SYN_SENT as! byte).value) &&
       ((frame.ethtcp.flags & (TCP_CTL as! byte).value) == ((TCP_SYN | TCP_ACK) as! byte).value) {
        return true;
    }
    if data_len == 0u16 && (frame.ethtcp.flags & ((TCP_SYN | TCP_FIN) as! byte).value) == 0 as byte {
        return true;
    }
    return frame.ethtcp.seqno[0] == conn.rcv_nxt[0] &&
        frame.ethtcp.seqno[1] == conn.rcv_nxt[1] &&
        frame.ethtcp.seqno[2] == conn.rcv_nxt[2] &&
        frame.ethtcp.seqno[3] == conn.rcv_nxt[3];
}

export fn tcp_parse_mss_option(raw: &byte, options_len: u16) u16 {
    var c: u16 = 0u16;
    while c < options_len {
        const opt: byte = raw[c];
        if opt == (TCP_OPT_END as! byte).value {
            break;
        }
        if opt == (TCP_OPT_NOOP as! byte).value {
            c = c + 1u16;
        } else if opt == (TCP_OPT_MSS as! byte).value && c + 3u16 < options_len && raw[c + 1u16] == (TCP_OPT_MSS_LEN as! byte).value {
            const tmp16: u16 = ((raw[c + 2u16] as u16) << 8) | (raw[c + 3u16] as u16);
            if tmp16 > (UIP_TCP_MSS as! u16).value {
                return (UIP_TCP_MSS as! u16).value;
            }
            return tmp16;
        } else {
            if c + 1u16 >= options_len || raw[c + 1u16] == 0 as byte {
                break;
            }
            c = c + (raw[c + 1u16] as u16);
        }
    }
    return (UIP_TCP_MSS as! u16).value;
}

export fn uip_accept_syn(state: &UipState, rt: &UipRuntime, frame: &UipFrame, out_index: &i32) bool {
    var best_index: i32 = -1;
    var best_timer: byte = 0 as byte;
    var i: usize = 0;
    while i < 10 {
        if state.conns[i].tcpstateflags == (UIP_CLOSED as! byte).value {
            best_index = (i as! i32).value;
            break;
        }
        if state.conns[i].tcpstateflags == (UIP_TIME_WAIT as! byte).value {
            if best_index < 0 || state.conns[i].timer > best_timer {
                best_index = (i as! i32).value;
                best_timer = state.conns[i].timer;
            }
        }
        i = i + 1;
    }
    if best_index < 0 {
        return false;
    }

    const idx: i32 = best_index;
    if idx == 0 {
        state.conns[0].rto = (UIP_RTO as! byte).value;
        state.conns[0].timer = (UIP_RTO as! byte).value;
        state.conns[0].sa = 0 as byte;
        state.conns[0].sv = 4 as byte;
        state.conns[0].nrtx = 0 as byte;
        state.conns[0].lport = frame.ethtcp.destport;
        state.conns[0].rport = frame.ethtcp.srcport;
        state.conns[0].ripaddr.words[0] = frame.ethtcp.srcipaddr[0];
        state.conns[0].ripaddr.words[1] = frame.ethtcp.srcipaddr[1];
        state.conns[0].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
        state.conns[0].snd_nxt[0] = rt.iss[0];
        state.conns[0].snd_nxt[1] = rt.iss[1];
        state.conns[0].snd_nxt[2] = rt.iss[2];
        state.conns[0].snd_nxt[3] = rt.iss[3];
        state.conns[0].len = 1u16;
        state.conns[0].rcv_nxt[0] = frame.ethtcp.seqno[0];
        state.conns[0].rcv_nxt[1] = frame.ethtcp.seqno[1];
        state.conns[0].rcv_nxt[2] = frame.ethtcp.seqno[2];
        state.conns[0].rcv_nxt[3] = frame.ethtcp.seqno[3];
        uip_add32(&state.conns[0].rcv_nxt[0], 1u16, &rt.acc32[0]);
        state.conns[0].rcv_nxt[0] = rt.acc32[0];
        state.conns[0].rcv_nxt[1] = rt.acc32[1];
        state.conns[0].rcv_nxt[2] = rt.acc32[2];
        state.conns[0].rcv_nxt[3] = rt.acc32[3];
        state.conns[0].initialmss = tcp_parse_mss_option(&frame.ethtcp.optdata[0], (((frame.ethtcp.tcpoffset >> 4) - 5) << 2) as! u16 catch |_| { 0u16; });
        state.conns[0].mss = state.conns[0].initialmss;
    } else if idx == 1 {
        state.conns[1].rto = (UIP_RTO as! byte).value;
        state.conns[1].timer = (UIP_RTO as! byte).value;
        state.conns[1].sa = 0 as byte;
        state.conns[1].sv = 4 as byte;
        state.conns[1].nrtx = 0 as byte;
        state.conns[1].lport = frame.ethtcp.destport;
        state.conns[1].rport = frame.ethtcp.srcport;
        state.conns[1].ripaddr.words[0] = frame.ethtcp.srcipaddr[0];
        state.conns[1].ripaddr.words[1] = frame.ethtcp.srcipaddr[1];
        state.conns[1].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
        state.conns[1].snd_nxt[0] = rt.iss[0];
        state.conns[1].snd_nxt[1] = rt.iss[1];
        state.conns[1].snd_nxt[2] = rt.iss[2];
        state.conns[1].snd_nxt[3] = rt.iss[3];
        state.conns[1].len = 1u16;
        state.conns[1].rcv_nxt[0] = frame.ethtcp.seqno[0];
        state.conns[1].rcv_nxt[1] = frame.ethtcp.seqno[1];
        state.conns[1].rcv_nxt[2] = frame.ethtcp.seqno[2];
        state.conns[1].rcv_nxt[3] = frame.ethtcp.seqno[3];
        uip_add32(&state.conns[1].rcv_nxt[0], 1u16, &rt.acc32[0]);
        state.conns[1].rcv_nxt[0] = rt.acc32[0];
        state.conns[1].rcv_nxt[1] = rt.acc32[1];
        state.conns[1].rcv_nxt[2] = rt.acc32[2];
        state.conns[1].rcv_nxt[3] = rt.acc32[3];
        state.conns[1].initialmss = tcp_parse_mss_option(&frame.ethtcp.optdata[0], (((frame.ethtcp.tcpoffset >> 4) - 5) << 2) as! u16 catch |_| { 0u16; });
        state.conns[1].mss = state.conns[1].initialmss;
    } else {
        return false;
    }
    out_index[0] = idx;
    return true;
}

export fn uip_runtime_init(rt: &UipRuntime) void {
    rt.hostaddr = UipIpAddr { words: [0u16, 0u16] };
    rt.draddr = UipIpAddr { words: [0u16, 0u16] };
    rt.netmask = UipIpAddr { words: [0u16, 0u16] };
    rt.len = 0u16;
    rt.slen = 0u16;
    rt.urglen = 0u16;
    rt.surglen = 0u16;
    rt.flags = 0 as byte;
    rt.current_conn = -1;
    rt.current_udp_conn = -1;
    rt.acc32[0] = 0 as byte;
    rt.acc32[1] = 0 as byte;
    rt.acc32[2] = 0 as byte;
    rt.acc32[3] = 0 as byte;
    rt.ipid = 0u16;
    rt.iss[0] = 0 as byte;
    rt.iss[1] = 0 as byte;
    rt.iss[2] = 0 as byte;
    rt.iss[3] = 0 as byte;
    rt.appdata = null;
    rt.sappdata = null;
    rt.urgdata = null;
    uip_runtime_clear_log(rt);
}

export fn uip_setipid(rt: &UipRuntime, id: u16) void {
    rt.ipid = id;
}

export fn uip_sethostaddr(rt: &UipRuntime, addr: &UipIpAddr) void {
    uip_ipaddr_copy(&rt.hostaddr, addr);
}

export fn uip_gethostaddr(rt: &UipRuntime, addr: &UipIpAddr) void {
    uip_ipaddr_copy(addr, &rt.hostaddr);
}

export fn uip_setdraddr(rt: &UipRuntime, addr: &UipIpAddr) void {
    uip_ipaddr_copy(&rt.draddr, addr);
}

export fn uip_getdraddr(rt: &UipRuntime, addr: &UipIpAddr) void {
    uip_ipaddr_copy(addr, &rt.draddr);
}

export fn uip_setnetmask(rt: &UipRuntime, addr: &UipIpAddr) void {
    uip_ipaddr_copy(&rt.netmask, addr);
}

export fn uip_getnetmask(rt: &UipRuntime, addr: &UipIpAddr) void {
    uip_ipaddr_copy(addr, &rt.netmask);
}

export fn uip_prepare_poll(state: &UipState, rt: &UipRuntime, conn_index: i32) void {
    rt.current_conn = conn_index;
    rt.current_udp_conn = -1;
    rt.appdata = @ptr_from_usize(@usize_from_ptr(&rt.frame.ethip as &void) + ((UIP_LLH_LEN + UIP_IPTCPH_LEN) as usize)) as &byte;
    rt.sappdata = rt.appdata;
    rt.len = 0u16;
    rt.slen = 0u16;
    rt.flags = 0 as byte;
    if conn_index >= 0 && uip_conn_active(state, conn_index as usize) {
        rt.flags = (UIP_POLL as! byte).value;
    }
}

export fn uip_prepare_udp_poll(rt: &UipRuntime, conn_index: i32) void {
    rt.current_conn = -1;
    rt.current_udp_conn = conn_index;
    rt.appdata = @ptr_from_usize(@usize_from_ptr(&rt.frame.ethip as &void) + ((UIP_LLH_LEN + UIP_IPUDPH_LEN) as usize)) as &byte;
    rt.sappdata = rt.appdata;
    rt.len = 0u16;
    rt.slen = 0u16;
    rt.flags = (UIP_POLL as! byte).value;
}

export fn uip_process_timer(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult {
    var result: UipProcessResult = UipProcessResult {
        flags: 0 as byte,
        len: 0u16,
        poll: false,
        timed_out: false,
        retransmit: false,
        appcall: false,
        closed: false,
        logged: false,
        urgdata: false
    };
    if conn_index == 0 {
        if state.conns[0].tcpstateflags == (UIP_TIME_WAIT as! byte).value || state.conns[0].tcpstateflags == (UIP_FIN_WAIT_2 as! byte).value {
            state.conns[0].timer = (((state.conns[0].timer as i32) + 1) as! byte).value;
            if state.conns[0].timer == (UIP_TIME_WAIT_TIMEOUT as! byte).value {
                state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
                result.closed = true;
            }
            return result;
        }
        if state.conns[0].tcpstateflags == (UIP_CLOSED as! byte).value {
            return result;
        }
        if uip_outstanding(&state.conns[0]) > 0u16 {
            if state.conns[0].timer == 0 as byte {
                if state.conns[0].nrtx == (UIP_MAXRTX as! byte).value ||
                   ((state.conns[0].tcpstateflags == (UIP_SYN_SENT as! byte).value || state.conns[0].tcpstateflags == (UIP_SYN_RCVD as! byte).value) &&
                    state.conns[0].nrtx == (UIP_MAXSYNRTX as! byte).value) {
                    state.conns[0].tcpstateflags = (UIP_CLOSED as! byte).value;
                    result.flags = (UIP_TIMEDOUT as! byte).value;
                    result.timed_out = true;
                    result.appcall = true;
                    result.closed = true;
                    return result;
                }
                var backoff0: i32 = state.conns[0].nrtx as i32;
                if backoff0 > 4 {
                    backoff0 = 4;
                }
                state.conns[0].timer = ((UIP_RTO << backoff0) as! byte).value;
                state.conns[0].nrtx = (((state.conns[0].nrtx as i32) + 1) as! byte).value;
                result.flags = (UIP_REXMIT as! byte).value;
                result.retransmit = true;
                result.appcall = true;
                return result;
            }
            state.conns[0].timer = (((state.conns[0].timer as i32) - 1) as! byte).value;
            return result;
        }
        if (state.conns[0].tcpstateflags & (UIP_TS_MASK as! byte).value) == (UIP_ESTABLISHED as! byte).value {
            result.flags = (UIP_POLL as! byte).value;
            result.poll = true;
            result.appcall = true;
        }
        return result;
    }

    if conn_index == 1 {
        if state.conns[1].tcpstateflags == (UIP_TIME_WAIT as! byte).value || state.conns[1].tcpstateflags == (UIP_FIN_WAIT_2 as! byte).value {
            state.conns[1].timer = (((state.conns[1].timer as i32) + 1) as! byte).value;
            if state.conns[1].timer == (UIP_TIME_WAIT_TIMEOUT as! byte).value {
                state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
                result.closed = true;
            }
            return result;
        }
        if state.conns[1].tcpstateflags == (UIP_CLOSED as! byte).value {
            return result;
        }
        if uip_outstanding(&state.conns[1]) > 0u16 {
            if state.conns[1].timer == 0 as byte {
                if state.conns[1].nrtx == (UIP_MAXRTX as! byte).value ||
                   ((state.conns[1].tcpstateflags == (UIP_SYN_SENT as! byte).value || state.conns[1].tcpstateflags == (UIP_SYN_RCVD as! byte).value) &&
                    state.conns[1].nrtx == (UIP_MAXSYNRTX as! byte).value) {
                    state.conns[1].tcpstateflags = (UIP_CLOSED as! byte).value;
                    result.flags = (UIP_TIMEDOUT as! byte).value;
                    result.timed_out = true;
                    result.appcall = true;
                    result.closed = true;
                    return result;
                }
                var backoff1: i32 = state.conns[1].nrtx as i32;
                if backoff1 > 4 {
                    backoff1 = 4;
                }
                state.conns[1].timer = ((UIP_RTO << backoff1) as! byte).value;
                state.conns[1].nrtx = (((state.conns[1].nrtx as i32) + 1) as! byte).value;
                result.flags = (UIP_REXMIT as! byte).value;
                result.retransmit = true;
                result.appcall = true;
                return result;
            }
            state.conns[1].timer = (((state.conns[1].timer as i32) - 1) as! byte).value;
            return result;
        }
        if (state.conns[1].tcpstateflags & (UIP_TS_MASK as! byte).value) == (UIP_ESTABLISHED as! byte).value {
            result.flags = (UIP_POLL as! byte).value;
            result.poll = true;
            result.appcall = true;
        }
        return result;
    }

    return result;
}

export fn uip_setethaddr(state: &UipArpState, eaddr: &UipEthAddr) void {
    state.ethaddr.addr[0] = eaddr.addr[0];
    state.ethaddr.addr[1] = eaddr.addr[1];
    state.ethaddr.addr[2] = eaddr.addr[2];
    state.ethaddr.addr[3] = eaddr.addr[3];
    state.ethaddr.addr[4] = eaddr.addr[4];
    state.ethaddr.addr[5] = eaddr.addr[5];
}

export fn uip_neighbor_init(state: &UipNeighborState) void {
    var i: usize = 0;
    while i < @len(state.entries) {
        state.entries[i].time = 128 as byte;
        i = i + 1;
    }
}

export fn uip_neighbor_periodic(state: &UipNeighborState) void {
    var i: usize = 0;
    while i < @len(state.entries) {
        if state.entries[i].time < (128 as byte) {
            state.entries[i].time = state.entries[i].time + (1 as byte);
        }
        i = i + 1;
    }
}

export fn uip_neighbor_add(state: &UipNeighborState, ipaddr: &UipIpAddr, addr: &UipNeighborAddr) void {
    var oldest: usize = 0;
    var oldest_time: byte = 0 as byte;
    var i: usize = 0;
    while i < @len(state.entries) {
        if state.entries[i].time == (128 as byte) {
            oldest = i;
            break;
        }
        if neighbor_entry_matches(&state.entries[i], ipaddr) {
            oldest = i;
            break;
        }
        if state.entries[i].time > oldest_time {
            oldest = i;
            oldest_time = state.entries[i].time;
        }
        i = i + 1;
    }
    uip_ipaddr_copy(&state.entries[oldest].ipaddr, ipaddr);
    neighbor_addr_copy(&state.entries[oldest].addr, addr);
    state.entries[oldest].time = 0 as byte;
}

export fn uip_neighbor_update(state: &UipNeighborState, ipaddr: &UipIpAddr) void {
    var i: usize = 0;
    while i < @len(state.entries) {
        if neighbor_entry_matches(&state.entries[i], ipaddr) {
            state.entries[i].time = 0 as byte;
            return;
        }
        i = i + 1;
    }
}

export fn uip_neighbor_lookup(state: &UipNeighborState, ipaddr: &UipIpAddr, out: &UipNeighborAddr) bool {
    var i: usize = 0;
    while i < @len(state.entries) {
        if neighbor_entry_matches(&state.entries[i], ipaddr) {
            neighbor_addr_copy(out, &state.entries[i].addr);
            return true;
        }
        i = i + 1;
    }
    return false;
}

export fn uip_fw_init(state: &UipFwState) void {
    state.netif_count = 0;
    state.default_index = -1;
    var i: usize = 0;
    while i < @len(state.cache) {
        state.cache[i].timer = 0u16;
        i = i + 1;
    }
}

export fn uip_fw_register(state: &UipFwState, netif: &UipFwNetif) void {
    if state.netif_count < @len(state.netifs) {
        state.netifs[state.netif_count] = netif;
        state.netif_count = state.netif_count + 1;
    }
}

export fn uip_fw_default(state: &UipFwState, netif: &UipFwNetif) void {
    var i: usize = 0;
    while i < state.netif_count {
        if state.netifs[i] == netif {
            state.default_index = (i as! i32).value;
            return;
        }
        i = i + 1;
    }
}

export fn uip_fw_output(state: &UipFwState, rt: &UipRuntime) byte {
    if rt.len == 0u16 {
        return UIP_FW_ZEROLEN as byte;
    }
    var i: usize = 0;
    while i < state.netif_count {
        const netif: &UipFwNetif = state.netifs[i];
        if netif != null && fw_match_netif(&rt.frame.ethip, netif) {
            return netif.output_result;
        }
        i = i + 1;
    }
    if state.default_index >= 0 {
        const index: usize = (state.default_index as! usize).value;
        if index < state.netif_count && index < @len(state.netifs) {
            const netif: &UipFwNetif = state.netifs[index];
            if netif != null {
                return netif.output_result;
            }
        }
    }
    return UIP_FW_NOROUTE as byte;
}

export fn uip_fw_forward(state: &UipFwState, rt: &UipRuntime) byte {
    if rt.frame.ethip.destipaddr[0] == rt.hostaddr.words[0] && rt.frame.ethip.destipaddr[1] == rt.hostaddr.words[1] {
        return UIP_FW_LOCAL as byte;
    }
    const ipid: u16 = fw_ipid_from_hdr(&rt.frame.ethip);
    var i: usize = 0;
    while i < @len(state.cache) {
        if state.cache[i].timer != 0u16 &&
            state.cache[i].ipid == ipid &&
            state.cache[i].proto == rt.frame.ethip.proto &&
            uip_ipaddr_cmp(&state.cache[i].srcipaddr, &UipIpAddr { words: [rt.frame.ethip.srcipaddr[0], rt.frame.ethip.srcipaddr[1]] }) &&
            uip_ipaddr_cmp(&state.cache[i].destipaddr, &UipIpAddr { words: [rt.frame.ethip.destipaddr[0], rt.frame.ethip.destipaddr[1]] }) {
            return UIP_FW_FORWARDED as byte;
        }
        i = i + 1;
    }
    if rt.frame.ethip.ttl <= (1 as byte) {
        return UIP_FW_LOCAL as byte;
    }
    rt.frame.ethip.ttl = rt.frame.ethip.ttl - (1 as byte);
    if rt.frame.ethip.ipchksum >= htons(0xfeffu16) {
        rt.frame.ethip.ipchksum = rt.frame.ethip.ipchksum + htons(0x0100u16) + 1u16;
    } else {
        rt.frame.ethip.ipchksum = rt.frame.ethip.ipchksum + htons(0x0100u16);
    }
    var slot: usize = 0;
    if state.cache[0].timer == 0u16 || state.cache[0].timer <= state.cache[1].timer {
        slot = 0;
    } else {
        slot = 1;
    }
    state.cache[slot].timer = 20u16;
    state.cache[slot].ipid = ipid;
    state.cache[slot].proto = rt.frame.ethip.proto;
    state.cache[slot].srcipaddr = UipIpAddr { words: [rt.frame.ethip.srcipaddr[0], rt.frame.ethip.srcipaddr[1]] };
    state.cache[slot].destipaddr = UipIpAddr { words: [rt.frame.ethip.destipaddr[0], rt.frame.ethip.destipaddr[1]] };
    _ = uip_fw_output(state, rt);
    return UIP_FW_FORWARDED as byte;
}

export fn uip_fw_periodic(state: &UipFwState) void {
    var i: usize = 0;
    while i < @len(state.cache) {
        if state.cache[i].timer > 0u16 {
            state.cache[i].timer = state.cache[i].timer - 1u16;
        }
        i = i + 1;
    }
}

export fn uip_split_output(rt: &UipRuntime, fw: &UipFwState, trace: &UipSplitTrace) byte {
    if rt.frame.ethtcp.proto == (UIP_PROTO_TCP as! byte).value && rt.len == ((UIP_BUFSIZE - UIP_LLH_LEN) as! u16).value {
        const tcplen: u16 = rt.len - ((UIP_TCPIP_HLEN as! u16).value);
        var len1: u16 = tcplen / 2u16;
        var len2: u16 = len1;
        if (len1 + len2) < tcplen {
            len2 = len2 + 1u16;
        }
        rt.len = len1 + ((UIP_TCPIP_HLEN as! u16).value);
        rt.frame.ethtcp.len[0] = ((rt.len >> 8) as! byte).value;
        rt.frame.ethtcp.len[1] = ((rt.len & 0xffu16) as! byte).value;
        trace.calls = 1 as byte;
        trace.sent_len0 = rt.len;
        trace.seq0[0] = rt.frame.ethtcp.seqno[0];
        trace.seq0[1] = rt.frame.ethtcp.seqno[1];
        trace.seq0[2] = rt.frame.ethtcp.seqno[2];
        trace.seq0[3] = rt.frame.ethtcp.seqno[3];
        _ = uip_fw_output(fw, rt);
        rt.len = len2 + ((UIP_TCPIP_HLEN as! u16).value);
        rt.frame.ethtcp.len[0] = ((rt.len >> 8) as! byte).value;
        rt.frame.ethtcp.len[1] = ((rt.len & 0xffu16) as! byte).value;
        uip_add32(&rt.frame.ethtcp.seqno[0], len1, &rt.acc32[0]);
        rt.frame.ethtcp.seqno[0] = rt.acc32[0];
        rt.frame.ethtcp.seqno[1] = rt.acc32[1];
        rt.frame.ethtcp.seqno[2] = rt.acc32[2];
        rt.frame.ethtcp.seqno[3] = rt.acc32[3];
        trace.calls = 2 as byte;
        trace.sent_len1 = rt.len;
        trace.seq1[0] = rt.frame.ethtcp.seqno[0];
        trace.seq1[1] = rt.frame.ethtcp.seqno[1];
        trace.seq1[2] = rt.frame.ethtcp.seqno[2];
        trace.seq1[3] = rt.frame.ethtcp.seqno[3];
        return uip_fw_output(fw, rt);
    }
    trace.calls = 1 as byte;
    trace.sent_len0 = rt.len;
    trace.seq0[0] = rt.frame.ethtcp.seqno[0];
    trace.seq0[1] = rt.frame.ethtcp.seqno[1];
    trace.seq0[2] = rt.frame.ethtcp.seqno[2];
    trace.seq0[3] = rt.frame.ethtcp.seqno[3];
    return uip_fw_output(fw, rt);
}

export fn lc_init(lc: &Lc) void {
    lc.line = 0u16;
}

export fn lc_set(lc: &Lc, line: u16) void {
    lc.line = line;
}

export fn lc_resume(lc: &Lc) u16 {
    return lc.line;
}

export fn lc_end(lc: &Lc) void {
    lc.line = 0u16;
}

export fn pt_init(pt: &Pt) void {
    pt.lc = 0u16;
    pt.yielded = false;
    pt.waiting = false;
    pt.exit_requested = false;
    pt.restart_requested = false;
}

export fn pt_wait_until(pt: &Pt, condition: bool) byte {
    pt.lc = 1u16;
    pt.waiting = !condition;
    if !condition {
        return PT_WAITING as byte;
    }
    return PT_YIELDED as byte;
}

export fn pt_wait_while(pt: &Pt, condition: bool) byte {
    return pt_wait_until(pt, !condition);
}

export fn pt_wait_thread(pt: &Pt, status: byte) byte {
    return pt_wait_while(pt, pt_schedule(status));
}

export fn pt_spawn(pt: &Pt, child: &Pt, status: byte) byte {
    pt_init(child);
    return pt_wait_thread(pt, status);
}

export fn pt_restart(pt: &Pt) byte {
    pt_init(pt);
    pt.restart_requested = true;
    return PT_WAITING as byte;
}

export fn pt_yield(pt: &Pt) byte {
    pt.yielded = true;
    pt.lc = 1u16;
    return PT_YIELDED as byte;
}

export fn pt_yield_until(pt: &Pt, condition: bool) byte {
    pt.yielded = true;
    pt.lc = 1u16;
    if !condition {
        return PT_YIELDED as byte;
    }
    pt.yielded = false;
    return PT_WAITING as byte;
}

export fn pt_exit(pt: &Pt) byte {
    pt.exit_requested = true;
    pt_init(pt);
    return PT_EXITED as byte;
}

export fn pt_end(pt: &Pt) byte {
    pt_init(pt);
    return PT_ENDED as byte;
}

export fn pt_schedule(status: byte) bool {
    return status == (PT_WAITING as! byte).value;
}

fn psock_buf_setup(buf: &PsockBuf, bufptr: &byte, bufsize: usize) void {
    buf.ptr = bufptr;
    buf.left = (bufsize as! u16).value;
}

export fn psock_init(psock: &Psock, buffer: &byte, buffersize: usize) void {
    psock.state = 0 as byte;
    psock.sendlen = 0u16;
    psock.readlen = 0u16;
    psock.lastlen = 0u16;
    psock.bufptr = buffer;
    psock.bufsize = buffersize;
    psock.sendptr = null;
    psock.readptr = null;
    psock_buf_setup(&psock.buf, buffer, buffersize);
    pt_init(&psock.pt);
    pt_init(&psock.psockpt);
}

export fn psock_datalen(psock: &Psock) u16 {
    return ((psock.bufsize as! u16).value) - psock.buf.left;
}

export fn psock_newdata(psock: &Psock) bool {
    if psock.readlen > 0u16 {
        return true;
    }
    if psock.state == (2 as byte) {
        return true;
    }
    return psock_datalen(psock) > 0u16;
}

export fn psock_close(psock: &Psock) void {
    psock.state = (PSOCK_STATE_BLOCKED_CLOSE as! byte).value;
}

export fn psock_exit(psock: &Psock) byte {
    psock_close(psock);
    return pt_exit(&psock.pt);
}

export fn psock_close_exit(psock: &Psock) byte {
    psock_close(psock);
    return psock_exit(psock);
}

export fn psock_send(psock: &Psock, buf: &byte, len: u16, mss: u16, rexmit: bool, acked: bool) byte {
    if len == 0u16 {
        psock.state = (PSOCK_STATE_BLOCKED_CLOSE as! byte).value;
        return PT_EXITED as byte;
    }
    if psock.sendlen == 0u16 {
        psock.sendptr = buf;
        psock.sendlen = len;
        psock.state = (PSOCK_STATE_NONE as! byte).value;
    }
    if psock.sendlen > mss {
        psock.lastlen = mss;
    } else {
        psock.lastlen = psock.sendlen;
    }
    if acked && psock.state == (PSOCK_STATE_DATA_SENT as! byte).value {
        if psock.sendlen > psock.lastlen {
            psock.sendptr = @ptr_from_usize(@usize_from_ptr(psock.sendptr as &void) + (psock.lastlen as usize)) as &byte;
            psock.sendlen = psock.sendlen - psock.lastlen;
        } else {
            psock.sendptr = @ptr_from_usize(@usize_from_ptr(psock.sendptr as &void) + (psock.sendlen as usize)) as &byte;
            psock.sendlen = 0u16;
        }
        psock.state = (PSOCK_STATE_ACKED as! byte).value;
        if psock.sendlen == 0u16 {
            psock.state = (PSOCK_STATE_NONE as! byte).value;
            return PT_ENDED as byte;
        }
    }
    if psock.state != (PSOCK_STATE_DATA_SENT as! byte).value || rexmit {
        psock.state = (PSOCK_STATE_BLOCKED_SEND as! byte).value;
        psock.state = (PSOCK_STATE_DATA_SENT as! byte).value;
    }
    return PT_WAITING as byte;
}

export fn psock_generator_send(psock: &Psock, generated_len: u16, mss: u16, rexmit: bool, acked: bool) byte {
    if generated_len == 0u16 {
        return PT_EXITED as byte;
    }
    if psock.sendlen == 0u16 {
        psock.sendlen = generated_len;
        psock.sendptr = psock.bufptr;
        psock.state = 0 as byte;
    }
    if rexmit {
        psock.sendlen = generated_len;
    }
    return psock_send(psock, psock.sendptr, psock.sendlen, mss, rexmit, acked);
}

export fn psock_readbuf(psock: &Psock, input: &byte, input_len: u16) byte {
    psock_buf_setup(&psock.buf, psock.bufptr, psock.bufsize);
    if input_len == 0u16 && psock.readlen == 0u16 {
        psock.state = 3 as byte;
        return PT_WAITING as byte;
    }
    psock.state = 2 as byte;
    if psock.readlen == 0u16 {
        psock.readptr = input;
        psock.readlen = input_len;
    }
    var copied: u16 = 0u16;
    while copied < psock.readlen && psock.buf.left > 0u16 {
        psock.buf.ptr[copied as usize] = psock.readptr[copied as usize];
        copied = copied + 1u16;
        psock.buf.left = psock.buf.left - 1u16;
    }
    if copied < psock.readlen {
        psock.readptr = @ptr_from_usize(@usize_from_ptr(psock.readptr as &void) + (copied as usize)) as &byte;
        psock.readlen = psock.readlen - copied;
        psock.lastlen = copied;
        return PT_ENDED as byte;
    }
    psock.readptr = @ptr_from_usize(@usize_from_ptr(psock.readptr as &void) + (psock.readlen as usize)) as &byte;
    psock.lastlen = psock.readlen;
    psock.readlen = 0u16;
    if psock_datalen(psock) == 0u16 {
        psock.state = 0 as byte;
        return pt_restart(&psock.psockpt);
    }
    psock.state = 0 as byte;
    return PT_ENDED as byte;
}

export fn psock_readto(psock: &Psock, endmarker: byte, input: &byte, input_len: u16) byte {
    psock_buf_setup(&psock.buf, psock.bufptr, psock.bufsize);
    if input_len == 0u16 && psock.readlen == 0u16 {
        psock.state = 3 as byte;
        return PT_WAITING as byte;
    }
    psock.state = 2 as byte;
    if psock.readlen == 0u16 {
        psock.readptr = input;
        psock.readlen = input_len;
    }
    var copied: u16 = 0u16;
    while copied < psock.readlen && psock.buf.left > 0u16 {
        const current: byte = psock.readptr[copied as usize];
        psock.buf.ptr[copied as usize] = current;
        psock.buf.left = psock.buf.left - 1u16;
        copied = copied + 1u16;
        if current == endmarker {
            psock.readptr = @ptr_from_usize(@usize_from_ptr(psock.readptr as &void) + (copied as usize)) as &byte;
            psock.readlen = psock.readlen - copied;
            psock.lastlen = copied;
            if psock_datalen(psock) == 0u16 {
                psock.state = 0 as byte;
                return pt_restart(&psock.psockpt);
            }
            psock.state = 0 as byte;
            return PT_ENDED as byte;
        }
    }
    psock.lastlen = copied;
    if copied < psock.readlen {
        psock.readptr = @ptr_from_usize(@usize_from_ptr(psock.readptr as &void) + (copied as usize)) as &byte;
        psock.readlen = psock.readlen - copied;
        return PT_WAITING as byte;
    }
    psock.readptr = @ptr_from_usize(@usize_from_ptr(psock.readptr as &void) + (psock.readlen as usize)) as &byte;
    psock.readlen = 0u16;
    return PT_WAITING as byte;
}

export fn timer_set(t: &Timer, interval: u64, now: u64) void {
    t.interval = interval;
    t.start = now;
}

export fn timer_reset(t: &Timer) void {
    t.start = t.start + t.interval;
}

export fn timer_restart(t: &Timer, now: u64) void {
    t.start = now;
}

export fn timer_expired(t: &Timer, now: u64) bool {
    return (now - t.start) >= t.interval;
}

export fn uiplib_ipaddrconv(addrstr: &const byte, ipaddr: &byte) byte {
    var tmp: byte = 0;
    var c: byte = 0;
    var i: byte = 0;
    var j: byte = 0;
    var src: &const byte = addrstr;
    var dst: &byte = ipaddr;

    while i < 4 {
        j = 0;
        while true {
            c = src[0];
            j = j + 1;
            if j > 4 {
                return 0;
            }
            if c == '.' || c == 0 {
                dst[0] = tmp;
                dst = @ptr_from_usize(@usize_from_ptr(dst as &void) + 1) as &byte;
                tmp = 0;
            } else if c >= '0' && c <= '9' {
                const next_tmp: !byte = (((tmp as i32) * 10) + ((c - '0') as i32)) as! byte;
                tmp = next_tmp catch |_| {
                    return 0;
                };
            } else {
                return 0;
            }
            src = @ptr_from_usize(@usize_from_ptr(src as &void) + 1) as &const byte;
            if c == '.' || c == 0 {
                break;
            }
        }
        i = i + 1;
    }
    return 1;
}
