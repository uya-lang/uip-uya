export const UIP_REASS_BUFSIZE: i32 = UIP_BUFSIZE - UIP_LLH_LEN;
export const UIP_REASS_FLAG_LASTFRAG: i32 = 0x01;
export const IP_MF: i32 = 0x20;

export struct UipReassState {
    buf: [byte: 386],
    bitmap: [byte: 6],
    len: u16,
    flags: byte,
    timer: byte
}


fn reass_match_current(state: &UipReassState, frame: &EthIpHdr) bool {
    const stored: &EthIpHdr = @ptr_from_usize(@usize_from_ptr(&state.buf[0] as &void)) as &EthIpHdr;
    return frame.srcipaddr[0] == stored.srcipaddr[0] &&
        frame.srcipaddr[1] == stored.srcipaddr[1] &&
        frame.destipaddr[0] == stored.destipaddr[0] &&
        frame.destipaddr[1] == stored.destipaddr[1] &&
        frame.ipid[0] == stored.ipid[0] &&
        frame.ipid[1] == stored.ipid[1];
}

fn reass_copy_header(state: &UipReassState, frame: &EthIpHdr) void {
    const src: &byte = @ptr_from_usize(@usize_from_ptr(frame as &void)) as &byte;
    var i: usize = 0;
    while i < (UIP_IPH_LEN as usize) {
        state.buf[i] = src[i];
        i = i + 1;
    }
}

export fn uip_reass_init(state: &UipReassState) void {
    var i: usize = 0;
    while i < 386usize {
        state.buf[i] = 0 as byte;
        i = i + 1;
    }
    i = 0;
    while i < 6usize {
        state.bitmap[i] = 0 as byte;
        i = i + 1;
    }
    state.len = 0u16;
    state.flags = 0 as byte;
    state.timer = 0 as byte;
}

export fn uip_reass_overflow(frame: &EthIpHdr) bool {
    const vhl_words: u16 = (frame.vhl & 0x0f as byte) as u16;
    const frag_len: u16 = (((frame.len[0] as u16) << 8) | (frame.len[1] as u16)) - (vhl_words * 4u16);
    const offset: u16 = ((((frame.ipoffset[0] as u16) & 0x3fu16) << 8) | (frame.ipoffset[1] as u16)) * 8u16;
    return offset > (UIP_REASS_BUFSIZE as! u16).value || (offset + frag_len) > (UIP_REASS_BUFSIZE as! u16).value;
}

export fn uip_reass_step(state: &UipReassState, frame: &EthIpHdr, payload: &byte, payload_len: u16, out: &EthIpHdr) u16 {
    if state.timer == 0 as byte {
        reass_copy_header(state, frame);
        state.timer = (UIP_REASS_MAXAGE as! byte).value;
        state.flags = 0 as byte;
        var bi: usize = 0;
        while bi < 6usize {
            state.bitmap[bi] = 0 as byte;
            bi = bi + 1;
        }
    }
    if !reass_match_current(state, frame) {
        return 0u16;
    }
    if uip_reass_overflow(frame) {
        state.timer = 0 as byte;
        return 0u16;
    }
    const offset: u16 = ((((frame.ipoffset[0] as u16) & 0x3fu16) << 8) | (frame.ipoffset[1] as u16)) * 8u16;
    var i: u16 = 0u16;
    while i < payload_len {
        state.buf[(UIP_IPH_LEN as u16 + offset + i) as usize] = payload[i as usize];
        i = i + 1u16;
    }
    const start_byte: usize = (offset / 64u16) as usize;
    const end_byte: usize = ((offset + payload_len) / 64u16) as usize;
    if start_byte == end_byte {
        state.bitmap[start_byte] = 0xff as byte;
    } else {
        var j: usize = start_byte;
        while j <= end_byte && j < 6usize {
            state.bitmap[j] = 0xff as byte;
            j = j + 1;
        }
    }
    if (frame.ipoffset[0] & (IP_MF as! byte).value) == 0 as byte {
        state.flags = state.flags | (UIP_REASS_FLAG_LASTFRAG as! byte).value;
        state.len = offset + payload_len;
    }
    if (state.flags & (UIP_REASS_FLAG_LASTFRAG as! byte).value) == 0 as byte {
        return 0u16;
    }
    const last_index: usize = (state.len / 64u16) as usize;
    var filled: usize = 0;
    while filled < last_index {
        if state.bitmap[filled] != 0xff as byte {
            return 0u16;
        }
        filled = filled + 1;
    }
    const src_hdr: &EthIpHdr = @ptr_from_usize(@usize_from_ptr(&state.buf[0] as &void)) as &EthIpHdr;
    out.ethhdr = src_hdr.ethhdr;
    out.vhl = src_hdr.vhl;
    out.tos = src_hdr.tos;
    out.ipid[0] = src_hdr.ipid[0];
    out.ipid[1] = src_hdr.ipid[1];
    out.ipoffset[0] = 0 as byte;
    out.ipoffset[1] = 0 as byte;
    out.ttl = src_hdr.ttl;
    out.proto = src_hdr.proto;
    out.srcipaddr[0] = src_hdr.srcipaddr[0];
    out.srcipaddr[1] = src_hdr.srcipaddr[1];
    out.destipaddr[0] = src_hdr.destipaddr[0];
    out.destipaddr[1] = src_hdr.destipaddr[1];
    out.len[0] = ((state.len >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    out.len[1] = (state.len & 0xffu16) as! byte catch |_| { 0 as byte; };
    out.ipchksum = 0u16;
    state.timer = 0 as byte;
    return state.len;
}

export fn uip_reass_tick(state: &UipReassState) void {
    if state.timer > 0 as byte {
        state.timer = state.timer - 1 as byte;
    }
}


fn arp_copy_ipaddr_words(dst: &u16, src: &u16) void {
    dst[0] = src[0];
    dst[1] = src[1];
}

fn arp_copy_ethaddr(dst: &UipEthAddr, src: &UipEthAddr) void {
    dst.addr[0] = src.addr[0];
    dst.addr[1] = src.addr[1];
    dst.addr[2] = src.addr[2];
    dst.addr[3] = src.addr[3];
    dst.addr[4] = src.addr[4];
    dst.addr[5] = src.addr[5];
}

