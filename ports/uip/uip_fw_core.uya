// Forwarding / neighbor / split split from uiplib.uya.

export const UIP_FW_OK: i32 = 0;
export const UIP_FW_DROPPED: i32 = 1;
export const UIP_FW_FORWARDED: i32 = 2;
export const UIP_FW_LOCAL: i32 = 3;
export const UIP_FW_ZEROLEN: i32 = 4;
export const UIP_FW_NOROUTE: i32 = 5;

export struct UipRuntime { frame: UipFrame, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, appdata: &byte, sappdata: &byte, urgdata: &byte, len: u16, slen: u16, urglen: u16, surglen: u16, flags: byte, current_conn: i32, current_udp_conn: i32, acc32: [byte: 4], ipid: u16, iss: [byte: 4], logcode: byte, logparam: u16, stats: &UipStats, te_reply: bool }
export struct UipNeighborAddr { addr: UipEthAddr }
export struct UipNeighborEntry { ipaddr: UipIpAddr, addr: UipNeighborAddr, time: byte }
// Legacy duplicate neighbor-cache declarations retained for fw compatibility.
// Canonical source of truth is ports/uip/uip_neighbor_lib.uya.
export struct UipNeighborState { entries: [UipNeighborEntry: 8] }
// Canonical forwarding implementation for the project lives in this file.
export struct UipFwNetif { ipaddr: UipIpAddr, netmask: UipIpAddr, output_result: byte, output_calls: byte, last_len: u16 }
export struct UipFwCacheEntry { timer: u16, srcipaddr: UipIpAddr, destipaddr: UipIpAddr, ipid: u16, proto: byte }
export struct UipFwState { netifs: [&UipFwNetif: 4], netif_count: usize, default_index: i32, cache: [UipFwCacheEntry: 2] }
export struct UipSplitTrace { calls: byte, sent_len0: u16, sent_len1: u16, seq0: [byte: 4], seq1: [byte: 4] }

fn fw_match_netif(hdr: &EthIpHdr, netif: &UipFwNetif) bool {
    return uip_ipaddr_maskcmp(&UipIpAddr { words: [hdr.destipaddr[0], hdr.destipaddr[1]] }, &netif.ipaddr, &netif.netmask);
}

fn fw_ipid_from_hdr(hdr: &EthIpHdr) u16 {
    return (((hdr.ipid[0] as u16) << 8) | (hdr.ipid[1] as u16));
}

fn fw_ipv4_header_checksum(hdr: &EthIpHdr) u16 {
    const bytes: &byte = @ptr_from_usize(@usize_from_ptr(hdr as &void)) as &byte;
    var sum: u32 = 0u32;
    var i: usize = 0usize;
    while i < 20usize {
        const hi: u16 = bytes[i] as u16;
        const lo: u16 = bytes[i + 1usize] as u16;
        sum = sum + (((hi << 8) | lo) as u32);
        i = i + 2usize;
    }
    while (sum >> 16) != 0u32 {
        sum = (sum & 0xffffu32) + (sum >> 16);
    }
    return (~(sum as u16));
}

fn fw_time_exceeded(rt: &UipRuntime) void {
    if rt.frame.ethip.proto == (UIP_PROTO_ICMP as! byte).value {
        rt.len = 0u16;
        return;
    }
    const src0: u16 = rt.frame.ethip.srcipaddr[0];
    const src1: u16 = rt.frame.ethip.srcipaddr[1];
    const dst0: u16 = rt.frame.ethip.destipaddr[0];
    const dst1: u16 = rt.frame.ethip.destipaddr[1];
    const old_vhl: byte = rt.frame.ethip.vhl;
    const old_tos: byte = rt.frame.ethip.tos;
    const old_len0: byte = rt.frame.ethip.len[0];
    const old_len1: byte = rt.frame.ethip.len[1];
    const old_id0: byte = rt.frame.ethip.ipid[0];
    const old_id1: byte = rt.frame.ethip.ipid[1];
    const old_off0: byte = rt.frame.ethip.ipoffset[0];
    const old_off1: byte = rt.frame.ethip.ipoffset[1];
    const old_ttl: byte = rt.frame.ethip.ttl;
    const old_proto: byte = rt.frame.ethip.proto;
    const old_ck_hi: byte = ((rt.frame.ethip.ipchksum >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    const old_ck_lo: byte = (rt.frame.ethip.ipchksum & 0xffu16) as! byte catch |_| { 0 as byte; };
    rt.frame.ethip.destipaddr[0] = src0;
    rt.frame.ethip.destipaddr[1] = src1;
    rt.frame.ethip.srcipaddr[0] = rt.hostaddr.words[0];
    rt.frame.ethip.srcipaddr[1] = rt.hostaddr.words[1];
    rt.frame.ethip.vhl = 0x45 as byte;
    rt.frame.ethip.tos = 0 as byte;
    rt.frame.ethip.ipoffset[0] = 0 as byte;
    rt.frame.ethip.ipoffset[1] = 0 as byte;
    rt.frame.ethip.ttl = (UIP_TTL as! byte).value;
    rt.frame.ethip.proto = (UIP_PROTO_ICMP as! byte).value;
    rt.len = 56u16;
    rt.frame.ethip.len[0] = 0 as byte;
    rt.frame.ethip.len[1] = 56 as byte;
    const payload: &byte = @ptr_from_usize(@usize_from_ptr(&rt.frame.ethtcp.srcport as &void)) as &byte;
    payload[0] = 11 as byte;
    payload[1] = 0 as byte;
    payload[2] = 0 as byte;
    payload[3] = 0 as byte;
    payload[4] = 0 as byte;
    payload[5] = 0 as byte;
    payload[6] = 0 as byte;
    payload[7] = 0 as byte;
    payload[8] = old_vhl;
    payload[9] = old_tos;
    payload[10] = old_len0;
    payload[11] = old_len1;
    payload[12] = old_id0;
    payload[13] = old_id1;
    payload[14] = old_off0;
    payload[15] = old_off1;
    payload[16] = old_ttl;
    payload[17] = old_proto;
    payload[18] = old_ck_hi;
    payload[19] = old_ck_lo;
    payload[20] = ((src0 >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[21] = (src0 & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[22] = ((src1 >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[23] = (src1 & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[24] = ((dst0 >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[25] = (dst0 & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[26] = ((dst1 >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[27] = (dst1 & 0xffu16) as! byte catch |_| { 0 as byte; };
    var sum_data: u32 = 0u32;
    var k: usize = 0usize;
    while k < 36usize {
        const hi: u16 = payload[k] as u16;
        const lo: u16 = payload[k + 1usize] as u16;
        sum_data = sum_data + (((hi << 8) | lo) as u32);
        k = k + 2usize;
    }
    while (sum_data >> 16) != 0u32 {
        sum_data = (sum_data & 0xffffu32) + (sum_data >> 16);
    }
    const icmp_cksum: u16 = (~(sum_data as u16));
    payload[2] = ((icmp_cksum >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; };
    payload[3] = (icmp_cksum & 0xffu16) as! byte catch |_| { 0 as byte; };
    rt.frame.ethip.ipchksum = 0u16;
    rt.frame.ethip.ipchksum = fw_ipv4_header_checksum(&rt.frame.ethip);
    if rt.stats != null {
        rt.stats.ip.sent = rt.stats.ip.sent + 1u16;
        rt.stats.icmp.sent = rt.stats.icmp.sent + 1u16;
    }
    rt.te_reply = true;
}



fn neighbor_addr_copy(dst: &UipNeighborAddr, src: &UipNeighborAddr) void {
    dst.addr.addr[0] = src.addr.addr[0];
    dst.addr.addr[1] = src.addr.addr[1];
    dst.addr.addr[2] = src.addr.addr[2];
    dst.addr.addr[3] = src.addr.addr[3];
    dst.addr.addr[4] = src.addr.addr[4];
    dst.addr.addr[5] = src.addr.addr[5];
}

fn neighbor_entry_matches(entry: &UipNeighborEntry, ipaddr: &UipIpAddr) bool {
    return uip_ipaddr_cmp(&entry.ipaddr, ipaddr);
}

// Legacy duplicate neighbor-cache implementation retained for fw compatibility.
// Do not extend here; active development should target ports/uip/uip_neighbor_lib.uya.
export fn uip_neighbor_init(state: &UipNeighborState) void {
    var i: usize = 0;
    while i < @len(state.entries) {
        state.entries[i].time = 128 as byte;
        i = i + 1;
    }
}

export fn uip_neighbor_periodic(state: &UipNeighborState) void {
    var i: usize = 0;
    while i < @len(state.entries) {
        if state.entries[i].time < (128 as byte) {
            state.entries[i].time = state.entries[i].time + (1 as byte);
        }
        i = i + 1;
    }
}

export fn uip_neighbor_add(state: &UipNeighborState, ipaddr: &UipIpAddr, addr: &UipNeighborAddr) void {
    var oldest: usize = 0;
    var oldest_time: byte = 0 as byte;
    var i: usize = 0;
    while i < @len(state.entries) {
        if state.entries[i].time == (128 as byte) || neighbor_entry_matches(&state.entries[i], ipaddr) {
            oldest = i;
            break;
        }
        if state.entries[i].time > oldest_time {
            oldest = i;
            oldest_time = state.entries[i].time;
        }
        i = i + 1;
    }
    state.entries[oldest].ipaddr.words[0] = ipaddr.words[0];
    state.entries[oldest].ipaddr.words[1] = ipaddr.words[1];
    neighbor_addr_copy(&state.entries[oldest].addr, addr);
    state.entries[oldest].time = 0 as byte;
}

export fn uip_neighbor_update(state: &UipNeighborState, ipaddr: &UipIpAddr) void {
    var i: usize = 0;
    while i < @len(state.entries) {
        if neighbor_entry_matches(&state.entries[i], ipaddr) {
            state.entries[i].time = 0 as byte;
            return;
        }
        i = i + 1;
    }
}

export fn uip_neighbor_lookup(state: &UipNeighborState, ipaddr: &UipIpAddr, out: &UipNeighborAddr) bool {
    var i: usize = 0;
    while i < @len(state.entries) {
        if neighbor_entry_matches(&state.entries[i], ipaddr) {
            neighbor_addr_copy(out, &state.entries[i].addr);
            return true;
        }
        i = i + 1;
    }
    return false;
}

export fn uip_fw_init(state: &UipFwState) void {
    state.netif_count = 0;
    state.default_index = -1;
    var i: usize = 0;
    while i < @len(state.cache) {
        state.cache[i].timer = 0u16;
        i = i + 1;
    }
}

export fn uip_fw_register(state: &UipFwState, netif: &UipFwNetif) void {
    if state.netif_count < @len(state.netifs) {
        state.netifs[state.netif_count] = netif;
        state.netif_count = state.netif_count + 1;
    }
}

export fn uip_fw_default(state: &UipFwState, netif: &UipFwNetif) void {
    var i: usize = 0;
    while i < state.netif_count {
        if state.netifs[i] == netif {
            state.default_index = (i as! i32).value;
            return;
        }
        i = i + 1;
    }
}

export fn uip_fw_output(state: &UipFwState, rt: &UipRuntime) byte {
    if rt.len == 0u16 {
        return UIP_FW_ZEROLEN as byte;
    }
    if rt.frame.ethip.destipaddr[0] == 0xffffu16 && rt.frame.ethip.destipaddr[1] == 0xffffu16 {
        var sent: bool = false;
        if state.default_index >= 0 {
            const index: usize = (state.default_index as! usize).value;
            if index < state.netif_count && index < @len(state.netifs) {
                const netif: &UipFwNetif = state.netifs[index];
                if netif != null {
                    netif.last_len = rt.len;
                    netif.last_len = rt.len;
                    netif.output_calls = netif.output_calls + (1 as byte);
                    sent = true;
                }
            }
        }
        var i: usize = 0;
        while i < state.netif_count {
            const netif: &UipFwNetif = state.netifs[i];
            if netif != null {
                var is_default: bool = false;
                if state.default_index >= 0 {
                    is_default = i == ((state.default_index as! usize).value);
                }
                if !is_default {
                    netif.last_len = rt.len;
                    netif.output_calls = netif.output_calls + (1 as byte);
                    sent = true;
                }
            }
            i = i + 1;
        }
        if sent {
            return UIP_FW_OK as byte;
        }
        return UIP_FW_NOROUTE as byte;
    }
    var i: usize = 0;
    while i < state.netif_count {
        const netif: &UipFwNetif = state.netifs[i];
        if netif != null && fw_match_netif(&rt.frame.ethip, netif) {
            netif.last_len = rt.len;
            netif.output_calls = netif.output_calls + (1 as byte);
            return netif.output_result;
        }
        i = i + 1;
    }
    if state.default_index >= 0 {
        const index: usize = (state.default_index as! usize).value;
        if index < state.netif_count && index < @len(state.netifs) {
            const netif: &UipFwNetif = state.netifs[index];
            if netif != null {
                netif.last_len = rt.len;
                netif.output_calls = netif.output_calls + (1 as byte);
                return netif.output_result;
            }
        }
    }
    return UIP_FW_NOROUTE as byte;
}

export fn uip_fw_forward(state: &UipFwState, rt: &UipRuntime) byte {
    const is_broadcast: bool = rt.frame.ethip.destipaddr[0] == 0xffffu16 && rt.frame.ethip.destipaddr[1] == 0xffffu16;
    if rt.frame.ethip.destipaddr[0] == rt.hostaddr.words[0] && rt.frame.ethip.destipaddr[1] == rt.hostaddr.words[1] {
        return UIP_FW_LOCAL as byte;
    }
    const ipid: u16 = fw_ipid_from_hdr(&rt.frame.ethip);
    var i: usize = 0;
    while i < @len(state.cache) {
        if state.cache[i].timer != 0u16 &&
            state.cache[i].ipid == ipid &&
            state.cache[i].proto == rt.frame.ethip.proto &&
            uip_ipaddr_cmp(&state.cache[i].srcipaddr, &UipIpAddr { words: [rt.frame.ethip.srcipaddr[0], rt.frame.ethip.srcipaddr[1]] }) &&
            uip_ipaddr_cmp(&state.cache[i].destipaddr, &UipIpAddr { words: [rt.frame.ethip.destipaddr[0], rt.frame.ethip.destipaddr[1]] }) {
            return UIP_FW_FORWARDED as byte;
        }
        i = i + 1;
    }
    rt.te_reply = false;
    if rt.frame.ethip.ttl <= (1 as byte) {
        if is_broadcast {
            return UIP_FW_LOCAL as byte;
        }
        fw_time_exceeded(rt);
    }
    if !rt.te_reply {
        rt.frame.ethip.ttl = rt.frame.ethip.ttl - (1 as byte);
        if rt.frame.ethip.ipchksum >= htons(0xfeffu16) {
            rt.frame.ethip.ipchksum = rt.frame.ethip.ipchksum + htons(0x0100u16) + 1u16;
        } else {
            rt.frame.ethip.ipchksum = rt.frame.ethip.ipchksum + htons(0x0100u16);
        }
    }
    if !rt.te_reply {
        var slot: usize = 0;
        if state.cache[0].timer == 0u16 || state.cache[0].timer <= state.cache[1].timer {
            slot = 0;
        } else {
            slot = 1;
        }
        state.cache[slot].timer = 20u16;
        state.cache[slot].ipid = ipid;
        state.cache[slot].proto = rt.frame.ethip.proto;
        state.cache[slot].srcipaddr = UipIpAddr { words: [rt.frame.ethip.srcipaddr[0], rt.frame.ethip.srcipaddr[1]] };
        state.cache[slot].destipaddr = UipIpAddr { words: [rt.frame.ethip.destipaddr[0], rt.frame.ethip.destipaddr[1]] };
    }
    if rt.len > 0u16 {
        rt.appdata = @ptr_from_usize(@usize_from_ptr(&rt.frame.ethip as &void) + ((UIP_TCPIP_HLEN as usize))) as &byte;
        _ = uip_fw_output(state, rt);
    }
    if is_broadcast {
        return UIP_FW_LOCAL as byte;
    }
    return UIP_FW_FORWARDED as byte;
}

export fn uip_fw_periodic(state: &UipFwState) void {
    var i: usize = 0;
    while i < @len(state.cache) {
        if state.cache[i].timer > 0u16 {
            state.cache[i].timer = state.cache[i].timer - 1u16;
        }
        i = i + 1;
    }
}

fn fw_tcp_header_checksum(hdr: &EthTcpHdr, total_len: u16) u16 {
    const bytes: &byte = @ptr_from_usize(@usize_from_ptr(hdr as &void)) as &byte;
    var sum: u32 = 0u32;
    sum = sum + ((hdr.srcipaddr[0] >> 8) as u32) + ((hdr.srcipaddr[0] & 0xffu16) as u32);
    sum = sum + ((hdr.srcipaddr[1] >> 8) as u32) + ((hdr.srcipaddr[1] & 0xffu16) as u32);
    sum = sum + ((hdr.destipaddr[0] >> 8) as u32) + ((hdr.destipaddr[0] & 0xffu16) as u32);
    sum = sum + ((hdr.destipaddr[1] >> 8) as u32) + ((hdr.destipaddr[1] & 0xffu16) as u32);
    sum = sum + (UIP_PROTO_TCP as u32);
    sum = sum + ((total_len - (UIP_TCPIP_HLEN as! u16).value) as u32);
    var i: usize = 20usize;
    while i < (total_len as usize) {
        const hi: u16 = bytes[i] as u16;
        var lo: u16 = 0u16;
        if (i + 1usize) < (total_len as usize) {
            lo = bytes[i + 1usize] as u16;
        }
        sum = sum + (((hi << 8) | lo) as u32);
        i = i + 2usize;
    }
    while (sum >> 16) != 0u32 {
        sum = (sum & 0xffffu32) + (sum >> 16);
    }
    return (~(sum as u16));
}

export fn uip_split_output(rt: &UipRuntime, fw: &UipFwState, trace: &UipSplitTrace) byte {
    if rt.frame.ethtcp.proto == (UIP_PROTO_TCP as! byte).value && rt.len == ((UIP_BUFSIZE - UIP_LLH_LEN) as! u16).value {
        const tcplen: u16 = rt.len - ((UIP_TCPIP_HLEN as! u16).value);
        var len1: u16 = tcplen / 2u16;
        var len2: u16 = len1;
        if (len1 + len2) < tcplen {
            len2 = len2 + 1u16;
        }
        rt.len = len1 + ((UIP_TCPIP_HLEN as! u16).value);
        rt.frame.ethtcp.len[0] = ((rt.len >> 8) as! byte).value;
        rt.frame.ethtcp.len[1] = ((rt.len & 0xffu16) as! byte).value;
        rt.frame.ethtcp.tcpchksum = 0u16;
        rt.frame.ethtcp.tcpchksum = fw_tcp_header_checksum(&rt.frame.ethtcp, rt.len);
        rt.frame.ethtcp.ipchksum = 0u16;
        rt.frame.ethtcp.ipchksum = fw_ipv4_header_checksum(@ptr_from_usize(@usize_from_ptr(&rt.frame.ethtcp as &void)) as &EthIpHdr);
        trace.calls = 1 as byte;
        trace.sent_len0 = rt.len;
        trace.seq0[0] = rt.frame.ethtcp.seqno[0];
        trace.seq0[1] = rt.frame.ethtcp.seqno[1];
        trace.seq0[2] = rt.frame.ethtcp.seqno[2];
        trace.seq0[3] = rt.frame.ethtcp.seqno[3];
        const first_result: byte = uip_fw_output(fw, rt);
        if first_result != (UIP_FW_OK as! byte).value {
            return first_result;
        }
        const app: &byte = rt.appdata;
        if app != null {
            var move_i: u16 = 0u16;
            while move_i < len2 {
                const dstp: &byte = @ptr_from_usize(@usize_from_ptr(app as &void) + (move_i as usize)) as &byte;
                const srcp: &byte = @ptr_from_usize(@usize_from_ptr(app as &void) + ((len1 + move_i) as usize)) as &byte;
                dstp[0] = srcp[0];
                move_i = move_i + 1u16;
            }
        }
        rt.len = len2 + ((UIP_TCPIP_HLEN as! u16).value);
        rt.frame.ethtcp.len[0] = ((rt.len >> 8) as! byte).value;
        rt.frame.ethtcp.len[1] = ((rt.len & 0xffu16) as! byte).value;
        uip_add32(&rt.frame.ethtcp.seqno[0], len1, &rt.acc32[0]);
        rt.frame.ethtcp.seqno[0] = rt.acc32[0];
        rt.frame.ethtcp.seqno[1] = rt.acc32[1];
        rt.frame.ethtcp.seqno[2] = rt.acc32[2];
        rt.frame.ethtcp.seqno[3] = rt.acc32[3];
        rt.frame.ethtcp.tcpchksum = 0u16;
        rt.frame.ethtcp.tcpchksum = fw_tcp_header_checksum(&rt.frame.ethtcp, rt.len);
        rt.frame.ethtcp.ipchksum = 0u16;
        rt.frame.ethtcp.ipchksum = fw_ipv4_header_checksum(@ptr_from_usize(@usize_from_ptr(&rt.frame.ethtcp as &void)) as &EthIpHdr);
        trace.calls = 2 as byte;
        trace.sent_len1 = rt.len;
        trace.seq1[0] = rt.frame.ethtcp.seqno[0];
        trace.seq1[1] = rt.frame.ethtcp.seqno[1];
        trace.seq1[2] = rt.frame.ethtcp.seqno[2];
        trace.seq1[3] = rt.frame.ethtcp.seqno[3];
        return uip_fw_output(fw, rt);
    }
    trace.calls = 1 as byte;
    trace.sent_len0 = rt.len;
    trace.seq0[0] = rt.frame.ethtcp.seqno[0];
    trace.seq0[1] = rt.frame.ethtcp.seqno[1];
    trace.seq0[2] = rt.frame.ethtcp.seqno[2];
    trace.seq0[3] = rt.frame.ethtcp.seqno[3];
    return uip_fw_output(fw, rt);
}
