        stats: UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } },
        iss: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        lastport: 0u16
    };
    state.udp_conns[1].lport = htons(1234u16);
    state.udp_conns[1].rport = htons(4321u16);
    state.udp_conns[1].ripaddr[0] = uip_ipaddr(192, 168, 0, 9).words[0];
    state.udp_conns[1].ripaddr[1] = uip_ipaddr(192, 168, 0, 9).words[1];
    const frame: UipUdpipHdr = UipUdpipHdr {
        vtc: 0 as byte,
        tcflow: 0 as byte,
        flow: 0u16,
        len: [0 as byte, 0 as byte],
        proto: 0 as byte,
        ttl: 0 as byte,
        srcipaddr: [state.udp_conns[1].ripaddr[0], state.udp_conns[1].ripaddr[1]],
        destipaddr: [0u16, 0u16],
        srcport: htons(4321u16),
        destport: htons(1234u16),
        udplen: 0u16,
        udpchksum: 0u16
    };
    try assert_eq_i32(udp_find_conn(&state, &frame), 1);
}

