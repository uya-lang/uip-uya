            snd_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            len: 0u16,
            mss: 0u16,
            initialmss: 0u16,
            sa: 0 as byte,
            sv: 0 as byte,
            rto: 0 as byte,
            tcpstateflags: 0 as byte,
            timer: 0 as byte,
            nrtx: 0 as byte,
            appstate: 0u16
        }: 10],
        udp_conns: [UipUdpConn {
            ripaddr: [0u16, 0u16],
            lport: 0u16,
            rport: 0u16,
            ttl: 0 as byte,
            appstate: 0u16
        }: 10],
        hostaddr: UipIpAddr { words: [0u16, 0u16] },
        stats: UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } },
        iss: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        lastport: 0u16
    };
    state.udp_conns[1].ripaddr[0] = uip_ipaddr(10, 0, 0, 9).words[0];
    state.udp_conns[1].ripaddr[1] = uip_ipaddr(10, 0, 0, 9).words[1];
    state.udp_conns[1].lport = htons(2222u16);
    state.udp_conns[1].rport = htons(3333u16);
    const result: UipProcessResult = udp_send_step(&state, &rt, 1, 4u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(rt.current_udp_conn, 1);
    try assert_eq_i32(rt.frame.ethudp.srcport as i32, htons(2222u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.destport as i32, htons(3333u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.udplen as i32, htons(12u16) as i32);
    try assert_eq_i32(rt.len as i32, 32);
}

struct UipEthAddr {
    addr: [byte: 6]
}

struct UipEthHdr {
    dest: UipEthAddr,
    src: UipEthAddr,
    type: u16
}

struct EthIpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2]
}

struct EthTcpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    seqno: [byte: 4],
    ackno: [byte: 4],
    tcpoffset: byte,
    flags: byte,
    wnd: [byte: 2],
    tcpchksum: u16,
    urgp: u16,
    optdata: [byte: 4]
}

struct EthUdpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    udplen: u16,
    udpchksum: u16
}

struct ArpHdr {
    ethhdr: UipEthHdr,
    hwtype: u16,
    protocol: u16,
    hwlen: byte,
    protolen: byte,
    opcode: u16,
    shwaddr: UipEthAddr,
    sipaddr: [u16: 2],
    dhwaddr: UipEthAddr,
    dipaddr: [u16: 2]
}

struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }

struct UipConn {
    ripaddr: [u16: 2],
    lport: u16,
    rport: u16,
    rcv_nxt: [byte: 4],
    snd_nxt: [byte: 4],
    len: u16,
    mss: u16,
    initialmss: u16,
    sa: byte,
    sv: byte,
    rto: byte,
    tcpstateflags: byte,
    timer: byte,
    nrtx: byte,
    appstate: u16
}

struct UipUdpConn {
    ripaddr: [u16: 2],
    lport: u16,
    rport: u16,
    ttl: byte,
    appstate: u16
}

struct UipState {
    conns: [UipConn: 10],
    listener_ports: [u16: 10],
    udp_conns: [UipUdpConn: 10],
    hostaddr: UipIpAddr,
    stats: UipStats,
    iss: [byte: 4],
    lastport: u16
}

struct UipRuntimeFrame {
    ethip: EthIpHdr,
    ethtcp: EthTcpHdr,
    ethudp: EthUdpHdr,
    arp: ArpHdr
}

struct UipRuntime {
    frame: UipRuntimeFrame,
    hostaddr: UipIpAddr,
    draddr: UipIpAddr,
    netmask: UipIpAddr,
    appdata: &byte,
    sappdata: &byte,
    urgdata: &byte,
    len: u16,
    uip_len: u16,
    uip_slen: u16,
    slen: u16,
    urglen: u16,
    surglen: u16,
    flags: byte,
    current_conn: i32,
    current_udp_conn: i32,
    payload_view: &byte,
    payload_len: u16,
    input_view: &byte,
    input_len: u16,
    app_input: &byte,
    app_input_len: u16,
    app_output: &byte,
    logbuf: [UipRuntimeLog: 16],
    logcount: usize,
    logcode: byte,
    logparam: u16,
    logs: [UipRuntimeLog: 16],
    ipid: u16,
    stats: &UipStats,
    te_reply: bool
}

struct UipProcessResult {
    flags: byte,
    len: u16,
    poll: bool,
    timed_out: bool,
    retransmit: bool,
    appcall: bool,
    closed: bool,
    logged: bool,
    urgdata: bool
}

struct UipUdpipHdr {
    vtc: byte,
    tcflow: byte,
    flow: u16,
    len: [byte: 2],
    proto: byte,
    ttl: byte,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    udplen: u16,
    udpchksum: u16
}

test "udp_matches_conn checks local port and optional remote tuple" {
    var conn: UipUdpConn = UipUdpConn {
        ripaddr: [uip_ipaddr(192, 168, 0, 9).words[0], uip_ipaddr(192, 168, 0, 9).words[1]],
        lport: htons(1234u16),
        rport: htons(4321u16),
        ttl: 64 as byte,
        appstate: 0u16
    };
    const frame: UipUdpipHdr = UipUdpipHdr {
        vtc: 0 as byte,
        tcflow: 0 as byte,
        flow: 0u16,
        len: [0 as byte, 0 as byte],
        proto: 0 as byte,
        ttl: 0 as byte,
        srcipaddr: [conn.ripaddr[0], conn.ripaddr[1]],
        destipaddr: [0u16, 0u16],
        srcport: htons(4321u16),
        destport: htons(1234u16),
        udplen: 0u16,
        udpchksum: 0u16
    };
    try assert_eq_bool(udp_matches_conn(&conn, &frame), true);
}

