        len: 0u16,
        lastport: 0u16
    };
    state.udp_conns[0].ripaddr = uip_ipaddr(192, 168, 0, 9);
    state.udp_conns[0].lport = htons(1234u16);
    state.udp_conns[0].rport = htons(4321u16);
    state.udp_conns[0].ttl = 64 as byte;
    const result: UipProcessResult = udp_send_step(&state, &rt, 0, 12u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(rt.frame.ethudp.srcport as i32, htons(1234u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.destport as i32, htons(4321u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.udplen as i32, htons(20u16) as i32);
    try assert_eq_i32(rt.len as i32, 40);
}
