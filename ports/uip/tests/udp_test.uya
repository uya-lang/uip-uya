                ipoffset: [0 as byte, 0 as byte],
                ttl: 0 as byte,
                proto: 0 as byte,
                ipchksum: 0u16,
                srcipaddr: [0u16, 0u16],
                destipaddr: [0u16, 0u16],
                srcport: 0u16,
                destport: 0u16,
                udplen: 0u16,
                udpchksum: 0u16
            },
            arp: ArpHdr {
                ethhdr: UipEthHdr {
                    dest: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    src: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    type: 0u16
                },
                hwtype: 0u16,
                protocol: 0u16,
                hwlen: 0 as byte,
                protolen: 0 as byte,
                opcode: 0u16,
                shwaddr: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                sipaddr: [0u16, 0u16],
                dhwaddr: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                dipaddr: [0u16, 0u16]
            }
        },
        hostaddr: uip_ipaddr(10, 0, 0, 2),
        draddr: UipIpAddr { words: [0u16, 0u16] },
        netmask: UipIpAddr { words: [0u16, 0u16] },
        appdata: &rt.frame.ethip.ethhdr.dest.addr[0],
        sappdata: &rt.frame.ethip.ethhdr.dest.addr[0],
        len: 0u16,
        slen: 0u16,
        flags: 0 as byte,
        current_conn: 0,
        current_udp_conn: 0,
        acc32: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        ipid: 0u16,
        iss: [0 as byte, 0 as byte, 0 as byte, 0 as byte]
    };
    var state: UipState = UipState {
        listenports: [0u16: 20],
        conns: [UipConn {
            ripaddr: UipIpAddr { words: [0u16, 0u16] },
            lport: 0u16,
            rport: 0u16,
            rcv_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            snd_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            len: 0u16,
            mss: 0u16,
            initialmss: 0u16,
            sa: 0 as byte,
            sv: 0 as byte,
            rto: 0 as byte,
            tcpstateflags: 0 as byte,
            timer: 0 as byte,
            nrtx: 0 as byte,
            appstate: 0u16
        }: 10],
        udp_conns: [UipUdpConn {
            ripaddr: UipIpAddr { words: [0u16, 0u16] },
            lport: 0u16,
            rport: 0u16,
            ttl: 0 as byte,
            appstate: 0u16
        }: 10],
        acc32: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        flags: 0 as byte,
        len: 0u16,
        lastport: 0u16
    };
    state.udp_conns[1].ripaddr = uip_ipaddr(10, 0, 0, 9);
    state.udp_conns[1].lport = htons(2222u16);
    state.udp_conns[1].rport = htons(3333u16);
    const result: UipProcessResult = udp_send_step(&state, &rt, 1, 4u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(rt.current_udp_conn, 1);
    try assert_eq_i32(rt.frame.ethudp.srcport as i32, htons(2222u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.destport as i32, htons(3333u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.udplen as i32, htons(12u16) as i32);
    try assert_eq_i32(rt.len as i32, 32);
}

struct UipEthAddr {
    addr: [byte: 6]
}

struct UipEthHdr {
    dest: UipEthAddr,
    src: UipEthAddr,
    type: u16
}

struct EthIpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2]
}

struct EthTcpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    seqno: [byte: 4],
    ackno: [byte: 4],
    tcpoffset: byte,
    flags: byte,
    wnd: [byte: 2],
    tcpchksum: u16,
    urgp: u16,
    optdata: [byte: 4]
}

struct EthUdpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    udplen: u16,
    udpchksum: u16
}

struct ArpHdr {
    ethhdr: UipEthHdr,
    hwtype: u16,
    protocol: u16,
    hwlen: byte,
    protolen: byte,
    opcode: u16,
    shwaddr: UipEthAddr,
    sipaddr: [u16: 2],
    dhwaddr: UipEthAddr,
    dipaddr: [u16: 2]
}

struct UipConn {
    ripaddr: UipIpAddr,
    lport: u16,
    rport: u16,
    rcv_nxt: [byte: 4],
    snd_nxt: [byte: 4],
    len: u16,
    mss: u16,
    initialmss: u16,
    sa: byte,
    sv: byte,
    rto: byte,
    tcpstateflags: byte,
    timer: byte,
    nrtx: byte,
    appstate: u16
}

struct UipUdpConn {
    ripaddr: UipIpAddr,
    lport: u16,
    rport: u16,
    ttl: byte,
    appstate: u16
}

struct UipState {
    listenports: [u16: 20],
    conns: [UipConn: 10],
    udp_conns: [UipUdpConn: 10],
    acc32: [byte: 4],
    flags: byte,
    len: u16,
    lastport: u16
}

struct UipFrame {
    ethip: EthIpHdr,
    ethtcp: EthTcpHdr,
    ethudp: EthUdpHdr,
    arp: ArpHdr
}

struct UipRuntime {
    frame: UipFrame,
    hostaddr: UipIpAddr,
    draddr: UipIpAddr,
    netmask: UipIpAddr,
    appdata: &byte,
    sappdata: &byte,
    len: u16,
    slen: u16,
    flags: byte,
    current_conn: i32,
    current_udp_conn: i32,
    acc32: [byte: 4],
    ipid: u16,
    iss: [byte: 4]
}

struct UipProcessResult {
    flags: byte,
    len: u16,
    poll: bool,
    timed_out: bool,
    retransmit: bool,
    appcall: bool,
    closed: bool
}

struct UipUdpipHdr {
    vtc: byte,
    tcflow: byte,
    flow: u16,
    len: [byte: 2],
    proto: byte,
    ttl: byte,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    udplen: u16,
    udpchksum: u16
}

test "udp_matches_conn checks local port and optional remote tuple" {
    var conn: UipUdpConn = UipUdpConn {
        ripaddr: uip_ipaddr(192, 168, 0, 9),
        lport: htons(1234u16),
        rport: htons(4321u16),
        ttl: 64 as byte,
        appstate: 0u16
    };
    const frame: UipUdpipHdr = UipUdpipHdr {
        vtc: 0 as byte,
        tcflow: 0 as byte,
        flow: 0u16,
        len: [0 as byte, 0 as byte],
        proto: 0 as byte,
        ttl: 0 as byte,
        srcipaddr: [conn.ripaddr.words[0], conn.ripaddr.words[1]],
        destipaddr: [0u16, 0u16],
        srcport: htons(4321u16),
        destport: htons(1234u16),
        udplen: 0u16,
        udpchksum: 0u16
    };
    try assert_eq_bool(udp_matches_conn(&conn, &frame), true);
}

test "udp_find_conn returns matching index" {
    var state: UipState = UipState {
        listenports: [0u16: 20],
        conns: [UipConn {
            ripaddr: UipIpAddr { words: [0u16, 0u16] },
            lport: 0u16,
            rport: 0u16,
            rcv_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            snd_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            len: 0u16,
            mss: 0u16,
            initialmss: 0u16,
            sa: 0 as byte,
            sv: 0 as byte,
            rto: 0 as byte,
            tcpstateflags: 0 as byte,
            timer: 0 as byte,
            nrtx: 0 as byte,
            appstate: 0u16
        }: 10],
        udp_conns: [UipUdpConn {
            ripaddr: UipIpAddr { words: [0u16, 0u16] },
            lport: 0u16,
            rport: 0u16,
            ttl: 0 as byte,
            appstate: 0u16
        }: 10],
        acc32: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        flags: 0 as byte,
        len: 0u16,
        lastport: 0u16
    };
    state.udp_conns[1].lport = htons(1234u16);
    state.udp_conns[1].rport = htons(4321u16);
    state.udp_conns[1].ripaddr = uip_ipaddr(192, 168, 0, 9);
    const frame: UipUdpipHdr = UipUdpipHdr {
        vtc: 0 as byte,
        tcflow: 0 as byte,
        flow: 0u16,
        len: [0 as byte, 0 as byte],
        proto: 0 as byte,
        ttl: 0 as byte,
        srcipaddr: [state.udp_conns[1].ripaddr.words[0], state.udp_conns[1].ripaddr.words[1]],
        destipaddr: [0u16, 0u16],
        srcport: htons(4321u16),
        destport: htons(1234u16),
        udplen: 0u16,
        udpchksum: 0u16
    };
    try assert_eq_i32(udp_find_conn(&state, &frame), 1);
}

