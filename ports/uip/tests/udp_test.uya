    const frame: UipUdpipHdr = UipUdpipHdr {
        vtc: 0 as byte,
        tcflow: 0 as byte,
        flow: 0u16,
        len: [0 as byte, 0 as byte],
        proto: 0 as byte,
        ttl: 0 as byte,
        srcipaddr: [0u16, 0u16],
        destipaddr: [0u16, 0u16],
        srcport: htons(7777u16),
        destport: htons(9999u16),
        udplen: 0u16,
        udpchksum: 0u16
    };
    const result: UipProcessResult = udp_input_step(&state, &rt, &frame, 12u16);
    try assert_eq_i32(result.flags as i32, 0);
    try assert_eq_bool(result.appcall, false);
    try assert_eq_i32(rt.current_udp_conn, -1);
    try assert_eq_i32(rt.len as i32, 0);
}

test "udp_send_step fills header for connection 1 basic" {
    var rt: UipRuntime = UipRuntime {
        frame: UipFrame {
            ethip: EthIpHdr {
                ethhdr: UipEthHdr {
                    dest: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    src: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    type: 0u16
                },
                vhl: 0 as byte,
                tos: 0 as byte,
                len: [0 as byte, 0 as byte],
                ipid: [0 as byte, 0 as byte],
                ipoffset: [0 as byte, 0 as byte],
                ttl: 0 as byte,
                proto: 0 as byte,
                ipchksum: 0u16,
