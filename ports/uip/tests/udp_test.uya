    const frame: UipUdpipHdr = UipUdpipHdr {
        vtc: 0 as byte,
        tcflow: 0 as byte,
        flow: 0u16,
        len: [0 as byte, 0 as byte],
        proto: 0 as byte,
        ttl: 0 as byte,
        srcipaddr: [0u16, 0u16],
        destipaddr: [0u16, 0u16],
        srcport: htons(7777u16),
        destport: htons(1234u16),
        udplen: 0u16,
        udpchksum: 0u16
    };
    const result: UipProcessResult = udp_input_step(&state, &rt, &frame, 12u16);
    try assert_eq_i32(result.flags as i32, UIP_NEWDATA);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(rt.current_udp_conn, 0);
    try assert_eq_i32(rt.len as i32, 12);
}

