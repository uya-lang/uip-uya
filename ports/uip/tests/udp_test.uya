        slen: 0u16,
        flags: 0 as byte,
        current_conn: 0,
        current_udp_conn: 0,
        payload_view: &rt.frame.ethip.ethhdr.dest.addr[0],
        payload_len: 0u16,
        input_view: &rt.frame.ethip.ethhdr.dest.addr[0],
        input_len: 0u16,
        app_input: &rt.frame.ethip.ethhdr.dest.addr[0],
        app_input_len: 0u16,
        app_output: &rt.frame.ethip.ethhdr.dest.addr[0],
        uip_len: 0u16,
        uip_slen: 0u16,
        logbuf: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16],
        logcount: 0usize,
        logcode: 0 as byte,
        logparam: 0u16,
        logs: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16],
        ipid: 0u16,
        stats: &stats,
        te_reply: false
    };
    rt.hostaddr = uip_ipaddr(192, 168, 0, 2);
    var state: UipState = UipState {
        listener_ports: [0u16: 10],
        conns: [UipConn {
            ripaddr: [0u16, 0u16],
            lport: 0u16,
            rport: 0u16,
            rcv_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            snd_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            len: 0u16,
            mss: 0u16,
            initialmss: 0u16,
            sa: 0 as byte,
            sv: 0 as byte,
            rto: 0 as byte,
            tcpstateflags: 0 as byte,
            timer: 0 as byte,
            nrtx: 0 as byte,
            appstate: 0u16
        }: 10],
        udp_conns: [UipUdpConn {
            ripaddr: [0u16, 0u16],
            lport: 0u16,
            rport: 0u16,
            ttl: 0 as byte,
            appstate: 0u16
        }: 10],
        hostaddr: UipIpAddr { words: [0u16, 0u16] },
        stats: UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } },
        iss: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        lastport: 0u16
    };
    state.udp_conns[0].ripaddr[0] = uip_ipaddr(192, 168, 0, 9).words[0];
    state.udp_conns[0].ripaddr[1] = uip_ipaddr(192, 168, 0, 9).words[1];
    state.udp_conns[0].lport = htons(1234u16);
    state.udp_conns[0].rport = htons(4321u16);
    state.udp_conns[0].ttl = 64 as byte;
    const result: UipProcessResult = udp_send_step(&state, &rt, 0, 12u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(rt.frame.ethudp.srcport as i32, htons(1234u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.destport as i32, htons(4321u16) as i32);
    try assert_eq_i32(rt.frame.ethudp.udplen as i32, htons(20u16) as i32);
    try assert_eq_i32(rt.len as i32, 40);
}
