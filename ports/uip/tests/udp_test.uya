                vhl: 0 as byte,
                tos: 0 as byte,
                len: [0 as byte, 0 as byte],
                ipid: [0 as byte, 0 as byte],
                ipoffset: [0 as byte, 0 as byte],
                ttl: 0 as byte,
                proto: 0 as byte,
                ipchksum: 0u16,
                srcipaddr: [0u16, 0u16],
                destipaddr: [0u16, 0u16],
                srcport: 0u16,
                destport: 0u16,
                seqno: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
                ackno: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
                tcpoffset: 0 as byte,
                flags: 0 as byte,
                wnd: [0 as byte, 0 as byte],
