use std.testing;

extern fn udp_matches_conn(conn: &UipUdpConn, frame: &UipUdpipHdr) bool;
extern fn udp_find_conn(state: &UipState, frame: &UipUdpipHdr) i32;
extern fn udp_input_step(state: &UipState, rt: &UipRuntime, frame: &UipUdpipHdr, payload_len: u16) UipProcessResult;
extern fn udp_send_step(state: &UipState, rt: &UipRuntime, conn_index: i32, payload_len: u16) UipProcessResult;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn htons(val: u16) u16;
extern fn uip_process_core(state: &UipState, rt: &UipRuntime, flag: i32, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult;

extern const UIP_NEWDATA: i32;
extern const UIP_UDP_TIMER: i32;
extern const UIP_POLL: i32;
extern const UIP_PROTO_TCP: i32;
extern const TCP_ACK: i32;

struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }

test "udp_input_step miss resets current selection to invalid and clears len" {
    var rt: UipRuntime = make_runtime();
    var state: UipState = make_state();
    rt.current_udp_conn = 6;
    rt.len = 33u16;
    var frame: UipUdpipHdr = UipUdpipHdr { vtc: 0 as byte, tcflow: 0 as byte, flow: 0u16, len: [0 as byte,0 as byte], proto: 0 as byte, ttl: 0 as byte, srcipaddr: [uip_ipaddr(10 as byte, 0 as byte, 0 as byte, 7 as byte).words[0], uip_ipaddr(10 as byte, 0 as byte, 0 as byte, 7 as byte).words[1]], destipaddr: [0u16,0u16], srcport: htons(1234u16), destport: htons(4321u16), udplen: 0u16, udpchksum: 0u16 };
    const result: UipProcessResult = udp_input_step(&state, &rt, &frame, 12u16);
    try assert_eq_bool(result.appcall, false);
    try assert_eq_i32(rt.current_udp_conn as i32, -1);
    try assert_eq_i32(rt.len as i32, 0);
    try assert_eq_i32(rt.stats.udp.drop as i32, 1);
}


