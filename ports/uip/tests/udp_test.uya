            lport: 0u16,
            rport: 0u16,
            ttl: 0 as byte,
            appstate: 0u16
        }: 10],
        acc32: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        flags: 0 as byte,
        len: 0u16,
        lastport: 0u16
    };
