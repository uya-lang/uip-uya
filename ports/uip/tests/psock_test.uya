}

test "psock_event_from_process_result keeps poll rexmit timed_out bits in bridge event" {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: true, timed_out: true, retransmit: true, appcall: false, closed: false, logged: false, urgdata: false };
    var rt: UipRuntimeEventBridge = UipRuntimeEventBridge { flags: 0 as byte, len: 0u16, slen: 0u16 };
    const ev: PsockEvent = psock_event_from_process_result(&result, &rt);
    try assert_eq_bool(ev.polled, true);
    try assert_eq_bool(ev.timed_out, true);
    try assert_eq_bool(ev.rexmit, true);
    try assert_eq_bool(ev.connected, false);
}

test "psock_event_from_uip maps runtime flags to psock event bits" {
    const ev: PsockEvent = psock_event_from_uip(((1 | 2 | 4 | 16) as! byte).value, 7u16, 5u16);
    try assert_eq_bool(ev.acked, true);
    try assert_eq_bool(ev.newdata, true);
    try assert_eq_bool(ev.rexmit, true);
    try assert_eq_bool(ev.closed, true);
    try assert_eq_i32(ev.data_len as i32, 7);
    try assert_eq_i32(ev.send_len as i32, 5);
}


test "psock_apply_event marks acked read rexmit and close transitions conservatively" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 2u16, false, false);
    var ack_ev: PsockEvent = psock_event_from_uip((1 as! byte).value, 0u16, 0u16);
    psock_apply_event(&ps, &ack_ev);
    try assert_eq_i32(ps.state as i32, 1);
    var data_ev: PsockEvent = psock_event_from_uip((2 as! byte).value, 3u16, 0u16);
    psock_apply_event(&ps, &data_ev);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_READ);
    var rexmit_ev: PsockEvent = psock_event_from_uip((4 as! byte).value, 0u16, 5u16);
    ps.sendlen = 5u16;
    psock_apply_event(&ps, &rexmit_ev);
    try assert_eq_i32(ps.state as i32, 6);
    var close_ev: PsockEvent = psock_event_from_uip((16 as! byte).value, 0u16, 0u16);
    psock_apply_event(&ps, &close_ev);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
}

test "psock_apply_event prioritizes close then rexmit then ack then newdata" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 2u16, false, false);
    ps.sendlen = 5u16;
    var combined: PsockEvent = psock_event_from_uip(((1 | 2 | 4) as! byte).value, 3u16, 5u16);
    psock_apply_event(&ps, &combined);
    try assert_eq_i32(ps.state as i32, 6);
    var close_combined: PsockEvent = psock_event_from_uip(((1 | 2 | 4 | 16) as! byte).value, 3u16, 5u16);
    psock_apply_event(&ps, &close_combined);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
}

test "psock_apply_event timed_out with pending send and read clears runtime pointers but preserves send length" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 2u16, false, false);
    ps.readptr = &storage[0];
    ps.readlen = 3u16;
    var ev: PsockEvent = PsockEvent { acked: false, newdata: true, rexmit: false, closed: false, polled: false, timed_out: true, aborted: false, connected: false, data_len: 3u16, send_len: 5u16 };
    psock_apply_event(&ps, &ev);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(ps.sendlen as i32, 5);
    try assert_eq_i32(@usize_from_ptr(ps.sendptr as &void) as i32, 0);
    try assert_eq_i32(@usize_from_ptr(ps.readptr as &void) as i32, 0);
    try assert_eq_i32(ps.readlen as i32, 0);
}

test "psock_generator_send_from_event aborted closes like closed event" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    var send_ev: PsockEvent = psock_event_from_uip(0 as byte, 0u16, 6u16);
    _ = psock_generator_send_from_event(&ps, &send_ev, 6u16, 4u16);
    var ev: PsockEvent = PsockEvent { acked: false, newdata: false, rexmit: true, closed: false, polled: false, timed_out: false, aborted: true, connected: false, data_len: 0u16, send_len: 6u16 };
    try assert_eq_i32(psock_generator_send_from_event(&ps, &ev, 6u16, 4u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(@usize_from_ptr(ps.sendptr as &void) as i32, 0);
    try assert_eq_i32(ps.sendlen as i32, 6);
}

test "psock_send_from_event drives send state directly from runtime event" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    var send_ev: PsockEvent = psock_event_from_uip(0 as byte, 0u16, 5u16);
    try assert_eq_i32(psock_send_from_event(&ps, &send_ev, &payload[0], 2u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 5);
    var ack_ev: PsockEvent = psock_event_from_uip((1 as! byte).value, 0u16, 5u16);
    try assert_eq_i32(psock_send_from_event(&ps, &ack_ev, &payload[0], 2u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 3);
}



