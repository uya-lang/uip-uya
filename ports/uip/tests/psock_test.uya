use std.testing;

extern fn psock_init(psock: &Psock, buffer: &byte, buffersize: usize) void;
extern fn psock_datalen(psock: &Psock) u16;
extern fn psock_newdata(psock: &Psock) bool;
extern fn psock_generator_refresh(psock: &Psock, generated_len: u16) void;
extern fn psock_generator_send(psock: &Psock, generated_len: u16, mss: u16, rexmit: bool, acked: bool) byte;
extern fn psock_close(psock: &Psock) void;
extern fn psock_exit(psock: &Psock) byte;
extern fn psock_close_exit(psock: &Psock) byte;
extern fn psock_readbuf(psock: &Psock, input: &byte, input_len: u16) byte;
extern fn psock_readto(psock: &Psock, endmarker: byte, input: &byte, input_len: u16) byte;
extern fn psock_event_from_uip(flags: byte, len: u16, slen: u16) PsockEvent;
extern fn psock_event_from_runtime_bridge(rt: &UipRuntimeEventBridge) PsockEvent;
extern fn psock_event_from_process_result(result: &UipProcessResult, rt: &UipRuntimeEventBridge) PsockEvent;
extern fn psock_apply_event(psock: &Psock, event: &PsockEvent) void;
extern fn psock_send_from_event(psock: &Psock, event: &PsockEvent, buf: &byte, mss: u16) byte;
extern fn psock_generator_send_from_event(psock: &Psock, event: &PsockEvent, generated_len: u16, mss: u16) byte;
extern fn psock_readbuf_from_event(psock: &Psock, event: &PsockEvent, input: &byte) byte;
extern fn psock_readto_from_event(psock: &Psock, event: &PsockEvent, endmarker: byte, input: &byte) byte;

extern const PT_ENDED: i32;
extern const PT_EXITED: i32;

extern const PSOCK_STATE_READ: i32;
extern const PSOCK_STATE_BLOCKED_NEWDATA: i32;
extern const PSOCK_STATE_BLOCKED_CLOSE: i32;

struct Pt {
    lc: u16,
    yielded: bool,
    waiting: bool,
    exit_requested: bool,
    restart_requested: bool,
    spawned: bool
}

struct PsockBuf {
    ptr: &byte,
    left: u16
}

struct Psock {
    pt: Pt,
    psockpt: Pt,
    sendptr: &byte,
    readptr: &byte,
    bufptr: &byte,
    sendlen: u16,
    readlen: u16,
    event_readlen: u16,
    buf: PsockBuf,
    bufsize: usize,
    state: byte,
    lastlen: u16
}

struct PsockEvent {
    acked: bool,
    newdata: bool,
    rexmit: bool,
    closed: bool,
    polled: bool,
    timed_out: bool,
    aborted: bool,
    connected: bool,
    data_len: u16,
    send_len: u16
}

struct UipProcessResult {
    flags: byte,
    len: u16,
    poll: bool,
    timed_out: bool,
    retransmit: bool,
    appcall: bool,
    closed: bool,
    logged: bool,
    urgdata: bool
}

struct UipRuntimeEventBridge {
    flags: byte,
    len: u16,
    slen: u16
}

test "psock_event_from_runtime_bridge keeps ack newdata and send length" {
    var rt: UipRuntimeEventBridge = UipRuntimeEventBridge { flags: ((1 | 2) as! byte).value, len: 4u16, slen: 6u16 };
    const ev: PsockEvent = psock_event_from_runtime_bridge(&rt);
    try assert_eq_bool(ev.acked, true);
    try assert_eq_bool(ev.newdata, true);
    try assert_eq_i32(ev.data_len as i32, 4);
    try assert_eq_i32(ev.send_len as i32, 6);
}

test "psock_event_from_process_result marks connected only for pure appcall with no payload or close" {
    var result: UipProcessResult = UipProcessResult { flags: 0 as byte, len: 0u16, poll: false, timed_out: false, retransmit: false, appcall: true, closed: false, logged: false, urgdata: false };
    var rt: UipRuntimeEventBridge = UipRuntimeEventBridge { flags: 0 as byte, len: 0u16, slen: 0u16 };
    const ev: PsockEvent = psock_event_from_process_result(&result, &rt);
    try assert_eq_bool(ev.connected, true);
    try assert_eq_bool(ev.closed, false);
    try assert_eq_bool(ev.newdata, false);
}


test "psock_generator_refresh resets pointer to regenerated buffer" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_generator_send(&ps, 6u16, 4u16, false, false);
    _ = psock_generator_send(&ps, 6u16, 4u16, false, true);
    try assert_eq_i32(ps.sendlen as i32, 2);
    psock_generator_refresh(&ps, 6u16);
    try assert_eq_i32(ps.sendlen as i32, 6);
    try assert_eq_i32(@usize_from_ptr(ps.sendptr as &void) as i32, @usize_from_ptr(ps.bufptr as &void) as i32);
}

test "psock_init wires buffer and clears lengths" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 1u16, yielded: true, waiting: false, exit_requested: false, restart_requested: false }, psockpt: Pt { lc: 2u16, yielded: true, waiting: false, exit_requested: false, restart_requested: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 9u16, readlen: 8u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 7u16 }, bufsize: 0, state: 3 as byte, lastlen: 5u16 };
    psock_init(&ps, &storage[0], 8);
    try assert_eq_i32(ps.sendlen as i32, 0);
    try assert_eq_i32(ps.readlen as i32, 0);
    try assert_eq_i32(ps.buf.left as i32, 8);
    try assert_eq_i32(ps.bufsize as i32, 8);
}

test "psock_newdata does not treat buffered bytes alone as fresh event data" {
    var storage: [byte: 4] = [0: 4];
    var ps: Psock = Psock {
        pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16,
        buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16
    };
    psock_init(&ps, &storage[0], 4);
    storage[0] = 65 as byte;
    storage[1] = 66 as byte;
    ps.buf.left = 2u16;
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    try assert_eq_bool(psock_newdata(&ps), false);
}


test "psock_send acked state continues with remaining payload instead of restarting" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 2u16, false, false);
    _ = psock_send(&ps, &payload[0], 5u16, 2u16, false, true);
    try assert_eq_i32(ps.sendlen as i32, 3);
    try assert_eq_i32(psock_send(&ps, &payload[0], 5u16, 2u16, false, false) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 3);
    try assert_eq_i32(ps.lastlen as i32, 2);
}

test "psock_send waits for ack and only ends after final chunk" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    try assert_eq_i32(psock_send(&ps, &payload[0], 5u16, 2u16, false, false) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 5);
    try assert_eq_i32(ps.lastlen as i32, 2);
    try assert_eq_i32(psock_send(&ps, &payload[0], 5u16, 2u16, false, true) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 3);
    try assert_eq_i32(psock_send(&ps, &payload[2], 3u16, 2u16, false, true) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 1);
    try assert_eq_i32(psock_send(&ps, &payload[4], 1u16, 2u16, false, true) as i32, PT_ENDED);
    try assert_eq_i32(ps.sendlen as i32, 0);
}

test "psock_readbuf zero input after partial data preserves read state" {
    var storage: [byte: 4] = [0: 4];
    var input: [byte: 2] = [41, 42];
    var ps: Psock = Psock {
        pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16,
        buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16
    };
    psock_init(&ps, &storage[0], 4);
    try assert_eq_i32(psock_readbuf(&ps, &input[0], 2u16) as i32, PT_WAITING);
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_NEWDATA);
    try assert_eq_i32(psock_readbuf(&ps, &input[0], 0u16) as i32, PT_WAITING);
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_NEWDATA);
}

test "psock_readbuf fills configured buffer and waits when more network data remains" {
    var storage: [byte: 4] = [0: 4];
    var input: [byte: 6] = [10, 11, 12, 13, 14, 15];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    try assert_eq_i32(psock_readbuf(&ps, &input[0], 6u16) as i32, PT_ENDED);
    try assert_eq_i32(storage[0] as i32, 10);
    try assert_eq_i32(storage[3] as i32, 13);
    try assert_eq_i32(psock_datalen(&ps) as i32, 4);
    try assert_eq_i32(ps.readlen as i32, 2);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_READ);
}

test "psock_readto_from_event marker at first byte reports one visible byte" {
    var storage: [byte: 8] = [0: 8];
    var input: [byte: 3] = [10, 65, 66];
    var ps: Psock = Psock {
        pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16,
        buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16
    };
    psock_init(&ps, &storage[0], 8);
    var ev: PsockEvent = PsockEvent { acked: false, newdata: true, rexmit: false, closed: false, polled: false, timed_out: false, aborted: false, connected: false, data_len: 3u16, send_len: 0u16 };
    try assert_eq_i32(psock_readto_from_event(&ps, &ev, 10 as byte, &input[0]) as i32, PT_ENDED);
    try assert_eq_i32(ps.event_readlen as i32, 1);
    try assert_eq_i32(storage[0] as i32, 10);
}


test "psock_generator_send waits then advances after final ack" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    try assert_eq_i32(psock_generator_send(&ps, 6u16, 4u16, false, false) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 6);
    try assert_eq_i32(ps.lastlen as i32, 4);
    try assert_eq_i32(psock_generator_send(&ps, 6u16, 4u16, false, true) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 2);
    try assert_eq_i32(psock_generator_send(&ps, 6u16, 4u16, false, true) as i32, PT_ENDED);
    try assert_eq_i32(ps.sendlen as i32, 0);
}

test "psock_send retransmit keeps pending send active" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 3u16, false, false);
    try assert_eq_i32(psock_send(&ps, &payload[0], 5u16, 3u16, true, false) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 5);
    try assert_eq_i32(ps.lastlen as i32, 3);
}

test "psock_generator_send ack plus rexmit should prefer retransmit and preserve full generated payload" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_generator_send(&ps, 6u16, 4u16, false, false);
    _ = psock_generator_send(&ps, 6u16, 4u16, false, true);
    try assert_eq_i32(ps.sendlen as i32, 2);
    try assert_eq_i32(psock_generator_send(&ps, 6u16, 4u16, true, true) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 6);
    try assert_eq_i32(ps.lastlen as i32, 4);
    try assert_eq_i32(@usize_from_ptr(ps.sendptr as &void) as i32, @usize_from_ptr(ps.bufptr as &void) as i32);
}

test "psock_apply_event zero-length newdata blocks instead of staying in read state" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    ps.state = (PSOCK_STATE_READ as! byte).value;
    var ev: PsockEvent = PsockEvent { acked: false, newdata: true, rexmit: false, closed: false, polled: false, timed_out: false, aborted: false, connected: false, data_len: 0u16, send_len: 0u16 };
    psock_apply_event(&ps, &ev);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_NEWDATA);
}

test "psock_apply_event ack preserves pending send until send path consumes ack" {
    var storage: [byte: 8] = [0: 8];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 2u16 };
    psock_init(&ps, &storage[0], 8);
    var payload: [byte: 3] = [1, 2, 3];
    _ = psock_send(&ps, &payload[0], 3u16, 2u16, false, false);
    var ev: PsockEvent = PsockEvent { acked: true, newdata: false, rexmit: false, closed: false, polled: false, timed_out: false, aborted: false, connected: false, data_len: 0u16, send_len: 0u16 };
    psock_apply_event(&ps, &ev);
    try assert_eq_i32(ps.sendlen as i32, 3);
}

test "psock_send_from_event acked event consumes one pending send chunk" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 3u16, false, false);
    var ev: PsockEvent = PsockEvent { acked: true, newdata: false, rexmit: false, closed: false, polled: false, timed_out: false, aborted: false, connected: false, data_len: 0u16, send_len: 5u16 };
    try assert_eq_i32(psock_send_from_event(&ps, &ev, &payload[0], 3u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 2);
}

test "psock_send_from_event closed event closes socket and suppresses payload" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 4] = [1, 2, 3, 4];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    var ev: PsockEvent = PsockEvent { acked: false, newdata: false, rexmit: false, closed: true, polled: false, timed_out: false, aborted: false, connected: false, data_len: 0u16, send_len: 4u16 };
    try assert_eq_i32(psock_send_from_event(&ps, &ev, &payload[0], 4u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(ps.sendlen as i32, 0);
}

test "psock_close marks blocked close state" {
    var storage: [byte: 4] = [0: 4];
    var ps: Psock = Psock { pt: Pt { lc: 7u16, yielded: true, waiting: true, exit_requested: false, restart_requested: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    psock_close(&ps);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
}

test "psock_exit closes and exits protothread" {
    var storage: [byte: 4] = [0: 4];
    var ps: Psock = Psock { pt: Pt { lc: 7u16, yielded: true, waiting: true, exit_requested: false, restart_requested: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    try assert_eq_i32(psock_exit(&ps) as i32, PT_EXITED);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(ps.pt.lc as i32, 0);
}

test "psock_exit clears pending runtime pointers and marks protothread exited" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 5] = [1, 2, 3, 4, 5];
    var ps: Psock = Psock { pt: Pt { lc: 7u16, yielded: true, waiting: true, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 3u16, yielded: false, waiting: true, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 5u16, 2u16, false, false);
    ps.readptr = &storage[0];
    ps.readlen = 3u16;
    try assert_eq_i32(psock_exit(&ps) as i32, PT_EXITED);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(@usize_from_ptr(ps.sendptr as &void) as i32, 0);
    try assert_eq_i32(@usize_from_ptr(ps.readptr as &void) as i32, 0);
    try assert_eq_i32(ps.readlen as i32, 0);
    try assert_eq_i32(ps.pt.lc as i32, 0);
}

