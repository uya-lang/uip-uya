    var storage: [byte: 4] = [0: 4];
    var input: [byte: 4] = [10, 11, 12, 13];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    var close_data_ev: PsockEvent = psock_event_from_uip(((2 | 16) as! byte).value, 4u16, 0u16);
    try assert_eq_i32(psock_readbuf_from_event(&ps, &close_data_ev, &input[0]) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(psock_datalen(&ps) as i32, 0);
}


test "psock_readto_from_event close with newdata clears unread pointer and does not consume payload" {
    var storage: [byte: 8] = [0: 8];
    var input: [byte: 3] = [65, 10, 66];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    var close_data_ev: PsockEvent = psock_event_from_uip(((2 | 16) as! byte).value, 3u16, 0u16);
    try assert_eq_i32(psock_readto_from_event(&ps, &close_data_ev, 10 as byte, &input[0]) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_CLOSE);
    try assert_eq_i32(psock_datalen(&ps) as i32, 0);
    try assert_eq_i32(ps.readlen as i32, 0);
    try assert_eq_i32(@usize_from_ptr(ps.readptr as &void) as i32, 0);
}

test "psock_apply_event ack without data_sent does not falsely enter acked state" {
    var storage: [byte: 4] = [0: 4];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    var ack_ev: PsockEvent = psock_event_from_uip((1 as! byte).value, 0u16, 0u16);
    psock_apply_event(&ps, &ack_ev);
    try assert_eq_i32(ps.state as i32, 0);
}
