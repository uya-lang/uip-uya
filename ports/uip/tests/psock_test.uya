test "psock_send rexmit then ack advances exactly one mss chunk" {
    var storage: [byte: 8] = [0: 8];
    var payload: [byte: 6] = [1, 2, 3, 4, 5, 6];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    _ = psock_send(&ps, &payload[0], 6u16, 2u16, false, false);
    _ = psock_send(&ps, &payload[0], 6u16, 2u16, true, false);
    try assert_eq_i32(ps.sendlen as i32, 6);
    try assert_eq_i32(ps.lastlen as i32, 2);
    try assert_eq_i32(psock_send(&ps, &payload[0], 6u16, 2u16, false, true) as i32, PT_WAITING);
    try assert_eq_i32(ps.sendlen as i32, 4);
    try assert_eq_i32(ps.lastlen as i32, 2);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_DATA_SENT);
}


test "psock_readbuf resumes across multiple input callbacks until buffer fills" {
    var storage: [byte: 5] = [0: 5];
    var input1: [byte: 2] = [11, 12];
    var input2: [byte: 3] = [13, 14, 15];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 5);
    try assert_eq_i32(psock_readbuf(&ps, &input1[0], 2u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_NEWDATA);
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    try assert_eq_i32(psock_readbuf(&ps, &input2[0], 3u16) as i32, PT_ENDED);
    try assert_eq_i32(ps.sendlen as i32, 0);
    try assert_eq_i32(ps.lastlen as i32, 3);
    try assert_eq_i32(storage[0] as i32, 11);
    try assert_eq_i32(storage[4] as i32, 15);
}

test "psock_readbuf resumed callback should leave completed buffer visible when full" {
    var storage: [byte: 5] = [0: 5];
    var input1: [byte: 2] = [11, 12];
    var input2: [byte: 3] = [13, 14, 15];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 5);
    _ = psock_readbuf(&ps, &input1[0], 2u16);
    try assert_eq_i32(psock_readbuf(&ps, &input2[0], 3u16) as i32, PT_ENDED);
    try assert_eq_i32(ps.state as i32, 0);
    try assert_eq_i32(ps.readlen as i32, 0);
    try assert_eq_bool(psock_newdata(&ps), false);
}

test "psock_readto resumes across callbacks and ends when marker arrives later" {
    var storage: [byte: 8] = [0: 8];
    var input1: [byte: 3] = [65, 66, 67];
    var input2: [byte: 3] = [68, 10, 69];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    try assert_eq_i32(psock_readto(&ps, 10 as byte, &input1[0], 3u16) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_READ);
    try assert_eq_i32(ps.lastlen as i32, 3);
    try assert_eq_i32(psock_readto(&ps, 10 as byte, &input2[0], 3u16) as i32, PT_ENDED);
    try assert_eq_i32(ps.state as i32, 0);
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    try assert_eq_i32(storage[0] as i32, 68);
    try assert_eq_i32(storage[1] as i32, 10);
}

