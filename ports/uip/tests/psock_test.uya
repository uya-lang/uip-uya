test "psock_readbuf_from_event accumulates segmented input into one logical buffer" {
    var storage: [byte: 4] = [0: 4];
    var input1: [byte: 2] = [10, 11];
    var input2: [byte: 2] = [12, 13];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    var ev1: PsockEvent = psock_event_from_uip((2 as! byte).value, 2u16, 0u16);
    try assert_eq_i32(psock_readbuf_from_event(&ps, &ev1, &input1[0]) as i32, PT_WAITING);
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    var ev2: PsockEvent = psock_event_from_uip((2 as! byte).value, 2u16, 0u16);
    try assert_eq_i32(psock_readbuf_from_event(&ps, &ev2, &input2[0]) as i32, PT_ENDED);
    try assert_eq_i32(psock_datalen(&ps) as i32, 4);
    try assert_eq_i32(storage[0] as i32, 10);
    try assert_eq_i32(storage[1] as i32, 11);
    try assert_eq_i32(storage[2] as i32, 12);
    try assert_eq_i32(storage[3] as i32, 13);
}

test "psock_readbuf_from_event and psock_readto_from_event consume runtime-delivered input" {
    var storage1: [byte: 4] = [0: 4];
    var input1: [byte: 4] = [10, 11, 12, 13];
    var ps1: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps1, &storage1[0], 4);
    var read_ev: PsockEvent = psock_event_from_uip((2 as! byte).value, 4u16, 0u16);
    try assert_eq_i32(psock_readbuf_from_event(&ps1, &read_ev, &input1[0]) as i32, PT_ENDED);
    try assert_eq_i32(storage1[0] as i32, 10);
    try assert_eq_i32(storage1[3] as i32, 13);

    var storage2: [byte: 8] = [0: 8];
    var input2: [byte: 3] = [65, 10, 66];
    var ps2: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps2, &storage2[0], 8);
    var line_ev: PsockEvent = psock_event_from_uip((2 as! byte).value, 3u16, 0u16);
    try assert_eq_i32(psock_readto_from_event(&ps2, &line_ev, 10 as byte, &input2[0]) as i32, PT_ENDED);
    try assert_eq_i32(storage2[0] as i32, 65);
    try assert_eq_i32(storage2[1] as i32, 10);
}



test "psock_readto_from_event keeps current-segment datalen until endmarker arrives" {
    var storage: [byte: 8] = [0: 8];
    var input1: [byte: 2] = [65, 66];
    var input2: [byte: 2] = [67, 10];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 8);
    var ev1: PsockEvent = psock_event_from_uip((2 as! byte).value, 2u16, 0u16);
    try assert_eq_i32(psock_readto_from_event(&ps, &ev1, 10 as byte, &input1[0]) as i32, PT_WAITING);
    try assert_eq_i32(psock_datalen(&ps) as i32, 2);
    var ev2: PsockEvent = psock_event_from_uip((2 as! byte).value, 2u16, 0u16);
    try assert_eq_i32(psock_readto_from_event(&ps, &ev2, 10 as byte, &input2[0]) as i32, PT_ENDED);
    try assert_eq_i32(psock_datalen(&ps) as i32, 4);
    try assert_eq_i32(storage[0] as i32, 65);
    try assert_eq_i32(storage[1] as i32, 66);
    try assert_eq_i32(storage[2] as i32, 67);
    try assert_eq_i32(storage[3] as i32, 10);
}

