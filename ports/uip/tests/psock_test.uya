test "psock_readbuf empty input enters blocked newdata without restarting child protothread" {
    var storage: [byte: 4] = [0: 4];
    var input: [byte: 1] = [0];
    var ps: Psock = Psock { pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false }, psockpt: Pt { lc: 7u16, yielded: true, waiting: true, exit_requested: false, restart_requested: false, spawned: true }, sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16, buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16 };
    psock_init(&ps, &storage[0], 4);
    ps.psockpt.lc = 7u16;
    ps.psockpt.yielded = true;
    ps.psockpt.waiting = true;
    ps.psockpt.spawned = true;
    try assert_eq_i32(psock_readbuf(&ps, &input[0], 0u16) as i32, PT_WAITING);
    try assert_eq_bool(ps.psockpt.restart_requested, false);
    try assert_eq_i32(ps.psockpt.lc as i32, 7);
    try assert_eq_bool(ps.psockpt.spawned, true);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_NEWDATA);
}

