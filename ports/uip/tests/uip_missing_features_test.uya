use std.testing;

extern fn uip_arp_ipin(state: &UipArpState, buf: &EthIpHdr, len: &u16) void;
extern fn uip_init(state: &UipState) void;
extern fn uip_listen(state: &UipState, port: u16) void;
extern fn uip_unlisten(state: &UipState, port: u16) void;
extern fn tcp_should_accept_syn(state: &UipState, frame: &UipRuntimeFrame) bool;
extern fn uip_runtime_init(rt: &UipRuntime) void;
extern fn uip_setipid(rt: &UipRuntime, id: u16) void;
extern fn uip_sethostaddr(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_gethostaddr(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_setdraddr(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_getdraddr(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_setnetmask(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_getnetmask(rt: &UipRuntime, addr: &UipIpAddr) void;
extern fn uip_prepare_poll(state: &UipState, rt: &UipRuntime, conn_index: i32) void;
extern fn uip_send(rt: &UipRuntime, data: &byte, len: u16) void;
extern fn uip_datalen(rt: &UipRuntime) u16;
extern fn uip_close_flag(rt: &UipRuntime) void;
extern fn uip_abort_flag(rt: &UipRuntime) void;
extern fn uip_stop(conn: &UipConn) void;
extern fn uip_stopped(conn: &UipConn) bool;
extern fn uip_restart(rt: &UipRuntime, conn: &UipConn) void;
extern fn uip_periodic(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult;
extern fn uip_periodic_conn(state: &UipState, rt: &UipRuntime, conn: &UipConn) UipProcessResult;
extern fn uip_poll_conn(state: &UipState, rt: &UipRuntime, conn: &UipConn) UipProcessResult;
extern fn uip_udp_periodic(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult;
extern fn uip_udp_periodic_conn(state: &UipState, rt: &UipRuntime, conn: &UipUdpConn) UipProcessResult;
extern fn uip_input(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_ack: bool, has_fin: bool, app_slen: u16) UipProcessResult;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn htons(val: u16) u16;
extern const UIP_POLL: i32;
extern const UIP_CLOSE: i32;
extern const UIP_ABORT: i32;
extern const UIP_NEWDATA: i32;

struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipRuntime { frame: UipRuntimeFrame, appdata: &byte, sappdata: &byte, len: u16, uip_len: u16, uip_slen: u16, flags: byte, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, stats: &UipStats, urgdata: &byte, urglen: u16, surglen: u16, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, slen: u16, logs: [UipRuntimeLog: 16], ipid: u16, te_reply: bool }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipState { listener_ports: [u16: 20], conns: [UipConn: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }
struct UipArpState { ethaddr: UipEthAddr, hostaddr: UipIpAddr, netmask: UipIpAddr, draddr: UipIpAddr, table: [ArpEntry: 8], arptime: byte }
struct ArpEntry { ipaddr: [u16: 2], ethaddr: UipEthAddr, time: byte }

fn make_zero_stats() UipStats {
    return UipStats {
        ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 }
    };
}

fn make_runtime() UipRuntime {
    var stats: UipStats = make_zero_stats();
    return UipRuntime { frame: UipRuntimeFrame { ethip: EthIpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] }, type: 0u16 }, vhl: 0x45 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16] }, ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, seqno: [0 as byte,0 as byte,0 as byte,0 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0x50 as byte, flags: 0 as byte, wnd: [0 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] }, ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 }, arp: ArpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, sipaddr: [0u16,0u16], dhwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, dipaddr: [0u16,0u16] } }, appdata: null, sappdata: null, len: 0u16, uip_len: 0u16, uip_slen: 0u16, flags: 0 as byte, hostaddr: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, stats: &stats, urgdata: null, urglen: 0u16, surglen: 0u16, logbuf: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], logcount: 0usize, logcode: 0 as byte, logparam: 0u16, current_conn: -1, current_udp_conn: -1, payload_view: null, payload_len: 0u16, input_view: null, input_len: 0u16, app_input: null, app_input_len: 0u16, app_output: null, slen: 0u16, logs: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], ipid: 0u16, te_reply: false };
}

fn make_state() UipState {
    var state: UipState = UipState {
        listener_ports: [0u16: 20],
        conns: [UipConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, rcv_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], snd_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], len: 0u16, mss: 0u16, initialmss: 0u16, sa: 0 as byte, sv: 0 as byte, rto: 0 as byte, tcpstateflags: 0 as byte, timer: 0 as byte, nrtx: 0 as byte, appstate: 0u16 }: 10],
        udp_conns: [UipUdpConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, ttl: 0 as byte, appstate: 0u16 }: 10],
        hostaddr: UipIpAddr { words: [0u16,0u16] },
        stats: make_zero_stats(),
        iss: [0 as byte,0 as byte,0 as byte,0 as byte],
        lastport: 0u16
    };
    return state;
}

test "uip_arp_ipin refreshes sender mapping from ipv4 frame" {
    var state: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 7 as byte };
    var len: u16 = (@size_of(EthIpHdr) as! u16).value;
    var hdr: EthIpHdr = EthIpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] }, type: 0u16 }, vhl: 0x45 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 64 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [uip_ipaddr(10 as byte,0 as byte,0 as byte,7 as byte).words[0], uip_ipaddr(10 as byte,0 as byte,0 as byte,7 as byte).words[1]], destipaddr: [0u16,0u16] };
    uip_arp_ipin(&state, &hdr, &len);
    try assert_eq_i32(state.table[0].ipaddr[0] as i32, hdr.srcipaddr[0] as i32);
    try assert_eq_i32(state.table[0].ethaddr.addr[0] as i32, 1);
}

test "uip_listen and syn accept scan all 20 listener slots" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    var i: i32 = 0;
    while i < 19 {
        uip_listen(&state, htons((1000 + i) as u16));
        i = i + 1;
    }
    const target: u16 = htons(4242u16);
    uip_listen(&state, target);
    try assert_eq_i32(state.listener_ports[19] as i32, target as i32);
    var frame: UipRuntimeFrame = rt.frame;
    frame.ethtcp.destport = target;
    frame.ethtcp.flags = 2 as byte;
    try assert_eq_bool(tcp_should_accept_syn(&state, &frame), true);
    uip_unlisten(&state, target);
    try assert_eq_bool(tcp_should_accept_syn(&state, &frame), false);
}

test "runtime setters, send and control flags update state" {
    var rt: UipRuntime = make_runtime();
    var addr: UipIpAddr = uip_ipaddr(192 as byte,168 as byte,1 as byte,9 as byte);
    var out: UipIpAddr = UipIpAddr { words: [0u16,0u16] };
    var payload: [byte: 3] = [1,2,3];
    uip_runtime_init(&rt);
    uip_setipid(&rt, 77u16);
    uip_sethostaddr(&rt, &addr);
    uip_gethostaddr(&rt, &out);
    try assert_eq_i32(rt.ipid as i32, 77);
    try assert_eq_i32(out.words[0] as i32, addr.words[0] as i32);
    uip_setdraddr(&rt, &addr);
    uip_getdraddr(&rt, &out);
    try assert_eq_i32(out.words[1] as i32, addr.words[1] as i32);
    uip_setnetmask(&rt, &addr);
    uip_getnetmask(&rt, &out);
    try assert_eq_i32(out.words[0] as i32, addr.words[0] as i32);
    uip_send(&rt, &payload[0], 3u16);
    rt.len = 9u16;
    try assert_eq_i32(uip_datalen(&rt) as i32, 9);
    uip_close_flag(&rt);
    try assert_eq_bool((rt.flags & (UIP_CLOSE as! byte).value) != 0 as byte, true);
    uip_abort_flag(&rt);
    try assert_eq_i32(rt.flags as i32, UIP_ABORT);
}

test "poll and periodic wrappers set current selection and flags" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_runtime_init(&rt);
    state.conns[0].lport = htons(1234u16);
    const polled: UipProcessResult = uip_poll_conn(&state, &rt, &state.conns[0]);
    try assert_eq_bool(polled.poll, true);
    try assert_eq_i32(rt.current_conn as i32, 0);
    try assert_eq_i32(rt.flags as i32, UIP_POLL);
    const periodic: UipProcessResult = uip_periodic_conn(&state, &rt, &state.conns[0]);
    try assert_eq_i32(rt.current_conn as i32, 0);
    try assert_eq_bool(periodic.closed, false);
}

test "udp periodic and input wrappers route through process core" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_runtime_init(&rt);
    const udp_result: UipProcessResult = uip_udp_periodic(&state, &rt, 2);
    try assert_eq_bool(udp_result.poll, true);
    try assert_eq_i32(rt.current_udp_conn as i32, 2);
    const input_result: UipProcessResult = uip_input(&state, &rt, -1, 0u16, false, false, 0u16);
    try assert_eq_i32(input_result.flags as i32, UIP_ABORT);
}

test "stop and restart helpers toggle stopped bit" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_stop(&state.conns[0]);
    try assert_eq_bool(uip_stopped(&state.conns[0]), true);
    uip_restart(&rt, &state.conns[0]);
    try assert_eq_bool(uip_stopped(&state.conns[0]), false);
    try assert_eq_bool((rt.flags & (UIP_NEWDATA as! byte).value) != 0 as byte, true);
}
