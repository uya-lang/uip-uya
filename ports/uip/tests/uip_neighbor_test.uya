use std.testing;

extern fn uip_neighbor_init(state: &UipNeighborState) void;
extern fn uip_neighbor_periodic(state: &UipNeighborState) void;
extern fn uip_neighbor_add(state: &UipNeighborState, ipaddr: &UipIpAddr, addr: &UipNeighborAddr) void;
extern fn uip_neighbor_lookup(state: &UipNeighborState, ipaddr: &UipIpAddr, out: &UipNeighborAddr) bool;
extern fn uip_ipv6_neighbor_ns_bridge(state: &UipNeighborState, ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr, lladdr: &UipNeighborAddr) byte;
extern const ICMP6_NS: i32;
extern const IPV6_ICMP6_REPLY_READY: i32;
extern const IPV6_ICMP6_DROP: i32;

struct UipIpv6Hdr { vtc: byte, tcflow: byte, flow: [byte: 2], len: [byte: 2], proto: byte, ttl: byte, srcipaddr: [u16: 8], destipaddr: [u16: 8] }
struct UipIcmp6NeighborHdr { type: byte, code: byte, icmpchksum: u16, flags: [byte: 4], targetipaddr: [u16: 8] }

struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipNeighborAddr { addr: UipEthAddr }
struct UipNeighborEntry { ipaddr: UipIpAddr, addr: UipNeighborAddr, time: byte }
struct UipNeighborState { entries: [UipNeighborEntry: 8] }
struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, appdata: &byte, sappdata: &byte, urgdata: &byte, len: u16, uip_len: u16, uip_slen: u16, slen: u16, urglen: u16, surglen: u16, flags: byte, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, logs: [UipRuntimeLog: 16], ipid: u16, stats: &UipStats, te_reply: bool }

fn mac(a: byte, b: byte, c: byte, d: byte, e: byte, f: byte) UipNeighborAddr {
    return UipNeighborAddr { addr: UipEthAddr { addr: [a, b, c, d, e, f] } };
}

test "uip_neighbor_init marks all entries unused" {
    var state: UipNeighborState = UipNeighborState {
        entries: [UipNeighborEntry {
            ipaddr: uip_ipaddr(1, 2, 3, 4),
            addr: mac(1 as byte, 1 as byte, 1 as byte, 1 as byte, 1 as byte, 1 as byte),
            time: 0 as byte
        }: 8]
    };
    uip_neighbor_init(&state);
    try assert_eq_i32(state.entries[0].time as i32, 128);
    try assert_eq_i32(state.entries[7].time as i32, 128);
}

test "uip_neighbor_add inserts into first free slot and lookup finds it" {
    var state: UipNeighborState = UipNeighborState {
        entries: [UipNeighborEntry {
            ipaddr: UipIpAddr { words: [0u16, 0u16] },
            addr: mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte),
            time: 0 as byte
        }: 8]
    };
    uip_neighbor_init(&state);
    const ip: UipIpAddr = uip_ipaddr(192, 168, 0, 9);
    const m: UipNeighborAddr = mac(1 as byte, 2 as byte, 3 as byte, 4 as byte, 5 as byte, 6 as byte);
    uip_neighbor_add(&state, &ip, &m);
    var out: UipNeighborAddr = mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte);
    try assert_eq_bool(uip_neighbor_lookup(&state, &ip, &out), true);
    try assert_eq_i32(out.addr.addr[0] as i32, 1);
    try assert_eq_i32(state.entries[0].time as i32, 0);
}

test "uip_neighbor_add refreshes existing entry instead of consuming new slot" {
    var state: UipNeighborState = UipNeighborState {
        entries: [UipNeighborEntry {
            ipaddr: UipIpAddr { words: [0u16, 0u16] },
            addr: mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte),
            time: 128 as byte
        }: 8]
    };
    uip_neighbor_init(&state);
    const ip: UipIpAddr = uip_ipaddr(192, 168, 0, 9);
    const m1: UipNeighborAddr = mac(1 as byte, 2 as byte, 3 as byte, 4 as byte, 5 as byte, 6 as byte);
    const m2: UipNeighborAddr = mac(9 as byte, 8 as byte, 7 as byte, 6 as byte, 5 as byte, 4 as byte);
    uip_neighbor_add(&state, &ip, &m1);
    state.entries[0].time = 5 as byte;
    state.entries[1].time = 128 as byte;
    uip_neighbor_add(&state, &ip, &m2);
    var out: UipNeighborAddr = mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte);
    try assert_eq_bool(uip_neighbor_lookup(&state, &ip, &out), true);
    try assert_eq_i32(out.addr.addr[0] as i32, 9);
    try assert_eq_i32(state.entries[0].time as i32, 0);
    try assert_eq_i32(state.entries[1].time as i32, 128);
}

test "uip_ipv6_neighbor_ns_bridge learns source and returns reply ready" {
    var state: UipNeighborState = UipNeighborState {
        entries: [UipNeighborEntry {
            ipaddr: UipIpAddr { words: [0u16, 0u16] },
            addr: mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte),
            time: 128 as byte
        }: 8]
    };
    uip_neighbor_init(&state);
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 24 as byte], proto: 58 as byte, ttl: 32 as byte, srcipaddr: [0u16,0u16,0u16,0u16,0u16,0u16,0xc0a8u16,0x0009u16], destipaddr: [0u16,0u16,0u16,0u16,0u16,0u16,0xc0a8u16,0x0001u16] };
    var ns: UipIcmp6NeighborHdr = UipIcmp6NeighborHdr { type: (ICMP6_NS as! byte).value, code: 0 as byte, icmpchksum: 0u16, flags: [0 as byte,0 as byte,0 as byte,0 as byte], targetipaddr: [0u16,0u16,0u16,0u16,0u16,0u16,0xc0a8u16,0x0001u16] };
    const m: UipNeighborAddr = mac(1 as byte, 2 as byte, 3 as byte, 4 as byte, 5 as byte, 6 as byte);
    try assert_eq_i32(uip_ipv6_neighbor_ns_bridge(&state, &ip, &ns, &m) as i32, IPV6_ICMP6_REPLY_READY);
    const learned: UipIpAddr = uip_ipaddr(192, 168, 0, 9);
    var out: UipNeighborAddr = mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte);
    try assert_eq_bool(uip_neighbor_lookup(&state, &learned, &out), true);
    try assert_eq_i32(out.addr.addr[0] as i32, 1);
}

test "uip_ipv6_neighbor_ns_bridge drops unspecified source without learning" {
    var state: UipNeighborState = UipNeighborState {
        entries: [UipNeighborEntry {
            ipaddr: UipIpAddr { words: [0u16, 0u16] },
            addr: mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte),
            time: 128 as byte
        }: 8]
    };
    uip_neighbor_init(&state);
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 24 as byte], proto: 58 as byte, ttl: 255 as byte, srcipaddr: [0u16,0u16,0u16,0u16,0u16,0u16,0u16,0u16], destipaddr: [0u16,0u16,0u16,0u16,0u16,0u16,0xc0a8u16,0x0001u16] };
    var ns: UipIcmp6NeighborHdr = UipIcmp6NeighborHdr { type: (ICMP6_NS as! byte).value, code: 0 as byte, icmpchksum: 0u16, flags: [0 as byte,0 as byte,0 as byte,0 as byte], targetipaddr: [0u16,0u16,0u16,0u16,0u16,0u16,0xc0a8u16,0x0001u16] };
    const m: UipNeighborAddr = mac(1 as byte, 2 as byte, 3 as byte, 4 as byte, 5 as byte, 6 as byte);
    try assert_eq_i32(uip_ipv6_neighbor_ns_bridge(&state, &ip, &ns, &m) as i32, IPV6_ICMP6_DROP);
    const learned: UipIpAddr = uip_ipaddr(0, 0, 0, 0);
    var out: UipNeighborAddr = mac(0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte);
    try assert_eq_bool(uip_neighbor_lookup(&state, &learned, &out), false);
}

