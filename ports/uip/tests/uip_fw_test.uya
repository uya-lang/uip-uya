use std.testing;

extern fn htons(val: u16) u16;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn uip_fw_init(state: &UipFwState) void;
extern fn uip_fw_register(state: &UipFwState, netif: &UipFwNetif) void;
extern fn uip_fw_default(state: &UipFwState, netif: &UipFwNetif) void;
extern fn uip_fw_output(state: &UipFwState, rt: &UipRuntime) byte;
extern fn uip_fw_forward(state: &UipFwState, rt: &UipRuntime) byte;
extern fn uip_fw_periodic(state: &UipFwState) void;

extern const UIP_FW_LOCAL: i32;
extern const UIP_FW_OK: i32;
extern const UIP_FW_FORWARDED: i32;
extern const UIP_FW_ZEROLEN: i32;
extern const UIP_FW_TOOLARGE: i32;
extern const UIP_FW_NOROUTE: i32;
extern const UIP_FW_DROPPED: i32;
extern const UIP_PROTO_ICMP: i32;
extern const UIP_TTL: i32;
extern const UIP_TCPIP_HLEN: i32;
extern const UIP_LLH_LEN: i32;

struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, appdata: &byte, sappdata: &byte, len: u16, uip_len: u16, uip_slen: u16, flags: byte, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, stats: &UipStats, urgdata: &byte, urglen: u16, surglen: u16, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, slen: u16, logs: [UipRuntimeLog: 16], ipid: u16, te_reply: bool }
struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }

struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct UipFwNetif { next: &UipFwNetif, ipaddr: UipIpAddr, netmask: UipIpAddr, output_result: byte, output_calls: byte, last_len: u16, output_fn: i32 }
struct UipFwCacheEntry { timer: u16, srcipaddr: UipIpAddr, destipaddr: UipIpAddr, ipid: u16, proto: byte }
struct UipFwState { netifs: [&UipFwNetif: 4], netif_count: usize, default_index: i32, cache: [UipFwCacheEntry: 2], head: &UipFwNetif, default_netif: &UipFwNetif }

fn make_zero_stats() UipStats {
    return UipStats {
        ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 }
    };
}

fn make_runtime() UipRuntime {
    var stats: UipStats = make_zero_stats();
    return UipRuntime {
        frame: UipRuntimeFrame {
            ethip: EthIpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16] },
            ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, seqno: [0 as byte,0 as byte,0 as byte,0 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0 as byte, flags: 0 as byte, wnd: [0 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] },
            ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 },
            arp: ArpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, sipaddr: [0u16,0u16], dhwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, dipaddr: [0u16,0u16] }
        },
        hostaddr: UipIpAddr { words: [0u16, 0u16] },
        draddr: UipIpAddr { words: [0u16, 0u16] },
        netmask: UipIpAddr { words: [0u16, 0u16] },
        appdata: null,
        sappdata: null,
        urgdata: null,
        len: 0u16,
        uip_len: 0u16,
        uip_slen: 0u16,
        slen: 0u16,
        urglen: 0u16,
        surglen: 0u16,
        flags: 0 as byte,
        current_conn: -1,
        current_udp_conn: -1,
        payload_view: null,
        payload_len: 0u16,
        input_view: null,
        input_len: 0u16,
        app_input: null,
        app_input_len: 0u16,
        app_output: null,
        logbuf: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16],
        logcount: 0usize,
        logcode: 0 as byte,
        logparam: 0u16,
        logs: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16],
        ipid: 0u16,
        acc32: [0 as byte,0 as byte,0 as byte,0 as byte],
        stats: &stats,
        fw_last_output_fn: 0
    };
}

fn make_fw_state() UipFwState {
    return UipFwState {
        netifs: [null: 4],
        netif_count: 0,
        default_index: -1,
        cache: [UipFwCacheEntry { timer: 0u16, srcipaddr: UipIpAddr { words: [0u16,0u16] }, destipaddr: UipIpAddr { words: [0u16,0u16] }, ipid: 0u16, proto: 0 as byte }: 2],
        head: null,
        default_netif: null
    };
}

test "uip_fw_init clears registry and cache" {
    var state: UipFwState = make_fw_state();
    state.netif_count = 2;
    state.default_index = 1;
    state.cache[0].timer = 3u16;
    state.head = @ptr_from_usize(1usize) as &UipFwNetif;
    state.default_netif = @ptr_from_usize(1usize) as &UipFwNetif;
    uip_fw_init(&state);
    try assert_eq_i32(state.netif_count as i32, 0);
    try assert_eq_i32(state.default_index, -1);
    try assert_eq_i32(state.cache[0].timer as i32, 0);
    try assert_eq_bool(state.head == null, true);
    try assert_eq_bool(state.default_netif == null, true);
}

test "uip_fw_register preserves caller linked next chain" {
    var state: UipFwState = make_fw_state();
    var first: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    var second: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(192,168,1,1), netmask: uip_ipaddr(255,255,255,0), output_result: (UIP_FW_FORWARDED as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    first.next = &second;
    uip_fw_register(&state, &first);
    try assert_eq_bool(first.next == &second, true);
    try assert_eq_i32(state.netif_count as i32, 2);
    try assert_eq_bool(state.netifs[0] == &first, true);
    try assert_eq_bool(state.netifs[1] == &second, true);
    try assert_eq_bool(state.head == &first, true);
}


test "uip_fw_register avoids duplicate registry entries for same netif" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_register(&state, &netif);
    try assert_eq_i32(state.netif_count as i32, 1);
    try assert_eq_bool(state.head == &netif, true);
}


test "uip_fw_output uses chain routing and default pointer" {
    var state: UipFwState = make_fw_state();
    var first: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: 9 as byte, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    var second: UipFwNetif = UipFwNetif { next: &first, ipaddr: uip_ipaddr(192,168,0,1), netmask: uip_ipaddr(255,255,255,0), output_result: 7 as byte, output_calls: 0 as byte, last_len: 0u16, output_fn: 2 };
    uip_fw_register(&state, &first);
    uip_fw_register(&state, &second);
    uip_fw_default(&state, &first);
    var rt: UipRuntime = make_runtime();
    rt.len = 40u16;
    const dest: UipIpAddr = uip_ipaddr(192,168,0,9);
    rt.frame.ethip.destipaddr[0] = dest.words[0];
    rt.frame.ethip.destipaddr[1] = dest.words[1];
    try assert_eq_i32(uip_fw_output(&state, &rt) as i32, UIP_FW_FORWARDED);
    try assert_eq_i32(rt.fw_last_output_fn, 2);
    rt.fw_last_output_fn = 0;
    const other: UipIpAddr = uip_ipaddr(172,16,1,9);
    rt.frame.ethip.destipaddr[0] = other.words[0];
    rt.frame.ethip.destipaddr[1] = other.words[1];
    try assert_eq_i32(uip_fw_output(&state, &rt) as i32, 9);
    try assert_eq_i32(rt.fw_last_output_fn, 0);
}


test "uip_fw_output keeps registry mirror synced to chain order" {
    var state: UipFwState = make_fw_state();
    var tail: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: 9 as byte, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    var head: UipFwNetif = UipFwNetif { next: &tail, ipaddr: uip_ipaddr(192,168,0,1), netmask: uip_ipaddr(255,255,255,0), output_result: 7 as byte, output_calls: 0 as byte, last_len: 0u16, output_fn: 2 };
    uip_fw_register(&state, &tail);
    uip_fw_register(&state, &head);
    try assert_eq_bool(state.head == &head, true);
    try assert_eq_i32(state.netif_count as i32, 2);
    try assert_eq_bool(state.netifs[0] == &head, true);
    try assert_eq_bool(state.netifs[1] == &tail, true);
}



test "uip_fw_output keeps oldest-slot replacement semantics" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_default(&state, &netif);
    state.cache[0].timer = 19u16;
    state.cache[0].ipid = 1u16;
    state.cache[1].timer = 3u16;
    state.cache[1].ipid = 2u16;
    var rt: UipRuntime = make_runtime();
    rt.len = 60u16;
    rt.frame.ethip.proto = 6 as byte;
    rt.frame.ethip.ipid[1] = 44 as byte;
    rt.frame.ethip.srcipaddr[0] = uip_ipaddr(6,6,6,6).words[0];
    rt.frame.ethip.srcipaddr[1] = uip_ipaddr(6,6,6,6).words[1];
    rt.frame.ethip.destipaddr[0] = uip_ipaddr(7,7,7,7).words[0];
    rt.frame.ethip.destipaddr[1] = uip_ipaddr(7,7,7,7).words[1];
    try assert_eq_i32(uip_fw_output(&state, &rt) as i32, UIP_FW_OK);
    try assert_eq_i32(state.cache[1].timer as i32, 20);
    try assert_eq_i32(state.cache[1].ipid as i32, 44);
    try assert_eq_i32(state.cache[0].ipid as i32, 1);
}


test "uip_fw_forward ttl expiry rewrites packet as icmp time exceeded" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_default(&state, &netif);
    var rt: UipRuntime = make_runtime();
    var stats: UipStats = UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } };
    rt.stats = &stats;
    rt.hostaddr = uip_ipaddr(192,168,0,2);
    rt.len = 60u16;
    rt.frame.ethip.srcipaddr[0] = uip_ipaddr(1,1,1,1).words[0];
    rt.frame.ethip.srcipaddr[1] = uip_ipaddr(1,1,1,1).words[1];
    rt.frame.ethip.destipaddr[0] = uip_ipaddr(8,8,8,8).words[0];
    rt.frame.ethip.destipaddr[1] = uip_ipaddr(8,8,8,8).words[1];
    rt.frame.ethip.ipid[1] = 11 as byte;
    rt.frame.ethip.proto = 6 as byte;
    rt.frame.ethip.ttl = 1 as byte;
    rt.frame.ethip.len[0] = 0 as byte;
    rt.frame.ethip.len[1] = 60 as byte;
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_FORWARDED);
    try assert_eq_bool(rt.te_reply, true);
    try assert_eq_i32(rt.frame.ethip.destipaddr[0] as i32, uip_ipaddr(1,1,1,1).words[0] as i32);
    try assert_eq_i32(rt.frame.ethip.destipaddr[1] as i32, uip_ipaddr(1,1,1,1).words[1] as i32);
    try assert_eq_i32(rt.frame.ethip.srcipaddr[0] as i32, rt.hostaddr.words[0] as i32);
    try assert_eq_i32(rt.frame.ethip.srcipaddr[1] as i32, rt.hostaddr.words[1] as i32);
    try assert_eq_i32(rt.frame.ethip.vhl as i32, 0x45);
    try assert_eq_i32(rt.frame.ethip.tos as i32, 0);
    try assert_eq_i32(rt.frame.ethip.ipoffset[0] as i32, 0);
    try assert_eq_i32(rt.frame.ethip.ipoffset[1] as i32, 0);
    try assert_eq_i32(netif.last_len as i32, 56);
    const te_payload: &byte = @ptr_from_usize(@usize_from_ptr(&rt.frame.ethtcp.srcport as &void)) as &byte;
    try assert_eq_i32(te_payload[0] as i32, 11);
    try assert_eq_i32(te_payload[1] as i32, 0);
    try assert_eq_i32(te_payload[8] as i32, 0);
    try assert_eq_i32(te_payload[9] as i32, 0);
    try assert_eq_i32(te_payload[10] as i32, 0);
    try assert_eq_i32(te_payload[11] as i32, 60);
    try assert_eq_i32(te_payload[12] as i32, 0);
    try assert_eq_i32(te_payload[13] as i32, 11);
    try assert_eq_i32(te_payload[16] as i32, 1);
    try assert_eq_i32(te_payload[17] as i32, 6);
    try assert_eq_i32(te_payload[20] as i32, 1);
    try assert_eq_i32(te_payload[21] as i32, 1);
    try assert_eq_i32(te_payload[22] as i32, 1);
    try assert_eq_i32(te_payload[23] as i32, 1);
    try assert_eq_i32(te_payload[24] as i32, 8);
    try assert_eq_i32(te_payload[25] as i32, 8);
    try assert_eq_i32(te_payload[26] as i32, 8);
    try assert_eq_i32(te_payload[27] as i32, 8);
}


test "uip_fw_forward ttl expiry drops icmp input without emitting time exceeded" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_default(&state, &netif);
    var rt: UipRuntime = make_runtime();
    rt.hostaddr = uip_ipaddr(192,168,0,2);
    rt.len = 60u16;
    rt.frame.ethip.srcipaddr[0] = uip_ipaddr(1,1,1,1).words[0];
    rt.frame.ethip.srcipaddr[1] = uip_ipaddr(1,1,1,1).words[1];
    rt.frame.ethip.destipaddr[0] = uip_ipaddr(8,8,8,8).words[0];
    rt.frame.ethip.destipaddr[1] = uip_ipaddr(8,8,8,8).words[1];
    rt.frame.ethip.proto = (UIP_PROTO_ICMP as! byte).value;
    rt.frame.ethip.ttl = 1 as byte;
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_FORWARDED);
    try assert_eq_bool(rt.te_reply, false);
    try assert_eq_i32(rt.len as i32, 0);
    try assert_eq_i32(netif.output_calls as i32, 0);
}

test "uip_fw_forward drops duplicate packet from cache" {
    var state: UipFwState = make_fw_state();
    var rt: UipRuntime = make_runtime();
    rt.hostaddr = uip_ipaddr(192,168,0,2);
    rt.len = 60u16;
    const src: UipIpAddr = uip_ipaddr(1,1,1,1);
    const dest: UipIpAddr = uip_ipaddr(8,8,8,8);
    rt.frame.ethip.srcipaddr[0] = src.words[0];
    rt.frame.ethip.srcipaddr[1] = src.words[1];
    rt.frame.ethip.destipaddr[0] = dest.words[0];
    rt.frame.ethip.destipaddr[1] = dest.words[1];
    rt.frame.ethip.ipid[0] = 0 as byte;
    rt.frame.ethip.ipid[1] = 9 as byte;
    rt.frame.ethip.proto = 17 as byte;
    state.cache[0].timer = 5u16;
    state.cache[0].srcipaddr = uip_ipaddr(1,1,1,1);
    state.cache[0].destipaddr = uip_ipaddr(8,8,8,8);
    state.cache[0].ipid = 9u16;
    state.cache[0].proto = 17 as byte;
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_FORWARDED);
}



test "uip_fw_forward registers forwarded packet into empty cache slot" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_default(&state, &netif);
    var rt: UipRuntime = make_runtime();
    const src: UipIpAddr = uip_ipaddr(2,2,2,2);
    const dest: UipIpAddr = uip_ipaddr(9,9,9,9);
    rt.len = 60u16;
    rt.frame.ethip.ttl = 5 as byte;
    rt.frame.ethip.proto = 17 as byte;
    rt.frame.ethip.ipid[0] = 0 as byte;
    rt.frame.ethip.ipid[1] = 12 as byte;
    rt.frame.ethip.srcipaddr[0] = src.words[0];
    rt.frame.ethip.srcipaddr[1] = src.words[1];
    rt.frame.ethip.destipaddr[0] = dest.words[0];
    rt.frame.ethip.destipaddr[1] = dest.words[1];
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_FORWARDED);
    try assert_eq_i32(state.cache[0].timer as i32, 20);
    try assert_eq_i32(state.cache[0].ipid as i32, 12);
    try assert_eq_i32(state.cache[0].proto as i32, 17);
    try assert_eq_i32(state.cache[0].srcipaddr.words[0] as i32, src.words[0] as i32);
    try assert_eq_i32(state.cache[0].srcipaddr.words[1] as i32, src.words[1] as i32);
    try assert_eq_i32(state.cache[0].destipaddr.words[0] as i32, dest.words[0] as i32);
    try assert_eq_i32(state.cache[0].destipaddr.words[1] as i32, dest.words[1] as i32);
}

test "uip_fw_forward broadcast returns local after forwarding" {
    var state: UipFwState = make_fw_state();
    var netif0: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    var netif1: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(192,168,0,1), netmask: uip_ipaddr(255,255,255,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif0);
    uip_fw_register(&state, &netif1);
    uip_fw_default(&state, &netif0);
    var rt: UipRuntime = make_runtime();
    rt.len = 60u16;
    rt.frame.ethip.ttl = 4 as byte;
    rt.frame.ethip.ipchksum = htons(0x1000u16);
    rt.frame.ethip.destipaddr[0] = 0xffffu16;
    rt.frame.ethip.destipaddr[1] = 0xffffu16;
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_LOCAL);
    try assert_eq_i32(rt.frame.ethip.ttl as i32, 3);
    try assert_eq_i32(netif0.output_calls as i32, 1);
    try assert_eq_i32(netif1.output_calls as i32, 1);
}



test "uip_fw_forward decrements ttl and updates checksum incrementally" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_default(&state, &netif);
    var rt: UipRuntime = make_runtime();
    rt.len = 60u16;
    rt.frame.ethip.ttl = 4 as byte;
    rt.frame.ethip.proto = 17 as byte;
    rt.frame.ethip.ipchksum = htons(0x1000u16);
    rt.frame.ethip.ipid[1] = 33 as byte;
    rt.frame.ethip.srcipaddr[0] = uip_ipaddr(4,4,4,4).words[0];
    rt.frame.ethip.srcipaddr[1] = uip_ipaddr(4,4,4,4).words[1];
    rt.frame.ethip.destipaddr[0] = uip_ipaddr(5,5,5,5).words[0];
    rt.frame.ethip.destipaddr[1] = uip_ipaddr(5,5,5,5).words[1];
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_FORWARDED);
    try assert_eq_i32(rt.frame.ethip.ttl as i32, 3);
    try assert_eq_i32(rt.frame.ethip.ipchksum as i32, (htons(0x1000u16) + htons(0x0100u16)) as i32);
    try assert_eq_i32(state.cache[0].timer as i32, 20);
    try assert_eq_i32(state.cache[0].ipid as i32, 33);
}

test "uip_fw_forward reuses lower timer cache slot when both occupied" {
    var state: UipFwState = make_fw_state();
    var netif: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif);
    uip_fw_default(&state, &netif);
    state.cache[0].timer = 19u16;
    state.cache[0].ipid = 1u16;
    state.cache[1].timer = 3u16;
    state.cache[1].ipid = 2u16;
    var rt: UipRuntime = make_runtime();
    const src: UipIpAddr = uip_ipaddr(3,3,3,3);
    const dest: UipIpAddr = uip_ipaddr(7,7,7,7);
    rt.len = 60u16;
    rt.frame.ethip.ttl = 5 as byte;
    rt.frame.ethip.proto = 6 as byte;
    rt.frame.ethip.ipid[0] = 0 as byte;
    rt.frame.ethip.ipid[1] = 22 as byte;
    rt.frame.ethip.srcipaddr[0] = src.words[0];
    rt.frame.ethip.srcipaddr[1] = src.words[1];
    rt.frame.ethip.destipaddr[0] = dest.words[0];
    rt.frame.ethip.destipaddr[1] = dest.words[1];
    try assert_eq_i32(uip_fw_forward(&state, &rt) as i32, UIP_FW_FORWARDED);
    try assert_eq_i32(state.cache[1].timer as i32, 20);
    try assert_eq_i32(state.cache[1].ipid as i32, 22);
    try assert_eq_i32(state.cache[1].proto as i32, 6);
}


test "uip_fw_periodic ages cache entries used by forwarding" {
    var state: UipFwState = make_fw_state();
    state.cache[0].timer = 20u16;
    state.cache[1].timer = 1u16;
    uip_fw_periodic(&state);
    try assert_eq_i32(state.cache[0].timer as i32, 19);
    try assert_eq_i32(state.cache[1].timer as i32, 0);
}

test "uip_fw_output broadcast sends current length to each output callback" {
    var state: UipFwState = make_fw_state();
    var netif0: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    var netif1: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(172,16,0,1), netmask: uip_ipaddr(255,240,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif0);
    uip_fw_register(&state, &netif1);
    uip_fw_default(&state, &netif0);
    var rt: UipRuntime = make_runtime();
    rt.len = 77u16;
    rt.frame.ethip.destipaddr[0] = 0xffffu16;
    rt.frame.ethip.destipaddr[1] = 0xffffu16;
    try assert_eq_i32(uip_fw_output(&state, &rt) as i32, UIP_FW_OK);
    try assert_eq_i32(netif0.last_len as i32, 77);
    try assert_eq_i32(netif1.last_len as i32, 77);
}



test "uip_fw_output broadcast fans out to default and nondefault interfaces" {
    var state: UipFwState = make_fw_state();
    var netif0: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(10,0,0,1), netmask: uip_ipaddr(255,0,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    var netif1: UipFwNetif = UipFwNetif { next: null, ipaddr: uip_ipaddr(172,16,0,1), netmask: uip_ipaddr(255,240,0,0), output_result: (UIP_FW_OK as! byte).value, output_calls: 0 as byte, last_len: 0u16, output_fn: 0 };
    uip_fw_register(&state, &netif0);
    uip_fw_register(&state, &netif1);
    uip_fw_default(&state, &netif0);
    var rt: UipRuntime = make_runtime();
    rt.len = 60u16;
    rt.frame.ethip.destipaddr[0] = 0xffffu16;
    rt.frame.ethip.destipaddr[1] = 0xffffu16;
    try assert_eq_i32(uip_fw_output(&state, &rt) as i32, UIP_FW_OK);
    try assert_eq_i32(netif0.output_calls as i32, 1);
    try assert_eq_i32(netif1.output_calls as i32, 1);
}



