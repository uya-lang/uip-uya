use std.testing;

extern fn htons(val: u16) u16;
extern fn ntohs(val: u16) u16;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn uip_ipaddr_copy(dest: &UipIpAddr, src: &UipIpAddr) void;
extern fn uip_ipaddr_cmp(addr1: &UipIpAddr, addr2: &UipIpAddr) bool;
extern fn uip_ipaddr_maskcmp(addr1: &UipIpAddr, addr2: &UipIpAddr, mask: &UipIpAddr) bool;
extern fn uip_ipaddr_mask(dest: &UipIpAddr, src: &UipIpAddr, mask: &UipIpAddr) void;
extern fn uip_ipaddr1(addr: &UipIpAddr) byte;
extern fn uip_ipaddr2(addr: &UipIpAddr) byte;
extern fn uip_ipaddr3(addr: &UipIpAddr) byte;
extern fn uip_ipaddr4(addr: &UipIpAddr) byte;
extern fn uip_add32(op32: &byte, op16: u16, out_acc32: &byte) void;
extern fn uiplib_ipaddrconv(addrstr: &const byte, ipaddr: &byte) byte;
extern fn timer_set(t: &Timer, interval: u64, now: u64) void;
extern fn timer_reset(t: &Timer) void;
extern fn timer_restart(t: &Timer, now: u64) void;
extern fn timer_expired(t: &Timer, now: u64) bool;
extern fn uip_chksum(data: &byte, len: u16) u16;
extern fn uip_ipchksum(buf: &byte) u16;
extern fn uip_upper_layer_chksum(buf: &byte, proto: byte) u16;
extern fn uip_tcpchksum(buf: &byte) u16;
extern fn uip_udpchksum(buf: &byte) u16;

extern fn uip_const_ttl() i32;
extern fn uip_const_bufsize() i32;
extern fn uip_const_llh_len() i32;
extern fn uip_const_iph_len() i32;
extern fn uip_const_udph_len() i32;
extern fn uip_const_tcph_len() i32;
extern fn uip_const_ipudph_len() i32;
extern fn uip_const_iptcph_len() i32;
extern fn uip_const_tcpip_hlen() i32;
extern fn uip_const_tcp_mss() i32;
extern fn uip_const_receive_window() i32;
extern fn uip_const_byte_order() i32;
extern fn uip_const_conns() i32;
extern fn uip_const_listenports() i32;
extern fn uip_const_ackdata() i32;
extern fn uip_const_newdata() i32;
extern fn uip_const_rexmit() i32;
extern fn uip_const_poll() i32;
extern fn uip_const_close() i32;
extern fn uip_const_abort() i32;
extern fn uip_const_connected() i32;
extern fn uip_const_timedout() i32;
extern fn uip_const_closed() i32;
extern fn uip_const_established() i32;
extern fn uip_const_time_wait() i32;
extern fn uip_const_stopped() i32;

struct Timer {
    start: u64,
    interval: u64
}

struct UipIpAddr {
    words: [u16: 2]
}
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, appdata: &byte, sappdata: &byte, len: u16, uip_len: u16, uip_slen: u16, flags: byte, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, stats: &UipStats, urgdata: &byte, urglen: u16, surglen: u16, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, slen: u16, logs: [UipRuntimeLog: 16], ipid: u16, te_reply: bool }
struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }

test "uiplib_ipaddrconv parses dotted quad" {
    var ip: [byte: 4] = [];
    const ok: byte = uiplib_ipaddrconv("192.168.0.2", &ip[0]);
    try assert_eq_i32(ok as i32, 1);
    try assert_eq_i32(ip[0] as i32, 192);
    try assert_eq_i32(ip[1] as i32, 168);
    try assert_eq_i32(ip[2] as i32, 0);
    try assert_eq_i32(ip[3] as i32, 2);
}

test "uiplib_ipaddrconv rejects non digit segment" {
    var ip: [byte: 4] = [];
    const ok: byte = uiplib_ipaddrconv("10.a.0.1", &ip[0]);
    try assert_eq_i32(ok as i32, 0);
}

test "uiplib_ipaddrconv rejects overlong segment" {
    var ip: [byte: 4] = [];
    const ok: byte = uiplib_ipaddrconv("12345.0.0.1", &ip[0]);
    try assert_eq_i32(ok as i32, 0);
}

test "timer_set and timer_expired mirror uip semantics" {
    var t: Timer = Timer{ start: 0, interval: 0 };
    timer_set(&t, 50, 100);
    try assert_eq_u64(t.start, 100u64);
    try assert_eq_u64(t.interval, 50u64);
    try assert_eq_bool(timer_expired(&t, 149), false);
    try assert_eq_bool(timer_expired(&t, 150), true);
}

test "timer_reset advances by fixed interval" {
    var t: Timer = Timer{ start: 100, interval: 50 };
    timer_reset(&t);
    try assert_eq_u64(t.start, 150u64);
    try assert_eq_u64(t.interval, 50u64);
}

test "timer_restart uses current time" {
    var t: Timer = Timer{ start: 100, interval: 50 };
    timer_restart(&t, 230);
    try assert_eq_u64(t.start, 230u64);
    try assert_eq_u64(t.interval, 50u64);
    try assert_eq_bool(timer_expired(&t, 279), false);
    try assert_eq_bool(timer_expired(&t, 280), true);
}

test "uip_ipaddr packs octets into words" {
    const addr: UipIpAddr = uip_ipaddr(192, 168, 0, 2);
    try assert_eq_i32(uip_ipaddr1(&addr) as i32, 192);
    try assert_eq_i32(uip_ipaddr2(&addr) as i32, 168);
    try assert_eq_i32(uip_ipaddr3(&addr) as i32, 0);
    try assert_eq_i32(uip_ipaddr4(&addr) as i32, 2);
}

test "uip_ipaddr_copy copies both words" {
    const src: UipIpAddr = uip_ipaddr(10, 0, 0, 1);
    var dst: UipIpAddr = UipIpAddr{ words: [0u16, 0u16] };
    uip_ipaddr_copy(&dst, &src);
    try assert_eq_i32(uip_ipaddr1(&dst) as i32, 10);
    try assert_eq_i32(uip_ipaddr2(&dst) as i32, 0);
    try assert_eq_i32(uip_ipaddr3(&dst) as i32, 0);
    try assert_eq_i32(uip_ipaddr4(&dst) as i32, 1);
}

test "uip_add32 adds host order u16 into network order u32" {
    var op32: [byte: 4] = [0, 0, 0, 1];
    var acc: [byte: 4] = [0, 0, 0, 0];
    uip_add32(&op32[0], 0x0203u16, &acc[0]);
    try assert_eq_i32(acc[0] as i32, 0);
    try assert_eq_i32(acc[1] as i32, 0);
    try assert_eq_i32(acc[2] as i32, 2);
    try assert_eq_i32(acc[3] as i32, 4);
}

test "uip_add32 carries across all bytes" {
    var op32: [byte: 4] = [0, 0, 255, 255];
    var acc: [byte: 4] = [0, 0, 0, 0];
    uip_add32(&op32[0], 1u16, &acc[0]);
    try assert_eq_i32(acc[0] as i32, 0);
    try assert_eq_i32(acc[1] as i32, 1);
    try assert_eq_i32(acc[2] as i32, 0);
    try assert_eq_i32(acc[3] as i32, 0);
}

test "uip_ipaddr_maskcmp respects netmask" {
    const addr1: UipIpAddr = uip_ipaddr(192, 168, 1, 2);
    const addr2: UipIpAddr = uip_ipaddr(192, 168, 1, 99);
    const mask: UipIpAddr = uip_ipaddr(255, 255, 255, 0);
    try assert_eq_bool(uip_ipaddr_maskcmp(&addr1, &addr2, &mask), true);
}

test "uip_ipaddr_mask clears host bits" {
    const src: UipIpAddr = uip_ipaddr(192, 168, 1, 42);
    const mask: UipIpAddr = uip_ipaddr(255, 255, 255, 0);
    var dst: UipIpAddr = UipIpAddr{ words: [0u16, 0u16] };
    uip_ipaddr_mask(&dst, &src, &mask);
    try assert_eq_i32(uip_ipaddr1(&dst) as i32, 192);
    try assert_eq_i32(uip_ipaddr2(&dst) as i32, 168);
    try assert_eq_i32(uip_ipaddr3(&dst) as i32, 1);
    try assert_eq_i32(uip_ipaddr4(&dst) as i32, 0);
}

test "htons and ntohs swap bytes on little endian default" {
    try assert_eq_i32(htons(0x1234u16) as i32, 0x3412);
    try assert_eq_i32(ntohs(0x3412u16) as i32, 0x1234);
}

test "uip_chksum matches RFC1071 style example" {
    var data: [byte: 4] = [1, 2, 3, 4];
    try assert_eq_i32(uip_chksum(&data[0], 4u16) as i32, 0x0604);
}

test "uip_ipchksum returns 0xffff for zero header sum" {
    var buf: [byte: 64] = [0: 64];
    try assert_eq_i32(uip_ipchksum(&buf[0]) as i32, 0xFFFF);
}

test "uip_upper_layer_chksum covers pseudo header and payload" {
    var buf: [byte: 64] = [0: 64];
    const base: usize = (uip_const_llh_len() as! usize).value;
    const ipoff: usize = ((uip_const_llh_len() + uip_const_iph_len()) as! usize).value;
    buf[base + 2] = 0;
    buf[base + 3] = 24;
    buf[base + 12] = 1;
    buf[base + 13] = 2;
    buf[base + 14] = 3;
    buf[base + 15] = 4;
    buf[base + 16] = 5;
    buf[base + 17] = 6;
    buf[base + 18] = 7;
    buf[base + 19] = 8;
    buf[ipoff + 0] = 0x11 as byte;
    buf[ipoff + 1] = 0x22 as byte;
    buf[ipoff + 2] = 0x33 as byte;
    buf[ipoff + 3] = 0x44 as byte;
    try assert_eq_i32(uip_upper_layer_chksum(&buf[0], 6) as i32, 33876);
}

test "uip_tcpchksum delegates to upper layer checksum" {
    var buf: [byte: 64] = [0: 64];
    const base: usize = (uip_const_llh_len() as! usize).value;
    const ipoff: usize = ((uip_const_llh_len() + uip_const_iph_len()) as! usize).value;
    buf[base + 2] = 0;
    buf[base + 3] = 24;
    buf[base + 12] = 1;
    buf[base + 13] = 2;
    buf[base + 14] = 3;
    buf[base + 15] = 4;
    buf[base + 16] = 5;
    buf[base + 17] = 6;
    buf[base + 18] = 7;
    buf[base + 19] = 8;
    buf[ipoff + 0] = 0x11 as byte;
    buf[ipoff + 1] = 0x22 as byte;
    buf[ipoff + 2] = 0x33 as byte;
    buf[ipoff + 3] = 0x44 as byte;
    try assert_eq_i32(uip_tcpchksum(&buf[0]) as i32, 33876);
}

test "uip_udpchksum uses UDP protocol number" {
    var buf: [byte: 64] = [0: 64];
    const base: usize = (uip_const_llh_len() as! usize).value;
    const ipoff: usize = ((uip_const_llh_len() + uip_const_iph_len()) as! usize).value;
    buf[base + 2] = 0;
    buf[base + 3] = 24;
    buf[base + 12] = 1;
    buf[base + 13] = 2;
    buf[base + 14] = 3;
    buf[base + 15] = 4;
    buf[base + 16] = 5;
    buf[base + 17] = 6;
    buf[base + 18] = 7;
    buf[base + 19] = 8;
    buf[ipoff + 0] = 0x11 as byte;
    buf[ipoff + 1] = 0x22 as byte;
    buf[ipoff + 2] = 0x33 as byte;
    buf[ipoff + 3] = 0x44 as byte;
    try assert_eq_i32(uip_udpchksum(&buf[0]) as i32, 36692);
}

test "uip protocol and state constants match header defaults" {
    try assert_eq_i32(uip_const_ackdata(), 1);
    try assert_eq_i32(uip_const_newdata(), 2);
    try assert_eq_i32(uip_const_rexmit(), 4);
    try assert_eq_i32(uip_const_poll(), 8);
    try assert_eq_i32(uip_const_close(), 16);
    try assert_eq_i32(uip_const_abort(), 32);
    try assert_eq_i32(uip_const_connected(), 64);
    try assert_eq_i32(uip_const_timedout(), 128);
    try assert_eq_i32(uip_const_closed(), 0);
    try assert_eq_i32(uip_const_established(), 3);
    try assert_eq_i32(uip_const_time_wait(), 7);
    try assert_eq_i32(uip_const_stopped(), 16);
}

test "uip core constants match defaults" {
    try assert_eq_i32(uip_const_ttl(), 64);
    try assert_eq_i32(uip_const_bufsize(), 400);
    try assert_eq_i32(uip_const_llh_len(), 14);
    try assert_eq_i32(uip_const_iph_len(), 20);
    try assert_eq_i32(uip_const_udph_len(), 8);
    try assert_eq_i32(uip_const_tcph_len(), 20);
    try assert_eq_i32(uip_const_ipudph_len(), 28);
    try assert_eq_i32(uip_const_iptcph_len(), 40);
    try assert_eq_i32(uip_const_tcpip_hlen(), 40);
    try assert_eq_i32(uip_const_tcp_mss(), 346);
    try assert_eq_i32(uip_const_receive_window(), 346);
    try assert_eq_i32(uip_const_conns(), 10);
    try assert_eq_i32(uip_const_listenports(), 20);
    try assert_eq_i32(uip_const_byte_order(), 3412);
}
