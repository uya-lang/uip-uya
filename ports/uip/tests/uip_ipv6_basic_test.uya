use std.testing;

extern const UIP_PROTO_ICMP6: i32;
extern const ICMP6_ECHO_REQUEST: i32;
extern const ICMP6_ECHO_REPLY: i32;
extern const ICMP6_NS: i32;
extern const IPV6_ICMP6_DROP: i32;
extern const IPV6_ICMP6_REPLY_READY: i32;
extern const IPV6_ICMP6_UNHANDLED: i32;

extern const IPV6_INPUT_ICMP6: i32;
extern const IPV6_INPUT_TCP: i32;
extern const IPV6_INPUT_UDP: i32;


struct UipIpAddr { words: [u16: 2] }
struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
struct UipIcmp6Hdr { type: byte, code: byte, icmpchksum: u16, data: [byte: 4] }
struct UipIcmp6NeighborHdr { type: byte, code: byte, icmpchksum: u16, flags: [byte: 4], targetipaddr: [u16: 8] }

extern fn ipv6_input_neighbor_bridge(ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr, bridge_result: byte) byte;
extern fn ipv6_input_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) byte;
extern fn ipv6_process_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) byte;
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipEthAddr { addr: [byte: 6] }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, appdata: &byte, sappdata: &byte, urgdata: &byte, len: u16, uip_len: u16, uip_slen: u16, slen: u16, urglen: u16, surglen: u16, flags: byte, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, logs: [UipRuntimeLog: 16], ipid: u16, stats: &UipStats, te_reply: bool }

fn make_runtime() UipRuntime {
    var stats: UipStats = UipStats { ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 }, udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 } };
    return UipRuntime {
        frame: UipRuntimeFrame {
            ethip: EthIpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16] },
            ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, seqno: [0 as byte,0 as byte,0 as byte,0 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0 as byte, flags: 0 as byte, wnd: [0 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] },
            ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 },
            arp: ArpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, sipaddr: [0u16,0u16], dhwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, dipaddr: [0u16,0u16] }
        },
        hostaddr: UipIpAddr { words: [0u16, 0u16] }, draddr: UipIpAddr { words: [0u16, 0u16] }, netmask: UipIpAddr { words: [0u16, 0u16] }, appdata: null, sappdata: null, urgdata: null, len: 0u16, uip_len: 0u16, uip_slen: 0u16, slen: 0u16, urglen: 0u16, surglen: 0u16, flags: 0 as byte, current_conn: -1, current_udp_conn: -1, payload_view: null, payload_len: 0u16, input_view: null, input_len: 0u16, app_input: null, app_input_len: 0u16, app_output: null, logbuf: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], logcount: 0usize, logcode: 0 as byte, logparam: 0u16, logs: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], ipid: 0u16,
        stats: &stats,
        te_reply: false
    };
}

extern fn ipv6_tcp_input_step(ip: &UipIpv6Hdr) byte;
extern fn ipv6_udp_input_step(ip: &UipIpv6Hdr) byte;
extern const IPV6_TCP_INPUT_READY: i32;
extern const IPV6_UDP_INPUT_READY: i32;
extern const IPV6_PROCESS_DROP: i32;
extern const IPV6_PROCESS_ICMP6: i32;
extern const IPV6_PROCESS_TCP: i32;
extern const IPV6_PROCESS_UDP: i32;




extern fn icmp6_na_prepare_from_ns(ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr) bool;
extern fn ipv6_addr_sum(ip: &UipIpv6Hdr, src: bool) u32;
extern fn ipv6_icmp6_checksum(ip: &UipIpv6Hdr, icmp: &byte, icmp_len: u16) u16;
extern fn ipv6_icmp6_echo_input_step(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) byte;
extern fn ipv6_icmp6_neighbor_input_step(ip: &UipIpv6Hdr, hdr: &UipIcmp6NeighborHdr) byte;
extern fn ipv6_next_header(hdr: &UipIpv6Hdr) byte;
extern fn ipv6_is_icmp6(hdr: &UipIpv6Hdr) bool;
extern fn ipv6_is_tcp(hdr: &UipIpv6Hdr) bool;
extern fn ipv6_is_udp(hdr: &UipIpv6Hdr) bool;
extern fn ipv6_input_classify(hdr: &UipIpv6Hdr) byte;
extern fn ipv6_version_ok(hdr: &UipIpv6Hdr) bool;
extern fn icmp6_type(hdr: &UipIcmp6Hdr) byte;
extern fn icmp6_is_echo_reply(hdr: &UipIcmp6Hdr) bool;
extern fn icmp6_is_neighbor_message(hdr: &UipIcmp6Hdr) bool;
extern fn icmp6_echo_reply_prepare(ip: &UipIpv6Hdr, icmp: &UipIcmp6Hdr) bool;

test "ipv6_icmp6_checksum changes with address and payload" {
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 8 as byte], proto: (UIP_PROTO_ICMP6 as! byte).value, ttl: 64 as byte, srcipaddr: [1u16,2u16,3u16,4u16,5u16,6u16,7u16,8u16], destipaddr: [9u16,10u16,11u16,12u16,13u16,14u16,15u16,16u16] };
    var icmp: UipIcmp6Hdr = UipIcmp6Hdr { type: (ICMP6_ECHO_REQUEST as! byte).value, code: 0 as byte, icmpchksum: 0u16, data: [1 as byte,2 as byte,3 as byte,4 as byte] };
    var raw: &byte = @ptr_from_usize(@usize_from_ptr(&icmp as &void)) as &byte;
    const sum1: u16 = ipv6_icmp6_checksum(&ip, raw, 8u16);
    ip.srcipaddr[0] = 99u16;
    const sum2: u16 = ipv6_icmp6_checksum(&ip, raw, 8u16);
    try assert_eq_bool(sum1 != sum2, true);
    ip.srcipaddr[0] = 1u16;
    icmp.data[0] = 9 as byte;
    const sum3: u16 = ipv6_icmp6_checksum(&ip, raw, 8u16);
    try assert_eq_bool(sum1 != sum3, true);
}

test "ipv6_icmp6_echo_input_step prepares echo reply" {
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 8 as byte], proto: (UIP_PROTO_ICMP6 as! byte).value, ttl: 64 as byte, srcipaddr: [1u16,2u16,3u16,4u16,5u16,6u16,7u16,8u16], destipaddr: [9u16,10u16,11u16,12u16,13u16,14u16,15u16,16u16] };
    var icmp: UipIcmp6Hdr = UipIcmp6Hdr { type: (ICMP6_ECHO_REQUEST as! byte).value, code: 9 as byte, icmpchksum: 0u16, data: [1 as byte,2 as byte,3 as byte,4 as byte] };
    try assert_eq_i32(ipv6_icmp6_echo_input_step(&ip, &icmp) as i32, IPV6_ICMP6_REPLY_READY);
    try assert_eq_i32(icmp.type as i32, ICMP6_ECHO_REPLY);
    try assert_eq_i32(ip.srcipaddr[0] as i32, 9);
    try assert_eq_bool(icmp.icmpchksum != 0u16, true);
}

test "ipv6_icmp6_neighbor_input_step prepares na from ns" {
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 24 as byte], proto: (UIP_PROTO_ICMP6 as! byte).value, ttl: 255 as byte, srcipaddr: [1u16,2u16,3u16,4u16,5u16,6u16,7u16,8u16], destipaddr: [9u16,10u16,11u16,12u16,13u16,14u16,15u16,16u16] };
    var hdr: UipIcmp6NeighborHdr = UipIcmp6NeighborHdr { type: (ICMP6_NS as! byte).value, code: 0 as byte, icmpchksum: 0u16, flags: [0 as byte,0 as byte,0 as byte,0 as byte], targetipaddr: [100u16,101u16,102u16,103u16,104u16,105u16,106u16,107u16] };
    try assert_eq_i32(ipv6_icmp6_neighbor_input_step(&ip, &hdr) as i32, IPV6_ICMP6_REPLY_READY);
    try assert_eq_i32(hdr.type as i32, ICMP6_NA);
    try assert_eq_i32(ip.srcipaddr[0] as i32, 9);
    try assert_eq_bool(hdr.icmpchksum != 0u16, true);
}

test "icmp6_na_prepare_from_ns rewrites type and preserves target" {
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 24 as byte], proto: (UIP_PROTO_ICMP6 as! byte).value, ttl: 255 as byte, srcipaddr: [1u16,2u16,3u16,4u16,5u16,6u16,7u16,8u16], destipaddr: [9u16,10u16,11u16,12u16,13u16,14u16,15u16,16u16] };
    var hdr: UipIcmp6NeighborHdr = UipIcmp6NeighborHdr { type: (ICMP6_NS as! byte).value, code: 5 as byte, icmpchksum: 0u16, flags: [0 as byte,0 as byte,0 as byte,0 as byte], targetipaddr: [100u16,101u16,102u16,103u16,104u16,105u16,106u16,107u16] };
    try assert_eq_bool(icmp6_na_prepare_from_ns(&ip, &hdr), true);
    try assert_eq_i32(hdr.type as i32, ICMP6_NA);
    try assert_eq_i32(hdr.code as i32, 0);
    try assert_eq_i32(hdr.flags[0] as i32, 0x60);
    try assert_eq_i32(icmp6_neighbor_target(&hdr)[0] as i32, 100);
    try assert_eq_i32(ip.srcipaddr[0] as i32, 9);
    try assert_eq_i32(ip.destipaddr[0] as i32, 1);
    try assert_eq_bool(hdr.icmpchksum != 0u16, true);
}

test "ipv6_input_classify routes by next header" {
    var hdr: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 8 as byte], proto: (UIP_PROTO_ICMP6 as! byte).value, ttl: 64 as byte, srcipaddr: [0u16: 8], destipaddr: [0u16: 8] };
    try assert_eq_i32(ipv6_next_header(&hdr) as i32, UIP_PROTO_ICMP6);
    try assert_eq_bool(ipv6_is_icmp6(&hdr), true);
    try assert_eq_i32(ipv6_input_classify(&hdr) as i32, IPV6_INPUT_ICMP6);
    hdr.proto = (UIP_PROTO_TCP as! byte).value;
    try assert_eq_bool(ipv6_is_tcp(&hdr), true);
    try assert_eq_i32(ipv6_input_classify(&hdr) as i32, IPV6_INPUT_TCP);
    hdr.proto = (UIP_PROTO_UDP as! byte).value;
    try assert_eq_bool(ipv6_is_udp(&hdr), true);
    try assert_eq_i32(ipv6_input_classify(&hdr) as i32, IPV6_INPUT_UDP);
    hdr.vtc = 0x40 as byte;
    try assert_eq_i32(ipv6_input_classify(&hdr) as i32, IPV6_INPUT_DROP);
}

test "ipv6_version_ok accepts version 6 header" {
    var hdr: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 8 as byte], proto: (UIP_PROTO_ICMP6 as! byte).value, ttl: 64 as byte, srcipaddr: [0u16: 8], destipaddr: [0u16: 8] };
    try assert_eq_bool(ipv6_version_ok(&hdr), true);
    hdr.vtc = 0x40 as byte;
    try assert_eq_bool(ipv6_version_ok(&hdr), false);
}

test "icmp6 helpers classify message kinds" {
    var hdr: UipIcmp6Hdr = UipIcmp6Hdr { type: (ICMP6_ECHO_REQUEST as! byte).value, code: 0 as byte, icmpchksum: 0u16, data: [0 as byte,0 as byte,0 as byte,0 as byte] };
    try assert_eq_i32(icmp6_type(&hdr) as i32, ICMP6_ECHO_REQUEST);
    try assert_eq_bool(icmp6_is_echo_request(&hdr), true);
    try assert_eq_bool(icmp6_is_echo_reply(&hdr), false);
    try assert_eq_bool(icmp6_is_ns(&hdr), false);
    hdr.type = (ICMP6_NS as! byte).value;
    try assert_eq_bool(icmp6_is_ns(&hdr), true);
    try assert_eq_bool(icmp6_is_neighbor_message(&hdr), true);
    hdr.type = (ICMP6_NA as! byte).value;
    try assert_eq_bool(icmp6_is_na(&hdr), true);
    try assert_eq_bool(icmp6_is_neighbor_message(&hdr), true);
    hdr.type = (ICMP6_ECHO_REPLY as! byte).value;
    try assert_eq_i32(icmp6_type(&hdr) as i32, ICMP6_ECHO_REPLY);
    try assert_eq_bool(icmp6_is_echo_reply(&hdr), true);
}

test "ipv6_process_step accepts valid tcp and udp headers" {
    var ip: UipIpv6Hdr = UipIpv6Hdr { vtc: 0x60 as byte, tcflow: 0 as byte, flow: [0 as byte, 0 as byte], len: [0 as byte, 8 as byte], proto: 6 as byte, ttl: 64 as byte, srcipaddr: [0u16: 8], destipaddr: [0u16: 8] };
    var icmp: UipIcmp6Hdr = UipIcmp6Hdr { type: (ICMP6_ECHO_REQUEST as! byte).value, code: 0 as byte, icmpchksum: 0u16, data: [0 as byte,0 as byte,0 as byte,0 as byte] };
    try assert_eq_i32(ipv6_process_step(&ip, &icmp) as i32, IPV6_PROCESS_TCP);
    ip.proto = 17 as byte;
    try assert_eq_i32(ipv6_process_step(&ip, &icmp) as i32, IPV6_PROCESS_UDP);
}


