test "psock_readto_from_event zero-length callback preserves blocked-newdata state" {
    var storage: [byte: 8] = [0: 8];
    var input: [byte: 1] = [0];
    var ps: Psock = Psock {
        pt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        psockpt: Pt { lc: 0u16, yielded: false, waiting: false, exit_requested: false, restart_requested: false, spawned: false },
        sendptr: null, readptr: null, bufptr: null, sendlen: 0u16, readlen: 0u16, event_readlen: 0u16,
        buf: PsockBuf { ptr: null, left: 0u16 }, bufsize: 0, state: 0 as byte, lastlen: 0u16
    };
    psock_init(&ps, &storage[0], 8);
    ps.state = (PSOCK_STATE_BLOCKED_NEWDATA as! byte).value;
    var ev: PsockEvent = PsockEvent {
        acked: false, newdata: false, rexmit: false, closed: false, polled: true,
        timed_out: false, aborted: false, connected: false, data_len: 0u16, send_len: 0u16
    };
    try assert_eq_i32(psock_readto_from_event(&ps, &ev, 10 as byte, &input[0]) as i32, PT_WAITING);
    try assert_eq_i32(ps.state as i32, PSOCK_STATE_BLOCKED_NEWDATA);
    try assert_eq_i32(ps.event_readlen as i32, 0);
}


