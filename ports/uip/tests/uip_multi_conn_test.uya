use std.testing;

extern fn uip_init(state: &UipState) void;
extern fn uip_runtime_init(rt: &UipRuntime) void;
extern fn tcp_build_ack(state: &UipState, rt: &UipRuntime, conn_index: i32, out: &EthTcpHdr) bool;
extern fn tcp_ack_outstanding(state: &UipState, rt: &UipRuntime, conn_index: i32, frame: &UipRuntimeFrame) UipProcessResult;
extern fn tcp_established_data_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, app_slen: u16) UipProcessResult;
extern fn tcp_established_fin_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult;
extern fn tcp_syn_rcvd_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, app_slen: u16) UipProcessResult;
extern fn tcp_fin_wait_2_step(state: &UipState, rt: &UipRuntime, conn_index: i32, incoming_len: u16, has_fin: bool) UipProcessResult;
extern fn tcp_post_ack_state_step(state: &UipState, conn_index: i32, has_ack: bool) UipProcessResult;
extern fn uip_process_timer(state: &UipState, rt: &UipRuntime, conn_index: i32) UipProcessResult;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn htons(val: u16) u16;
extern const UIP_ESTABLISHED: i32;
extern const UIP_SYN_RCVD: i32;
extern const UIP_FIN_WAIT_2: i32;
extern const UIP_FIN_WAIT_1: i32;
extern const UIP_CLOSING: i32;
extern const UIP_LAST_ACK: i32;
extern const UIP_TIME_WAIT: i32;
extern const UIP_CLOSED: i32;
extern const UIP_ACKDATA: i32;
extern const UIP_CONNECTED: i32;
extern const UIP_CLOSE: i32;
extern const UIP_NEWDATA: i32;
extern const UIP_TIMEDOUT: i32;
extern const UIP_REXMIT: i32;
extern const TCP_ACK: i32;
extern const TCP_RST: i32;

struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipRuntime { frame: UipRuntimeFrame, appdata: &byte, sappdata: &byte, len: u16, uip_len: u16, uip_slen: u16, flags: byte, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, stats: &UipStats, urgdata: &byte, urglen: u16, surglen: u16, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, slen: u16, logs: [UipRuntimeLog: 16], ipid: u16, te_reply: bool }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipState { listener_ports: [u16: 20], conns: [UipConn: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }

fn zero_mac() UipEthAddr { return UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }; }

fn make_runtime() UipRuntime {
    var stats: UipStats = make_zero_stats();
    return UipRuntime { frame: UipRuntimeFrame { ethip: EthIpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16] }, ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: htons(1000u16), destport: htons(80u16), seqno: [0 as byte,0 as byte,0 as byte,10 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0x50 as byte, flags: (TCP_ACK as! byte).value, wnd: [1 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] }, ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 }, arp: ArpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: zero_mac(), sipaddr: [0u16,0u16], dhwaddr: zero_mac(), dipaddr: [0u16,0u16] } }, appdata: null, sappdata: null, len: 0u16, uip_len: 0u16, uip_slen: 0u16, flags: 0 as byte, hostaddr: UipIpAddr { words: [uip_ipaddr(10 as byte,0 as byte,0 as byte,1 as byte).words[0], uip_ipaddr(10 as byte,0 as byte,0 as byte,1 as byte).words[1]] }, draddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, stats: &stats, urgdata: null, urglen: 0u16, surglen: 0u16, logbuf: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], logcount: 0usize, logcode: 0 as byte, logparam: 0u16, current_conn: -1, current_udp_conn: -1, payload_view: null, payload_len: 0u16, input_view: null, input_len: 0u16, app_input: null, app_input_len: 0u16, app_output: null, slen: 0u16, logs: [UipRuntimeLog { code: 0 as byte, arg0: 0u16, arg1: 0u16 }: 16], ipid: 0u16, te_reply: false };
}

fn make_zero_stats() UipStats {
    return UipStats {
        ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 }
    };
}

fn make_state() UipState {
    var state: UipState = UipState { listener_ports: [0u16: 20], conns: [UipConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, rcv_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], snd_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], len: 0u16, mss: 0u16, initialmss: 0u16, sa: 0 as byte, sv: 0 as byte, rto: 0 as byte, tcpstateflags: 0 as byte, timer: 0 as byte, nrtx: 0 as byte, appstate: 0u16 }: 10], udp_conns: [UipUdpConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, ttl: 0 as byte, appstate: 0u16 }: 10], hostaddr: UipIpAddr { words: [0u16,0u16] }, stats: make_zero_stats(), iss: [0 as byte,0 as byte,0 as byte,0 as byte], lastport: 0u16 };
    return state;
}

test "tcp_build_ack works for connection index 3" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    uip_runtime_init(&rt);
    state.conns[3].lport = htons(1234u16);
    state.conns[3].rport = htons(80u16);
    const rip: UipIpAddr = uip_ipaddr(10 as byte,0 as byte,0 as byte,9 as byte);
    state.conns[3].ripaddr[0] = rip.words[0];
    state.conns[3].ripaddr[1] = rip.words[1];
    state.conns[3].snd_nxt[0] = 1 as byte; state.conns[3].snd_nxt[1] = 2 as byte; state.conns[3].snd_nxt[2] = 3 as byte; state.conns[3].snd_nxt[3] = 4 as byte;
    state.conns[3].rcv_nxt[0] = 5 as byte; state.conns[3].rcv_nxt[1] = 6 as byte; state.conns[3].rcv_nxt[2] = 7 as byte; state.conns[3].rcv_nxt[3] = 8 as byte;
    var out: EthTcpHdr = rt.frame.ethtcp;
    try assert_eq_bool(tcp_build_ack(&state, &rt, 3, &out), true);
    try assert_eq_i32(out.srcport as i32, state.conns[3].lport as i32);
    try assert_eq_i32(out.ackno[3] as i32, 8);
}

test "tcp_ack_outstanding clears in-flight len for connection index 3" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[3].len = 4u16;
    state.conns[3].snd_nxt[0] = 0 as byte; state.conns[3].snd_nxt[1] = 0 as byte; state.conns[3].snd_nxt[2] = 0 as byte; state.conns[3].snd_nxt[3] = 10 as byte;
    state.conns[3].rto = 5 as byte;
    rt.frame.ethtcp.flags = (TCP_ACK as! byte).value;
    rt.frame.ethtcp.ackno[0] = 0 as byte; rt.frame.ethtcp.ackno[1] = 0 as byte; rt.frame.ethtcp.ackno[2] = 0 as byte; rt.frame.ethtcp.ackno[3] = 14 as byte;
    const result: UipProcessResult = tcp_ack_outstanding(&state, &rt, 3, &rt.frame);
    try assert_eq_i32(result.flags as i32, UIP_ACKDATA);
    try assert_eq_i32(state.conns[3].len as i32, 0);
}

test "tcp_established_data_step handles connection index 3" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[3].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[3].initialmss = 32u16;
    state.conns[3].mss = 32u16;
    rt.flags = (UIP_ACKDATA as! byte).value;
    const result: UipProcessResult = tcp_established_data_step(&state, &rt, 3, 5u16, 7u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(state.conns[3].len as i32, 7);
    try assert_eq_i32(state.conns[3].rcv_nxt[3] as i32, 5);
}

test "tcp_established_fin_step transitions connection index 2 to last_ack" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[2].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    const result: UipProcessResult = tcp_established_fin_step(&state, &rt, 2, 2u16, true);
    try assert_eq_i32(result.flags as i32, (UIP_CLOSE | UIP_NEWDATA));
    try assert_eq_i32(state.conns[2].tcpstateflags as i32, UIP_LAST_ACK);
}

test "tcp_established_fin_step transitions connection index 3 to last_ack" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[3].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    const result: UipProcessResult = tcp_established_fin_step(&state, &rt, 3, 2u16, true);
    try assert_eq_i32(result.flags as i32, (UIP_CLOSE | UIP_NEWDATA));
    try assert_eq_i32(state.conns[3].tcpstateflags as i32, UIP_LAST_ACK);
}

test "tcp_syn_rcvd_step establishes connection index 3" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[3].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
    rt.flags = (UIP_ACKDATA as! byte).value;
    const result: UipProcessResult = tcp_syn_rcvd_step(&state, &rt, 3, 3u16, 0u16);
    try assert_eq_i32(result.flags as i32, (UIP_CONNECTED | UIP_NEWDATA));
    try assert_eq_i32(state.conns[3].tcpstateflags as i32, UIP_ESTABLISHED);
}

test "tcp_fin_wait_2_step transitions connection index 3 to time_wait" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[3].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value;
    const result: UipProcessResult = tcp_fin_wait_2_step(&state, &rt, 3, 1u16, true);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(state.conns[3].tcpstateflags as i32, UIP_TIME_WAIT);
}

test "tcp_post_ack_state_step handles closing connection index 3" {
    var state: UipState = make_state();
    uip_init(&state);
    state.conns[3].tcpstateflags = (UIP_CLOSING as! byte).value;
    _ = tcp_post_ack_state_step(&state, 3, true);
    try assert_eq_i32(state.conns[3].tcpstateflags as i32, UIP_TIME_WAIT);
}

test "uip_process_timer retransmit and timeout handle connection index 3" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    uip_init(&state);
    state.conns[3].len = 5u16;
    state.conns[3].timer = 0 as byte;
    state.conns[3].rto = 3 as byte;
    state.conns[3].nrtx = 0 as byte;
    var result: UipProcessResult = uip_process_timer(&state, &rt, 3);
    try assert_eq_i32(result.flags as i32, UIP_REXMIT);
    state.conns[3].timer = 0 as byte;
    state.conns[3].nrtx = 4 as byte;
    result = uip_process_timer(&state, &rt, 3);
    try assert_eq_i32(result.flags as i32, UIP_TIMEDOUT);
    try assert_eq_i32(state.conns[3].tcpstateflags as i32, UIP_CLOSED);
    try assert_eq_i32(rt.frame.ethtcp.flags as i32, (TCP_RST | TCP_ACK));
}
