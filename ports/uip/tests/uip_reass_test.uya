use std.testing;

extern fn uip_reass_init(state: &UipReassState) void;
extern fn uip_reass_overflow(frame: &EthIpHdr, payload_len: u16) bool;
extern fn uip_reass_step(state: &UipReassState, frame: &EthIpHdr, payload: &byte, payload_len: u16, out: &EthIpHdr) u16;
extern fn uip_packet_payload_byte(frame: &EthIpHdr, index: u16) byte;
extern fn uip_reass_tick(state: &UipReassState) void;
extern fn htons(val: u16) u16;

extern const IP_MF: i32;
extern const UIP_REASS_MAXAGE: i32;

struct Timer { start: u64, interval: u64 }
struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct ArpEntry { ipaddr: [u16: 2], ethaddr: UipEthAddr, time: byte }
struct UipArpState { ethaddr: UipEthAddr, hostaddr: UipIpAddr, netmask: UipIpAddr, draddr: UipIpAddr, table: [ArpEntry: 8], arptime: byte }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, appdata: &byte, sappdata: &byte, urgdata: &byte, len: u16, uip_len: u16, uip_slen: u16, slen: u16, urglen: u16, surglen: u16, flags: byte, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, logs: [UipRuntimeLog: 16], ipid: u16, stats: &UipStats, te_reply: bool }
struct UipReassState { buf: [byte: 386], bitmap: [byte: 6], len: u16, flags: byte, timer: byte, srcipaddr: [u16: 2], destipaddr: [u16: 2], ipid: [byte: 2], proto: byte }

fn make_hdr(ipoffset0: byte, ipoffset1: byte, total_len: u16) EthIpHdr {
    return EthIpHdr {
        ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 },
        vhl: 0x45 as byte,
        tos: 0 as byte,
        len: [((total_len >> 8) & 0xffu16) as! byte catch |_| { 0 as byte; }, (total_len & 0xffu16) as! byte catch |_| { 0 as byte; }],
        ipid: [0x12 as byte, 0x34 as byte],
        ipoffset: [ipoffset0, ipoffset1],
        ttl: 64 as byte,
        proto: 6 as byte,
        ipchksum: 0u16,
        srcipaddr: [htons(0x0a00u16), htons(0x0001u16)],
        destipaddr: [htons(0x0a00u16), htons(0x0002u16)]
    };
}

test "uip_packet_payload_byte reads payload bytes after IPv4 header" {
    var frame_and_payload: [byte: 32] = [0 as byte: 32];
    var hdr: &EthIpHdr = @ptr_from_usize(@usize_from_ptr(&frame_and_payload[0] as &void)) as &EthIpHdr;
    hdr.vhl = 0x45 as byte;
    frame_and_payload[20] = 0x11 as byte;
    frame_and_payload[21] = 0x22 as byte;
    frame_and_payload[22] = 0x33 as byte;
    try assert_eq_i32(uip_packet_payload_byte(hdr, 0u16) as i32, 0x11);
    try assert_eq_i32(uip_packet_payload_byte(hdr, 1u16) as i32, 0x22);
    try assert_eq_i32(uip_packet_payload_byte(hdr, 2u16) as i32, 0x33);
}

test "uip_reass_step last fragment first stays pending" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var last: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var p1: [byte: 4] = [9,10,11,12];
    try assert_eq_i32(uip_reass_step(&state, &last, &p1[0], 4u16, &out) as i32, 0);
    try assert_eq_i32(state.len as i32, 12);
    try assert_eq_i32(state.timer as i32, UIP_REASS_MAXAGE);
}


test "uip_reass_step completes when first fragment arrives after last" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var last: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var first: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var p1: [byte: 4] = [9,10,11,12];
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    try assert_eq_i32(uip_reass_step(&state, &last, &p1[0], 4u16, &out) as i32, 0);
    try assert_eq_i32(uip_reass_step(&state, &first, &p0[0], 8u16, &out) as i32, 12);
    try assert_eq_i32(out.ipoffset[0] as i32, 0);
    try assert_eq_i32(out.ipoffset[1] as i32, 0);
}

test "uip_reass_debug last then first exposes bitmap state" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var last: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var first: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var p1: [byte: 4] = [9,10,11,12];
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    _ = uip_reass_step(&state, &last, &p1[0], 4u16, &out);
    _ = uip_reass_step(&state, &first, &p0[0], 8u16, &out);
    try assert_eq_i32(state.len as i32, 12);
    try assert_eq_i32(state.flags as i32, UIP_REASS_FLAG_LASTFRAG);
    try assert_eq_i32(state.bitmap[0] as i32, 3);
}

test "uip_reass_step ignores new datagram identity until current partial expires" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag_new: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    frag_new.ipid[1] = 0x35 as byte;
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 8] = [9,10,11,12,13,14,15,16];
    try assert_eq_i32(uip_reass_step(&state, &frag0, &p0[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.timer as i32, UIP_REASS_MAXAGE);
    try assert_eq_i32(state.buf[20] as i32, 1);
    try assert_eq_i32(uip_reass_step(&state, &frag_new, &p1[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.buf[20] as i32, 1);
    while state.timer > 0 as byte {
        uip_reass_tick(&state);
    }
    try assert_eq_i32(uip_reass_step(&state, &frag_new, &p1[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.buf[20] as i32, 9);
    try assert_eq_i32(state.ipid[1] as i32, 0x35);
}

test "uip_reass_step keeps current partial datagram when different identity arrives before expiry" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var other: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    other.ipid[1] = 0x35 as byte;
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 8] = [9,10,11,12,13,14,15,16];
    try assert_eq_i32(uip_reass_step(&state, &frag0, &p0[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.timer as i32, UIP_REASS_MAXAGE);
    try assert_eq_i32(state.buf[20] as i32, 1);
    try assert_eq_i32(uip_reass_step(&state, &other, &p1[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.buf[20] as i32, 1);
    try assert_eq_i32(state.ipid[1] as i32, 0x34);
}

test "uip_reass_init clears timer and length" {
    var state: UipReassState = UipReassState { buf: [1 as byte: 386], bitmap: [1 as byte: 6], len: 9u16, flags: 3 as byte, timer: 4 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    uip_reass_init(&state);
    try assert_eq_i32(state.len as i32, 0);
    try assert_eq_i32(state.timer as i32, 0);
}


test "uip_reass_overflow detects too large fragment window" {
    var hdr: EthIpHdr = make_hdr(0x1f as byte, 0xff as byte, 60u16);
    try assert_eq_bool(uip_reass_overflow(&hdr, 0u16), true);
}

test "uip_reass_overflow detects offset plus payload exceeding buffer" {
    var hdr: EthIpHdr = make_hdr(0x00 as byte, 0x20 as byte, 24u16);
    try assert_eq_bool(uip_reass_overflow(&hdr, 131u16), true);
    try assert_eq_bool(uip_reass_overflow(&hdr, 130u16), false);
}

test "uip_reass_step first fragment arms timer" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    try assert_eq_i32(uip_reass_step(&state, &frag0, &p0[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.timer as i32, UIP_REASS_MAXAGE);
}

test "uip_reass_step completes after last fragment" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag1: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 4] = [9,10,11,12];
    try assert_eq_i32(uip_reass_step(&state, &frag0, &p0[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(state.timer as i32, UIP_REASS_MAXAGE);
    try assert_eq_i32(uip_reass_step(&state, &frag1, &p1[0], 4u16, &out) as i32, 12);
}


test "uip_reass_step duplicate fragment keeps completion state stable" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag1: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 4] = [9,10,11,12];
    _ = uip_reass_step(&state, &frag0, &p0[0], 8u16, &out);
    try assert_eq_i32(uip_reass_step(&state, &frag1, &p1[0], 4u16, &out) as i32, 12);
    try assert_eq_i32(state.timer as i32, 0);
    try assert_eq_i32(uip_reass_step(&state, &frag1, &p1[0], 4u16, &out) as i32, 0);
    try assert_eq_i32(state.timer as i32, UIP_REASS_MAXAGE);
}


test "uip_reass_tick expiry clears partial datagram on next fragment" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag1: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 4] = [9,10,11,12];
    _ = uip_reass_step(&state, &frag0, &p0[0], 8u16, &out);
    while state.timer > 0 as byte {
        uip_reass_tick(&state);
    }
    try assert_eq_i32(state.timer as i32, 0);
    try assert_eq_i32(uip_reass_step(&state, &frag1, &p1[0], 4u16, &out) as i32, 0);
    try assert_eq_i32(state.len as i32, 12);
    try assert_eq_i32(state.bitmap[0] as i32, 2);
}


test "uip_reass_step reassembles four fragments across bitmap bytes" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 84u16);
    var frag1: EthIpHdr = make_hdr((IP_MF as! byte).value, 8 as byte, 84u16);
    var frag2: EthIpHdr = make_hdr((IP_MF as! byte).value, 16 as byte, 84u16);
    var frag3: EthIpHdr = make_hdr(0 as byte, 24 as byte, 28u16);
    var p0: [byte: 64] = [1 as byte: 64];
    var p1: [byte: 64] = [2 as byte: 64];
    var p2: [byte: 64] = [3 as byte: 64];
    var p3: [byte: 8] = [4 as byte: 8];
    try assert_eq_i32(uip_reass_step(&state, &frag2, &p2[0], 64u16, &out) as i32, 0);
    try assert_eq_i32(uip_reass_step(&state, &frag0, &p0[0], 64u16, &out) as i32, 0);
    try assert_eq_i32(uip_reass_step(&state, &frag3, &p3[0], 8u16, &out) as i32, 0);
    try assert_eq_i32(uip_reass_step(&state, &frag1, &p1[0], 64u16, &out) as i32, 200);
    try assert_eq_i32(out.len[0] as i32, 0);
    try assert_eq_i32(out.len[1] as i32, 220);
}

test "uip_reass_step duplicate fragment does not corrupt previously buffered payload" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag1: EthIpHdr = make_hdr(0 as byte, 1 as byte, 24u16);
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 4] = [9,10,11,12];
    var dup: [byte: 8] = [101,102,103,104,105,106,107,108];
    _ = uip_reass_step(&state, &frag0, &p0[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 1);
    _ = uip_reass_step(&state, &frag0, &dup[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 1);
    try assert_eq_i32(uip_reass_step(&state, &frag1, &p1[0], 4u16, &out) as i32, 12);
}

test "uip_reass_step overlapping fragment does not overwrite earlier bytes" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var overlap: EthIpHdr = make_hdr(0 as byte, 0 as byte, 24u16);
    overlap.ipoffset[1] = 0 as byte;
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 4] = [9,10,11,12];
    _ = uip_reass_step(&state, &frag0, &p0[0], 8u16, &out);
    _ = uip_reass_step(&state, &overlap, &p1[0], 4u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 1);
    try assert_eq_i32(state.buf[21] as i32, 2);
    try assert_eq_i32(state.buf[22] as i32, 3);
    try assert_eq_i32(state.buf[23] as i32, 4);
}

test "uip_reass_step switches datagram identity on src change only after expiry" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag_new: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    frag_new.srcipaddr[1] = htons(0x0003u16);
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 8] = [9,10,11,12,13,14,15,16];
    _ = uip_reass_step(&state, &frag0, &p0[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 1);
    _ = uip_reass_step(&state, &frag_new, &p1[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 1);
    while state.timer > 0 as byte {
        uip_reass_tick(&state);
    }
    _ = uip_reass_step(&state, &frag_new, &p1[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 9);
    try assert_eq_i32(state.srcipaddr[1] as i32, htons(0x0003u16) as i32);
}

test "uip_reass_step switches datagram identity on proto change only after expiry" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 0 as byte, srcipaddr: [0u16, 0u16], destipaddr: [0u16, 0u16], ipid: [0 as byte, 0 as byte], proto: 0 as byte };
    var out: EthIpHdr = make_hdr(0 as byte, 0 as byte, 0u16);
    var frag0: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    var frag_new: EthIpHdr = make_hdr((IP_MF as! byte).value, 0 as byte, 28u16);
    frag_new.proto = 17 as byte;
    var p0: [byte: 8] = [1,2,3,4,5,6,7,8];
    var p1: [byte: 8] = [9,10,11,12,13,14,15,16];
    _ = uip_reass_step(&state, &frag0, &p0[0], 8u16, &out);
    _ = uip_reass_step(&state, &frag_new, &p1[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 1);
    try assert_eq_i32(state.proto as i32, 6);
    while state.timer > 0 as byte {
        uip_reass_tick(&state);
    }
    _ = uip_reass_step(&state, &frag_new, &p1[0], 8u16, &out);
    try assert_eq_i32(state.buf[20] as i32, 9);
    try assert_eq_i32(state.proto as i32, 17);
}

test "uip_reass_tick counts down active timer to zero" {
    var state: UipReassState = UipReassState { buf: [0 as byte: 386], bitmap: [0 as byte: 6], len: 0u16, flags: 0 as byte, timer: 2 as byte, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], ipid: [0 as byte,0 as byte], proto: 0 as byte };
    uip_reass_tick(&state);
    try assert_eq_i32(state.timer as i32, 1);
    uip_reass_tick(&state);
    try assert_eq_i32(state.timer as i32, 0);
    uip_reass_tick(&state);
    try assert_eq_i32(state.timer as i32, 0);
}


