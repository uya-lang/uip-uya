struct EthIpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2]
}

struct EthTcpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    seqno: [byte: 4],
    ackno: [byte: 4],
    tcpoffset: byte,
    flags: byte,
    wnd: [byte: 2],
    tcpchksum: u16,
    urgp: u16,
    optdata: [byte: 4]
}

struct EthUdpHdr {
    ethhdr: UipEthHdr,
    vhl: byte,
    tos: byte,
    len: [byte: 2],
    ipid: [byte: 2],
    ipoffset: [byte: 2],
    ttl: byte,
    proto: byte,
    ipchksum: u16,
    srcipaddr: [u16: 2],
    destipaddr: [u16: 2],
    srcport: u16,
    destport: u16,
    udplen: u16,
    udpchksum: u16
}

struct UipFrame {
    ethip: EthIpHdr,
    ethtcp: EthTcpHdr,
    ethudp: EthUdpHdr,
    arp: ArpHdr
}

struct UipRuntime {
    frame: UipFrame,
    hostaddr: UipIpAddr,
    draddr: UipIpAddr,
    netmask: UipIpAddr,
    appdata: &byte,
    sappdata: &byte,
    len: u16,
    slen: u16,
    flags: byte,
    current_conn: i32,
    current_udp_conn: i32,
    acc32: [byte: 4],
    ipid: u16,
    iss: [byte: 4]
}

struct UipProcessResult {
    flags: byte,
    len: u16,
    poll: bool,
    timed_out: bool,
    retransmit: bool,
    appcall: bool,
    closed: bool
}

struct ArpHdr {
    ethhdr: UipEthHdr,
    hwtype: u16,
    protocol: u16,
    hwlen: byte,
    protolen: byte,
    opcode: u16,
    shwaddr: UipEthAddr,
    sipaddr: [u16: 2],
    dhwaddr: UipEthAddr,
    dipaddr: [u16: 2]
}

struct UipEthHdr {
    dest: UipEthAddr,
    src: UipEthAddr,
    type: u16
}

struct UipEthAddr {
    addr: [byte: 6]
}

struct UipArpState {
    ethaddr: UipEthAddr,
    hostaddr: UipIpAddr,
    netmask: UipIpAddr,
    draddr: UipIpAddr,
    table: [ArpEntry: 8],
    arptime: byte
}

struct ArpEntry {
    ipaddr: [u16: 2],
    ethaddr: UipEthAddr,
    time: byte
}

struct UipConn {
    ripaddr: UipIpAddr,
    lport: u16,
    rport: u16,
    rcv_nxt: [byte: 4],
    snd_nxt: [byte: 4],
    len: u16,
    mss: u16,
    initialmss: u16,
    sa: byte,
    sv: byte,
    rto: byte,
    tcpstateflags: byte,
    timer: byte,
    nrtx: byte,
    appstate: u16
}

struct UipUdpConn {
    ripaddr: UipIpAddr,
    lport: u16,
    rport: u16,
    ttl: byte,
    appstate: u16
}

struct UipState {
    listenports: [u16: 20],
    conns: [UipConn: 10],
    udp_conns: [UipUdpConn: 10],
    acc32: [byte: 4],
    flags: byte,
    len: u16,
    lastport: u16
}

struct Timer {
    start: u64,
    interval: u64
}

struct UipIpAddr {
    words: [u16: 2]
}

fn make_runtime() UipRuntime {
    var rt: UipRuntime = UipRuntime {
        frame: UipFrame {
            ethip: EthIpHdr {
                ethhdr: UipEthHdr {
                    dest: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    src: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    type: 0u16
                },
                vhl: 0 as byte,
                tos: 0 as byte,
                len: [0 as byte, 0 as byte],
                ipid: [0 as byte, 0 as byte],
                ipoffset: [0 as byte, 0 as byte],
                ttl: 0 as byte,
                proto: 0 as byte,
                ipchksum: 0u16,
                srcipaddr: [0u16, 0u16],
                destipaddr: [0u16, 0u16]
            },
            ethtcp: EthTcpHdr {
                ethhdr: UipEthHdr {
                    dest: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    src: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    type: 0u16
                },
                vhl: 0 as byte,
                tos: 0 as byte,
                len: [0 as byte, 0 as byte],
                ipid: [0 as byte, 0 as byte],
                ipoffset: [0 as byte, 0 as byte],
                ttl: 0 as byte,
                proto: 0 as byte,
                ipchksum: 0u16,
                srcipaddr: [0u16, 0u16],
                destipaddr: [0u16, 0u16],
                srcport: 0u16,
                destport: 0u16,
                seqno: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
                ackno: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
                tcpoffset: 0 as byte,
                flags: 0 as byte,
                wnd: [0 as byte, 0 as byte],
                tcpchksum: 0u16,
                urgp: 0u16,
                optdata: [0 as byte, 0 as byte, 0 as byte, 0 as byte]
            },
            ethudp: EthUdpHdr {
                ethhdr: UipEthHdr {
                    dest: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    src: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    type: 0u16
                },
                vhl: 0 as byte,
                tos: 0 as byte,
                len: [0 as byte, 0 as byte],
                ipid: [0 as byte, 0 as byte],
                ipoffset: [0 as byte, 0 as byte],
                ttl: 0 as byte,
                proto: 0 as byte,
                ipchksum: 0u16,
                srcipaddr: [0u16, 0u16],
                destipaddr: [0u16, 0u16],
                srcport: 0u16,
                destport: 0u16,
                udplen: 0u16,
                udpchksum: 0u16
            },
            arp: ArpHdr {
                ethhdr: UipEthHdr {
                    dest: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    src: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                    type: 0u16
                },
                hwtype: 0u16,
                protocol: 0u16,
                hwlen: 0 as byte,
                protolen: 0 as byte,
                opcode: 0u16,
                shwaddr: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                sipaddr: [0u16, 0u16],
                dhwaddr: UipEthAddr { addr: [0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte, 0 as byte] },
                dipaddr: [0u16, 0u16]
            }
        },
        hostaddr: UipIpAddr { words: [0u16, 0u16] },
        draddr: UipIpAddr { words: [0u16, 0u16] },
        netmask: UipIpAddr { words: [0u16, 0u16] },
        appdata: null,
        sappdata: null,
        len: 0u16,
        slen: 0u16,
        flags: 0 as byte,
        current_conn: 0,
        current_udp_conn: 0,
        acc32: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        ipid: 0u16,
        iss: [0 as byte, 0 as byte, 0 as byte, 0 as byte]
    };
    return rt;
}

fn make_state() UipState {
    var state: UipState = UipState {
        listenports: [0u16: 20],
        conns: [UipConn {
            ripaddr: UipIpAddr { words: [0u16, 0u16] },
            lport: 0u16,
            rport: 0u16,
            rcv_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            snd_nxt: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
            len: 0u16,
            mss: 0u16,
            initialmss: 0u16,
            sa: 0 as byte,
            sv: 0 as byte,
            rto: 0 as byte,
            tcpstateflags: 0 as byte,
            timer: 0 as byte,
            nrtx: 0 as byte,
            appstate: 0u16
        }: 10],
        udp_conns: [UipUdpConn {
            ripaddr: UipIpAddr { words: [0u16, 0u16] },
            lport: 0u16,
            rport: 0u16,
            ttl: 0 as byte,
            appstate: 0u16
        }: 10],
        acc32: [0 as byte, 0 as byte, 0 as byte, 0 as byte],
        flags: 0 as byte,
        len: 0u16,
        lastport: 0u16
    };
    return state;
}

test "tcp_build_ack and derivatives populate tuple and flags" {
    var rt: UipRuntime = make_runtime();
    var state: UipState = make_state();
    rt.hostaddr = uip_ipaddr(192, 168, 1, 2);
    state.conns[0].ripaddr = uip_ipaddr(192, 168, 1, 9);
    state.conns[0].lport = htons(80u16);
    state.conns[0].rport = htons(1234u16);
    state.conns[0].snd_nxt[3] = 7 as byte;
    state.conns[0].rcv_nxt[3] = 9 as byte;
    var out: EthTcpHdr = rt.frame.ethtcp;
    try assert_eq_bool(tcp_build_ack(&state, &rt, 0, &out), true);
    try assert_eq_i32(out.srcport as i32, htons(80u16) as i32);
    try assert_eq_i32(out.destport as i32, htons(1234u16) as i32);
    try assert_eq_i32(out.seqno[3] as i32, 7);
    try assert_eq_i32(out.ackno[3] as i32, 9);
    try assert_eq_i32(out.flags as i32, TCP_ACK);
    try assert_eq_i32(out.tcpoffset as i32, 0x50);
    try assert_eq_bool(tcp_build_synack(&state, &rt, 0, &out), true);
    try assert_eq_i32(out.flags as i32, TCP_SYN | TCP_ACK);
    try assert_eq_i32(out.tcpoffset as i32, 0x60);
    try assert_eq_i32(out.optdata[0] as i32, TCP_OPT_MSS);
    try assert_eq_i32(out.optdata[1] as i32, TCP_OPT_MSS_LEN);
    try assert_eq_bool(tcp_build_finack(&state, &rt, 0, &out), true);
    try assert_eq_i32(out.flags as i32, TCP_FIN | TCP_ACK);
}

test "tcp_ack_only_step reports ackdata for time_wait" {
    var state: UipState = make_state();
    state.conns[0].tcpstateflags = (UIP_TIME_WAIT as! byte).value;
    const result: UipProcessResult = tcp_ack_only_step(&state, 0, true, 0u16, false, false);
    try assert_eq_i32(result.flags as i32, UIP_ACKDATA);
}
