test "tcp_data_len subtracts ip and tcp header lengths" {
    var state: UipState = make_state();
    _ = state;
    var rt: UipRuntime = make_runtime();
    rt.frame.ethtcp.tcpoffset = 0x60 as byte;
    try assert_eq_i32(tcp_data_len(&rt.frame, 44u16) as i32, 0);
    try assert_eq_i32(tcp_data_len(&rt.frame, 48u16) as i32, 4);
}

test "tcp_seq_matches requires exact rcv_nxt for data segments" {
    var state: UipState = make_state();
    state.conns[0].rcv_nxt[0] = 0 as byte;
    state.conns[0].rcv_nxt[1] = 0 as byte;
    state.conns[0].rcv_nxt[2] = 0 as byte;
    state.conns[0].rcv_nxt[3] = 9 as byte;
    var rt: UipRuntime = make_runtime();
    rt.frame.ethtcp.seqno[3] = 9 as byte;
    try assert_eq_bool(tcp_seq_matches(&state.conns[0], &rt.frame, 3u16), true);
    rt.frame.ethtcp.seqno[3] = 8 as byte;
    try assert_eq_bool(tcp_seq_matches(&state.conns[0], &rt.frame, 3u16), false);
}

test "uip_process_tcp_core sends ack on sequence mismatch with data" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].lport = htons(80u16);
    state.conns[0].rport = htons(1234u16);
    state.conns[0].ripaddr[0] = uip_ipaddr(10,0,0,1).words[0];
    state.conns[0].ripaddr[1] = uip_ipaddr(10,0,0,1).words[1];
    state.conns[0].snd_nxt[3] = 7 as byte;
    state.conns[0].rcv_nxt[3] = 9 as byte;
    rt.hostaddr = uip_ipaddr(10,0,0,2);
    rt.frame.ethtcp.seqno[3] = 8 as byte;
    rt.frame.ethtcp.flags = (TCP_ACK as! byte).value;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 3u16, true, false, 0u16);
    try assert_eq_i32(result.len as i32, 1);
    try assert_eq_i32(rt.frame.ethtcp.flags as i32, TCP_ACK);
    try assert_eq_i32(rt.frame.ethtcp.ackno[3] as i32, 9);
    try assert_eq_i32(rt.stats.tcp.sent as i32, 1);
}

test "uip_process_timer retransmits outstanding data on expiry" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].len = 12u16;
    state.conns[0].timer = 0 as byte;
    state.conns[0].rto = 3 as byte;
    state.conns[0].nrtx = 0 as byte;
    const result: UipProcessResult = uip_process_timer(&state, &rt, 0);
    try assert_eq_bool(result.retransmit, true);
    try assert_eq_i32(result.flags as i32, UIP_REXMIT);
    try assert_eq_i32(state.conns[0].nrtx as i32, 1);
    try assert_eq_i32(state.conns[0].timer as i32, 3);
}

test "uip_process_timer times out after too many retransmissions" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].len = 4u16;
    state.conns[0].timer = 0 as byte;
    state.conns[0].rto = 2 as byte;
    state.conns[0].nrtx = 4 as byte;
