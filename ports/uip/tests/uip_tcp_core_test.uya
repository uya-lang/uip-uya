test "tcp_build_ack and derivatives populate tuple and flags" {
    var rt: UipRuntime = make_runtime();
    var state: UipState = make_state();
    rt.hostaddr = uip_ipaddr(192, 168, 1, 2);
    state.conns[0].ripaddr[0] = uip_ipaddr(192, 168, 1, 9).words[0];
    state.conns[0].ripaddr[1] = uip_ipaddr(192, 168, 1, 9).words[1];
    state.conns[0].lport = htons(80u16);
    state.conns[0].rport = htons(1234u16);
    state.conns[0].snd_nxt[3] = 7 as byte;
    state.conns[0].rcv_nxt[3] = 9 as byte;
    var out: EthTcpHdr = rt.frame.ethtcp;
    try assert_eq_bool(tcp_build_ack(&state, &rt, 0, &out), true);
    try assert_eq_i32(out.srcport as i32, htons(80u16) as i32);
    try assert_eq_i32(out.destport as i32, htons(1234u16) as i32);
    try assert_eq_i32(out.seqno[3] as i32, 7);
    try assert_eq_i32(out.ackno[3] as i32, 9);
    try assert_eq_i32(out.flags as i32, TCP_ACK);
    try assert_eq_i32(out.tcpoffset as i32, 0x50);
    try assert_eq_bool(tcp_build_synack(&state, &rt, 0, &out), true);
    try assert_eq_i32(out.flags as i32, TCP_SYN | TCP_ACK);
    try assert_eq_i32(out.tcpoffset as i32, 0x60);
    try assert_eq_i32(out.optdata[0] as i32, TCP_OPT_MSS);
    try assert_eq_i32(out.optdata[1] as i32, TCP_OPT_MSS_LEN);
    try assert_eq_bool(tcp_build_finack(&state, &rt, 0, &out), true);
    try assert_eq_i32(out.flags as i32, TCP_FIN | TCP_ACK);
}



