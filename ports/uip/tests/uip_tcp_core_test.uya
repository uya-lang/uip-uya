    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
    rt.flags = (UIP_ACKDATA as! byte).value;
    rt.slen = 44u16;
    const result: UipProcessResult = tcp_syn_rcvd_step(&state, &rt, 0, 0u16, 0u16);
    try assert_eq_i32(result.flags as i32, UIP_CONNECTED);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(rt.slen as i32, 0);
    try assert_eq_i32(result.len as i32, 0);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_ESTABLISHED);
}

test "uip_process_core fin_wait_2 plus fin sends ack and bumps sent stats" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    rt.hostaddr = uip_ipaddr(10,0,0,2);
    state.conns[0].tcpstateflags = (UIP_FIN_WAIT_2 as! byte).value;
    state.conns[0].lport = htons(80u16);
    state.conns[0].rport = htons(1234u16);
    state.conns[0].ripaddr[0] = uip_ipaddr(10,0,0,1).words[0];
    state.conns[0].ripaddr[1] = uip_ipaddr(10,0,0,1).words[1];
    state.conns[0].snd_nxt[3] = 7 as byte;
    state.conns[0].rcv_nxt[3] = 9 as byte;
    _ = uip_process_core(&state, &rt, 0, 0, 0u16, false, true, 0u16);
    try assert_eq_i32(rt.frame.ethtcp.flags as i32, TCP_ACK);
    try assert_eq_i32(rt.stats.tcp.sent as i32, 1);
}



test "uip_process_timer idle established connection does not appcall or change lengths" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].len = 0u16;
    state.conns[0].timer = 3 as byte;
    rt.slen = 22u16;
    const result: UipProcessResult = uip_process_timer(&state, &rt, 0);
    try assert_eq_bool(result.appcall, false);
    try assert_eq_bool(result.retransmit, false);
    try assert_eq_i32(result.flags as i32, 0);
    try assert_eq_i32(result.len as i32, 0);
    try assert_eq_i32(rt.slen as i32, 22);
    try assert_eq_i32(state.conns[0].len as i32, 0);
}

test "ack_outstanding before established_data_step clears outstanding len and later ack appcall keeps it cleared" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].len = 4u16;
    state.conns[0].snd_nxt[3] = 10 as byte;
    state.conns[0].timer = 2 as byte;
    state.conns[0].rto = 5 as byte;
    state.conns[0].sa = 0 as byte;
    state.conns[0].sv = 4 as byte;
    state.conns[0].nrtx = 0 as byte;
    rt.frame.ethtcp.flags = (TCP_ACK as! byte).value;
    rt.frame.ethtcp.ackno[3] = 14 as byte;
    const acked: UipProcessResult = tcp_ack_outstanding(&state, &rt, 0, &rt.frame);
    try assert_eq_i32(acked.flags as i32, UIP_ACKDATA);
    try assert_eq_i32(state.conns[0].len as i32, 0);
    rt.flags = (UIP_ACKDATA as! byte).value;
    rt.slen = 77u16;
    rt.frame.ethtcp.wnd[0] = 0 as byte;
    rt.frame.ethtcp.wnd[1] = 8 as byte;
    const result: UipProcessResult = tcp_established_data_step(&state, &rt, 0, 0u16, 0u16);
    try assert_eq_i32(result.flags as i32, UIP_ACKDATA);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(state.conns[0].len as i32, 0);
    try assert_eq_i32(rt.slen as i32, 0);
}

test "tcp_ack_outstanding exact ack advances snd_nxt clears len and refreshes timer" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].len = 4u16;
    state.conns[0].snd_nxt[3] = 10 as byte;
    state.conns[0].timer = 2 as byte;
    state.conns[0].rto = 5 as byte;
    state.conns[0].sa = 0 as byte;
    state.conns[0].sv = 4 as byte;
    state.conns[0].nrtx = 0 as byte;
    rt.frame.ethtcp.flags = (TCP_ACK as! byte).value;
    rt.frame.ethtcp.ackno[0] = 0 as byte;
    rt.frame.ethtcp.ackno[1] = 0 as byte;
    rt.frame.ethtcp.ackno[2] = 0 as byte;
    rt.frame.ethtcp.ackno[3] = 14 as byte;
    const result: UipProcessResult = tcp_ack_outstanding(&state, &rt, 0, &rt.frame);
    try assert_eq_i32(result.flags as i32, UIP_ACKDATA);
    try assert_eq_i32(state.conns[0].snd_nxt[3] as i32, 14);
    try assert_eq_i32(state.conns[0].len as i32, 0);
    try assert_eq_i32(state.conns[0].timer as i32, state.conns[0].rto as i32);
}


test "uip_process_tcp_core last_ack ack closes immediately" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_LAST_ACK as! byte).value;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 0u16, true, false, 0u16);
    try assert_eq_bool(result.closed, true);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_CLOSED);
}



test "tcp_ack_outstanding mismatched ack leaves outstanding send untouched" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].len = 4u16;
    state.conns[0].snd_nxt[3] = 10 as byte;
    state.conns[0].timer = 2 as byte;
    state.conns[0].rto = 5 as byte;
    rt.frame.ethtcp.flags = (TCP_ACK as! byte).value;
    rt.frame.ethtcp.ackno[3] = 13 as byte;
    const result: UipProcessResult = tcp_ack_outstanding(&state, &rt, 0, &rt.frame);
    try assert_eq_i32(result.flags as i32, 0);
    try assert_eq_i32(state.conns[0].snd_nxt[3] as i32, 10);
    try assert_eq_i32(state.conns[0].len as i32, 4);
    try assert_eq_i32(state.conns[0].timer as i32, 2);
}

test "uip_process_tcp_core closing state ack moves to time_wait" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_CLOSING as! byte).value;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 0u16, true, false, 0u16);
    try assert_eq_bool(result.closed, false);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_TIME_WAIT);
}



test "uip_process_tcp_core stopped plus rst closes before fin semantics" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_STOPPED as! byte).value;
    rt.frame.ethtcp.flags = (TCP_RST as! byte).value;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 3u16, false, true, 0u16);
    try assert_eq_bool(result.closed, true);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_CLOSED);
}

test "uip_process_tcp_core fin_wait_1 ack moves to fin_wait_2" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_FIN_WAIT_1 as! byte).value;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 0u16, true, false, 0u16);
    try assert_eq_bool(result.closed, false);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_FIN_WAIT_2);
}


test "uip_process_tcp_core established fin with outstanding data defers close and stays established" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].len = 4u16;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 0u16, false, true, 0u16);
    try assert_eq_i32(result.flags as i32, 0);
    try assert_eq_bool(result.closed, false);
    try assert_eq_bool(result.appcall, false);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_ESTABLISHED);
    try assert_eq_i32(state.conns[0].len as i32, 4);
}

test "uip_process_tcp_core fin_wait_1 fin without ack moves to closing" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_FIN_WAIT_1 as! byte).value;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 0u16, false, true, 0u16);
    try assert_eq_bool(result.closed, false);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_CLOSING);
}


test "uip_process_tcp_core established rst plus ack closes instead of acking outstanding" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].len = 5u16;
    state.conns[0].snd_nxt[3] = 9 as byte;
    rt.frame.ethtcp.flags = ((TCP_RST | TCP_ACK) as! byte).value;
    rt.frame.ethtcp.ackno[3] = 14 as byte;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 0u16, true, false, 0u16);
    try assert_eq_bool(result.closed, true);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_CLOSED);
    try assert_eq_i32(state.conns[0].snd_nxt[3] as i32, 9);
}

