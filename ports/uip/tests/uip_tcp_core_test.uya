test "tcp_established_data_step ack with app_slen refreshes runtime and output length consistently" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].initialmss = 20u16;
    state.conns[0].mss = 20u16;
    state.conns[0].len = 5u16;
    rt.flags = (UIP_ACKDATA as! byte).value;
    rt.frame.ethtcp.wnd[0] = 0 as byte;
    rt.frame.ethtcp.wnd[1] = 10 as byte;
    const result: UipProcessResult = tcp_established_data_step(&state, &rt, 0, 0u16, 7u16);
    try assert_eq_i32(result.flags as i32, UIP_ACKDATA);
    try assert_eq_i32(result.len as i32, 7);
    try assert_eq_i32(rt.slen as i32, 7);
    try assert_eq_i32(state.conns[0].len as i32, 7);
    try assert_eq_bool(result.appcall, true);
}

test "uip_process_timer rexmit keeps outstanding len for app retransmission" {
    var state: UipState = make_state();
