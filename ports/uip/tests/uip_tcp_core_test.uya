test "uip_process_core syn_rcvd reply path increments tcp sent after building ack" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_SYN_RCVD as! byte).value;
    rt.flags = (UIP_ACKDATA as! byte).value;
    rt.hostaddr = uip_ipaddr(192 as byte, 168 as byte, 0 as byte, 2 as byte);
    state.conns[0].ripaddr[0] = uip_ipaddr(10 as byte, 0 as byte, 0 as byte, 9 as byte).words[0];
    state.conns[0].ripaddr[1] = uip_ipaddr(10 as byte, 0 as byte, 0 as byte, 9 as byte).words[1];
    state.conns[0].lport = htons(80u16);
    state.conns[0].rport = htons(1234u16);
    const result: UipProcessResult = uip_process_core(&state, &rt, 0, 0, 0u16, true, false, 0u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(result.flags as i32, UIP_CONNECTED);
    try assert_eq_i32(rt.stats.tcp.sent as i32, 1);
    try assert_eq_i32(rt.frame.ethtcp.flags as i32, TCP_ACK);
}



test "uip_process_core syn_sent duplicate synack follows connected path" {
