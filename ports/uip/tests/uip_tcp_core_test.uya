test "uip_process_core unmatched connection builds rst ack reply" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    const result: UipProcessResult = uip_process_core(&state, &rt, 0, -1, 0u16, false, false, 0u16);
    try assert_eq_i32(result.flags as i32, UIP_ABORT);
    try assert_eq_i32(result.len as i32, 1);
    try assert_eq_bool(result.logged, true);
    try assert_eq_i32(rt.frame.ethtcp.flags as i32, TCP_RST | TCP_ACK);
    try assert_eq_i32(rt.frame.ethip.proto as i32, UIP_PROTO_TCP);
}

test "uip_process_core udp timer keeps preexisting payload length and poll flag only" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    rt.len = 19u16;
    rt.flags = (UIP_NEWDATA as! byte).value;
    const result: UipProcessResult = uip_process_core(&state, &rt, UIP_UDP_TIMER, 2, 0u16, false, false, 0u16);
    try assert_eq_bool(result.poll, true);
    try assert_eq_i32(result.flags as i32, UIP_POLL);
    try assert_eq_i32(result.len as i32, 19);
    try assert_eq_i32(rt.flags as i32, UIP_POLL);
    try assert_eq_i32(rt.current_conn as i32, -1);
    try assert_eq_i32(rt.current_udp_conn as i32, 2);
}


