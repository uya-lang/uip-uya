test "tcp_established_data_step uses initialmss on zero window and schedules app send" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].initialmss = 10u16;
    state.conns[0].mss = 10u16;
    rt.flags = (UIP_ACKDATA as! byte).value;
    rt.frame.ethtcp.wnd[0] = 0 as byte;
    rt.frame.ethtcp.wnd[1] = 0 as byte;
    const result: UipProcessResult = tcp_established_data_step(&state, &rt, 0, 0u16, 12u16);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(result.flags as i32, UIP_ACKDATA);
    try assert_eq_i32(state.conns[0].mss as i32, 10);
    try assert_eq_i32(state.conns[0].len as i32, 10);
    try assert_eq_i32(result.len as i32, 10);
    try assert_eq_i32(rt.stats.tcp.sent as i32, 1);
}

test "uip_process_tcp_core established data plus fin closes connection" {
    var state: UipState = make_state();
    var rt: UipRuntime = make_runtime();
    state.conns[0].tcpstateflags = (UIP_ESTABLISHED as! byte).value;
    state.conns[0].rcv_nxt[3] = 1 as byte;
    rt.frame.ethtcp.seqno[3] = 1 as byte;
    const result: UipProcessResult = uip_process_tcp_core(&state, &rt, 0, 2u16, false, true, 0u16);
    try assert_eq_i32(result.flags as i32, UIP_CLOSE | UIP_NEWDATA);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_LAST_ACK);
    try assert_eq_i32(rt.stats.tcp.sent as i32, 1);
}


