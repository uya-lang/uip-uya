    rt.frame.ethtcp.flags = ((TCP_SYN | TCP_ACK) as! byte).value;
    const result: UipProcessResult = uip_process_core(&state, &rt, 0, 0, 0u16, true, false, 0u16);
    try assert_eq_i32(result.flags as i32, UIP_CONNECTED);
    try assert_eq_bool(result.appcall, true);
    try assert_eq_i32(state.conns[0].tcpstateflags as i32, UIP_ESTABLISHED);
    try assert_eq_i32(rt.frame.ethtcp.flags as i32, (TCP_SYN | TCP_ACK));
}



