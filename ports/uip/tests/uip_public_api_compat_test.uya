use std.testing;

extern fn uip_runtime_init(rt: &UipRuntime) void;
extern fn uip_send(rt: &UipRuntime, data: &byte, len: u16) void;
extern fn uip_udp_send(rt: &UipRuntime, len: u16) void;
extern fn uip_datalen(rt: &UipRuntime) u16;
extern fn uip_close(rt: &UipRuntime) void;
extern fn uip_abort(rt: &UipRuntime) void;
extern fn uip_stop(conn: &UipConn) void;
extern fn uip_stopped(conn: &UipConn) bool;
extern fn uip_restart(rt: &UipRuntime, conn: &UipConn) void;
extern fn uip_udpconnection(rt: &UipRuntime) bool;
extern fn uip_newdata(flags: byte) bool;
extern fn uip_acked(flags: byte) bool;
extern fn uip_connected(flags: byte) bool;
extern fn uip_closed(flags: byte) bool;
extern fn uip_aborted(flags: byte) bool;
extern fn uip_timedout(flags: byte) bool;
extern fn uip_rexmit(flags: byte) bool;
extern fn uip_poll(flags: byte) bool;
extern fn uip_initialmss(conn: &UipConn) u16;
extern fn uip_mss(conn: &UipConn) u16;
extern const UIP_NEWDATA: i32;
extern const UIP_ACKDATA: i32;
extern const UIP_CONNECTED: i32;
extern const UIP_CLOSE: i32;
extern const UIP_ABORT: i32;
extern const UIP_TIMEDOUT: i32;
extern const UIP_REXMIT: i32;
extern const UIP_POLL: i32;

struct UipIpAddr { words: [u16: 2] }
struct UipEthAddr { addr: [byte: 6] }
struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct UipFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipStatsBlock { drop: u16, recv: u16, sent: u16, a: u16, b: u16, c: u16, d: u16, e: u16, f: u16 }
struct UipStatsUdpBlock { drop: u16, recv: u16, sent: u16, chkerr: u16 }
struct UipStats { ip: UipStatsBlock, icmp: UipStatsBlock, tcp: UipStatsBlock, udp: UipStatsUdpBlock }
struct UipRuntimeLog { code: byte, arg0: u16, arg1: u16 }
struct UipConn { ripaddr: [u16: 2], lport: u16, rport: u16, rcv_nxt: [byte: 4], snd_nxt: [byte: 4], len: u16, mss: u16, initialmss: u16, sa: byte, sv: byte, rto: byte, tcpstateflags: byte, timer: byte, nrtx: byte, appstate: u16 }
struct UipUdpConn { ripaddr: [u16: 2], lport: u16, rport: u16, ttl: byte, appstate: u16 }
struct UipRuntimeFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }
struct UipRuntime { frame: UipRuntimeFrame, appdata: &byte, sappdata: &byte, len: u16, uip_len: u16, uip_slen: u16, flags: byte, hostaddr: UipIpAddr, draddr: UipIpAddr, netmask: UipIpAddr, stats: &UipStats, urgdata: &byte, urglen: u16, surglen: u16, logbuf: [UipRuntimeLog: 16], logcount: usize, logcode: byte, logparam: u16, current_conn: i32, current_udp_conn: i32, payload_view: &byte, payload_len: u16, input_view: &byte, input_len: u16, app_input: &byte, app_input_len: u16, app_output: &byte, slen: u16, logs: [UipRuntimeLog: 16], ipid: u16, te_reply: bool }
struct UipProcessResult { flags: byte, len: u16, poll: bool, timed_out: bool, retransmit: bool, appcall: bool, closed: bool, logged: bool, urgdata: bool }
struct UipState { conns: [UipConn: 10], listener_ports: [u16: 10], udp_conns: [UipUdpConn: 10], hostaddr: UipIpAddr, stats: UipStats, iss: [byte: 4], lastport: u16 }
fn make_zero_stats() UipStats {
    return UipStats {
        ip: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        icmp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        tcp: UipStatsBlock { drop: 0u16, recv: 0u16, sent: 0u16, a: 0u16, b: 0u16, c: 0u16, d: 0u16, e: 0u16, f: 0u16 },
        udp: UipStatsUdpBlock { drop: 0u16, recv: 0u16, sent: 0u16, chkerr: 0u16 }
    };
}

fn zero_mac() UipEthAddr { return UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }; }
fn make_runtime() UipRuntime {
    var stats: UipStats = make_zero_stats();
    return UipRuntime { frame: UipRuntimeFrame { ethip: EthIpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16] }, ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, seqno: [0 as byte,0 as byte,0 as byte,0 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0 as byte, flags: 0 as byte, wnd: [0 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] }, ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 }, arp: ArpHdr { ethhdr: UipEthHdr { dest: zero_mac(), src: zero_mac(), type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: zero_mac(), sipaddr: [0u16,0u16], dhwaddr: zero_mac(), dipaddr: [0u16,0u16] } }, hostaddr: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, appdata: null, sappdata: null, urgdata: null, len: 0u16, slen: 0u16, urglen: 0u16, surglen: 0u16, flags: 0 as byte, current_conn: -1, current_udp_conn: -1, acc32: [0 as byte,0 as byte,0 as byte,0 as byte], ipid: 0u16, iss: [0 as byte,0 as byte,0 as byte,0 as byte], logcode: 0 as byte, logparam: 0u16, stats: &stats, te_reply: false };
}

test "flag predicates match classic uip macro behavior" {
    const flags: byte = ((UIP_NEWDATA | UIP_ACKDATA | UIP_CONNECTED | UIP_CLOSE | UIP_ABORT | UIP_TIMEDOUT | UIP_REXMIT | UIP_POLL) as! byte).value;
    try assert_eq_bool(uip_newdata(flags), true);
    try assert_eq_bool(uip_acked(flags), true);
    try assert_eq_bool(uip_connected(flags), true);
    try assert_eq_bool(uip_closed(flags), true);
    try assert_eq_bool(uip_aborted(flags), true);
    try assert_eq_bool(uip_timedout(flags), true);
    try assert_eq_bool(uip_rexmit(flags), true);
    try assert_eq_bool(uip_poll(flags), true);
}

test "close abort udp_send and udpconnection wrappers behave like public api" {
    var rt: UipRuntime = make_runtime();
    var payload: [byte: 4] = [9,8,7,6];
    uip_runtime_init(&rt);
    rt.appdata = &payload[0];
    rt.current_conn = -1;
    rt.current_udp_conn = 2;
    try assert_eq_bool(uip_udpconnection(&rt), true);
    uip_udp_send(&rt, 4u16);
    try assert_eq_i32(rt.slen as i32, 4);
    try assert_eq_bool(rt.sappdata == rt.appdata, true);
    rt.len = 7u16;
    try assert_eq_i32(uip_datalen(&rt) as i32, 7);
    uip_close(&rt);
    try assert_eq_bool(uip_closed(rt.flags), true);
    uip_abort(&rt);
    try assert_eq_bool(uip_aborted(rt.flags), true);
}

test "stop restart and mss accessors mirror original convenience macros" {
    var rt: UipRuntime = make_runtime();
    var conn: UipConn = UipConn { ripaddr: [0u16,0u16], lport: 0u16, rport: 0u16, rcv_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], snd_nxt: [0 as byte,0 as byte,0 as byte,0 as byte], len: 0u16, mss: 111u16, initialmss: 222u16, sa: 0 as byte, sv: 0 as byte, rto: 0 as byte, tcpstateflags: 0 as byte, timer: 0 as byte, nrtx: 0 as byte, appstate: 0u16 };
    uip_stop(&conn);
    try assert_eq_bool(uip_stopped(&conn), true);
    try assert_eq_i32(uip_initialmss(&conn) as i32, 222);
    try assert_eq_i32(uip_mss(&conn) as i32, 111);
    uip_restart(&rt, &conn);
    try assert_eq_bool(uip_stopped(&conn), false);
    try assert_eq_bool(uip_newdata(rt.flags), true);
}
