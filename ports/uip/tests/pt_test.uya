use std.testing;

extern fn pt_init(pt: &Pt) void;
extern fn pt_wait_until(pt: &Pt, condition: bool) byte;
extern fn pt_yield(pt: &Pt) byte;
extern fn pt_exit(pt: &Pt) byte;
extern fn pt_end(pt: &Pt) byte;
extern fn pt_schedule(status: byte) bool;

extern const PT_WAITING: i32;
extern const PT_EXITED: i32;
extern const PT_ENDED: i32;
extern const PT_YIELDED: i32;

struct Pt {
    lc: u16,
    yielded: bool
}

test "pt_init resets local continuation and yield flag" {
    var pt: Pt = Pt { lc: 9u16, yielded: true };
    pt_init(&pt);
    try assert_eq_i32(pt.lc as i32, 0);
    try assert_eq_bool(pt.yielded, false);
}

test "pt_wait_until returns waiting until condition becomes true" {
    var pt: Pt = Pt { lc: 0u16, yielded: false };
    try assert_eq_i32(pt_wait_until(&pt, false) as i32, PT_WAITING);
    try assert_eq_i32(pt_wait_until(&pt, true) as i32, PT_YIELDED);
}

test "pt_yield yields once and then clears yielded state" {
    var pt: Pt = Pt { lc: 0u16, yielded: false };
    try assert_eq_i32(pt_yield(&pt) as i32, PT_YIELDED);
    try assert_eq_bool(pt.yielded, true);
    pt_init(&pt);
    try assert_eq_bool(pt.yielded, false);
}

test "pt_exit and pt_end reset pt and return terminal states" {
    var pt1: Pt = Pt { lc: 3u16, yielded: true };
    try assert_eq_i32(pt_exit(&pt1) as i32, PT_EXITED);
    try assert_eq_i32(pt1.lc as i32, 0);
    var pt2: Pt = Pt { lc: 4u16, yielded: true };
    try assert_eq_i32(pt_end(&pt2) as i32, PT_ENDED);
    try assert_eq_i32(pt2.lc as i32, 0);
}

test "pt_schedule is true only for waiting status" {
    try assert_eq_bool(pt_schedule((PT_WAITING as! byte).value), true);
    try assert_eq_bool(pt_schedule((PT_EXITED as! byte).value), false);
    try assert_eq_bool(pt_schedule((PT_ENDED as! byte).value), false);
}
