use std.testing;

extern fn uip_arp_init(state: &UipArpState) void;
extern fn uip_arp_timer(state: &UipArpState) void;
extern fn uip_arp_update(state: &UipArpState, ipaddr: &u16, ethaddr: &UipEthAddr) void;
extern fn uip_arp_arpin(state: &UipArpState, buf: &ArpHdr, len: &u16) void;
extern fn uip_arp_out(state: &UipArpState, frame: &UipFrame, len: &u16) void;
extern fn uip_setethaddr(state: &UipArpState, eaddr: &UipEthAddr) void;
extern fn uip_ipaddr(a: byte, b: byte, c: byte, d: byte) UipIpAddr;
extern fn htons(val: u16) u16;
extern const UIP_ETHTYPE_ARP: i32;
extern const UIP_ETHTYPE_IP: i32;

struct UipEthHdr { dest: UipEthAddr, src: UipEthAddr, type: u16 }
struct UipEthAddr { addr: [byte: 6] }
struct UipIpAddr { words: [u16: 2] }
struct ArpEntry { ipaddr: [u16: 2], ethaddr: UipEthAddr, time: byte }
struct UipArpState { ethaddr: UipEthAddr, hostaddr: UipIpAddr, netmask: UipIpAddr, draddr: UipIpAddr, table: [ArpEntry: 8], arptime: byte }
struct ArpHdr { ethhdr: UipEthHdr, hwtype: u16, protocol: u16, hwlen: byte, protolen: byte, opcode: u16, shwaddr: UipEthAddr, sipaddr: [u16: 2], dhwaddr: UipEthAddr, dipaddr: [u16: 2] }
struct EthIpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2] }
struct EthTcpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, seqno: [byte: 4], ackno: [byte: 4], tcpoffset: byte, flags: byte, wnd: [byte: 2], tcpchksum: u16, urgp: u16, optdata: [byte: 4] }
struct EthUdpHdr { ethhdr: UipEthHdr, vhl: byte, tos: byte, len: [byte: 2], ipid: [byte: 2], ipoffset: [byte: 2], ttl: byte, proto: byte, ipchksum: u16, srcipaddr: [u16: 2], destipaddr: [u16: 2], srcport: u16, destport: u16, udplen: u16, udpchksum: u16 }
struct UipFrame { ethip: EthIpHdr, ethtcp: EthTcpHdr, ethudp: EthUdpHdr, arp: ArpHdr }

test "uip_arp_init clears arp table and timer" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] }, hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [1u16,2u16], ethaddr: UipEthAddr { addr: [9 as byte,9 as byte,9 as byte,9 as byte,9 as byte,9 as byte] }, time: 7 as byte }: 8], arptime: 9 as byte };
    uip_arp_init(&arp);
    try assert_eq_i32(arp.table[0].ipaddr[0] as i32, 0);
    try assert_eq_i32(arp.table[7].ipaddr[1] as i32, 0);
    try assert_eq_i32(arp.arptime as i32, 0);
}

test "uip_arp_timer expires old entries" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 119 as byte };
    arp.table[0].ipaddr = [1u16,2u16]; arp.table[0].time = 0 as byte;
    arp.table[1].ipaddr = [3u16,4u16]; arp.table[1].time = 119 as byte;
    uip_arp_timer(&arp);
    try assert_eq_i32(arp.arptime as i32, 120);
    try assert_eq_i32(arp.table[0].ipaddr[0] as i32, 0);
    try assert_eq_i32(arp.table[1].ipaddr[0] as i32, 3);
}

test "uip_setethaddr copies all mac bytes" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 0 as byte };
    const mac: UipEthAddr = UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] };
    uip_setethaddr(&arp, &mac);
    try assert_eq_i32(arp.ethaddr.addr[0] as i32, 1);
    try assert_eq_i32(arp.ethaddr.addr[5] as i32, 6);
}

test "uip_arp_update refreshes existing entry" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 7 as byte };
    arp.table[0].ipaddr = [1u16,2u16]; arp.table[0].ethaddr.addr[0] = 9 as byte;
    const mac: UipEthAddr = UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] };
    var ip: [u16: 2] = [1u16,2u16];
    uip_arp_update(&arp, &ip[0], &mac);
    try assert_eq_i32(arp.table[0].ethaddr.addr[0] as i32, 1);
    try assert_eq_i32(arp.table[0].time as i32, 7);
}

test "uip_arp_update inserts into free slot" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, hostaddr: UipIpAddr { words: [0u16,0u16] }, netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 5 as byte };
    const mac: UipEthAddr = UipEthAddr { addr: [7 as byte,8 as byte,9 as byte,10 as byte,11 as byte,12 as byte] };
    var ip: [u16: 2] = [3u16,4u16];
    uip_arp_update(&arp, &ip[0], &mac);
    try assert_eq_i32(arp.table[0].ipaddr[0] as i32, 3);
    try assert_eq_i32(arp.table[0].ethaddr.addr[0] as i32, 7);
}

test "uip_arp_arpin answers request for host address" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [10 as byte,11 as byte,12 as byte,13 as byte,14 as byte,15 as byte] }, hostaddr: uip_ipaddr(192,168,0,2), netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 4 as byte };
    var pkt: ArpHdr = ArpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] }, type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 6 as byte, protolen: 4 as byte, opcode: htons(1u16), shwaddr: UipEthAddr { addr: [1 as byte,2 as byte,3 as byte,4 as byte,5 as byte,6 as byte] }, sipaddr: [htons(0xC0A8u16), htons(0x0001u16)], dhwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, dipaddr: [arp.hostaddr.words[0], arp.hostaddr.words[1]] };
    var len: u16 = (@size_of(ArpHdr) as! u16).value;
    uip_arp_arpin(&arp, &pkt, &len);
    try assert_eq_i32(len as i32, (@size_of(ArpHdr) as! i32).value);
    try assert_eq_i32(pkt.opcode as i32, htons(2u16) as i32);
    try assert_eq_i32(pkt.ethhdr.type as i32, htons(UIP_ETHTYPE_ARP as u16) as i32);
}

test "uip_arp_arpin updates cache on arp reply for host" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, hostaddr: uip_ipaddr(192,168,0,2), netmask: UipIpAddr { words: [0u16,0u16] }, draddr: UipIpAddr { words: [0u16,0u16] }, table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 6 as byte };
    var pkt: ArpHdr = ArpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 6 as byte, protolen: 4 as byte, opcode: htons(2u16), shwaddr: UipEthAddr { addr: [9 as byte,8 as byte,7 as byte,6 as byte,5 as byte,4 as byte] }, sipaddr: [htons(0xC0A8u16), htons(0x0009u16)], dhwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, dipaddr: [arp.hostaddr.words[0], arp.hostaddr.words[1]] };
    var len: u16 = (@size_of(ArpHdr) as! u16).value;
    uip_arp_arpin(&arp, &pkt, &len);
    try assert_eq_i32(len as i32, 0);
    try assert_eq_i32(arp.table[0].ethaddr.addr[0] as i32, 9);
}

test "uip_arp_out uses cached mac for local destination" {
    var arp: UipArpState = UipArpState { ethaddr: UipEthAddr { addr: [10 as byte,11 as byte,12 as byte,13 as byte,14 as byte,15 as byte] }, hostaddr: uip_ipaddr(192,168,0,2), netmask: uip_ipaddr(255,255,255,0), draddr: uip_ipaddr(192,168,0,1), table: [ArpEntry { ipaddr: [0u16,0u16], ethaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, time: 0 as byte }: 8], arptime: 0 as byte };
    arp.table[0].ipaddr[0] = htons(0xC0A8u16); arp.table[0].ipaddr[1] = htons(0x0009u16);
    arp.table[0].ethaddr.addr[0] = 1 as byte; arp.table[0].ethaddr.addr[1] = 2 as byte; arp.table[0].ethaddr.addr[2] = 3 as byte; arp.table[0].ethaddr.addr[3] = 4 as byte; arp.table[0].ethaddr.addr[4] = 5 as byte; arp.table[0].ethaddr.addr[5] = 6 as byte;
    var frame: UipFrame = UipFrame { ethip: EthIpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [htons(0xC0A8u16), htons(0x0009u16)] }, ethtcp: EthTcpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, seqno: [0 as byte,0 as byte,0 as byte,0 as byte], ackno: [0 as byte,0 as byte,0 as byte,0 as byte], tcpoffset: 0x50 as byte, flags: 0 as byte, wnd: [0 as byte,0 as byte], tcpchksum: 0u16, urgp: 0u16, optdata: [0 as byte,0 as byte,0 as byte,0 as byte] }, ethudp: EthUdpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, vhl: 0 as byte, tos: 0 as byte, len: [0 as byte,0 as byte], ipid: [0 as byte,0 as byte], ipoffset: [0 as byte,0 as byte], ttl: 0 as byte, proto: 0 as byte, ipchksum: 0u16, srcipaddr: [0u16,0u16], destipaddr: [0u16,0u16], srcport: 0u16, destport: 0u16, udplen: 0u16, udpchksum: 0u16 }, arp: ArpHdr { ethhdr: UipEthHdr { dest: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, src: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, type: 0u16 }, hwtype: 0u16, protocol: 0u16, hwlen: 0 as byte, protolen: 0 as byte, opcode: 0u16, shwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, sipaddr: [0u16,0u16], dhwaddr: UipEthAddr { addr: [0 as byte,0 as byte,0 as byte,0 as byte,0 as byte,0 as byte] }, dipaddr: [0u16,0u16] } };
    var len: u16 = 40u16;
    uip_arp_out(&arp, &frame, &len);
    try assert_eq_i32(frame.ethip.ethhdr.dest.addr[0] as i32, 1);
    try assert_eq_i32(frame.ethip.ethhdr.type as i32, htons(UIP_ETHTYPE_IP as u16) as i32);
}
