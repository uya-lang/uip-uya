export const UIP_SYN_SENT: i32 = 2;
export const UIP_ESTABLISHED: i32 = 3;
export const UIP_FIN_WAIT_1: i32 = 4;
export const UIP_FIN_WAIT_2: i32 = 5;
export const UIP_CLOSING: i32 = 6;
export const UIP_TIME_WAIT: i32 = 7;
export const UIP_LAST_ACK: i32 = 8;
export const UIP_STOPPED: i32 = 16;
export const UIP_TIME_WAIT_TIMEOUT: i32 = 120;
export const UIP_REASS_MAXAGE: i32 = 40;
export const UIP_REASS_BUFSIZE: i32 = 386;
export const UIP_REASS_FLAG_LASTFRAG: i32 = 0x01;
